@model AlumniJobConnect.Models.AlumniProfile

@{
    ViewData["Title"] = "Hồ sơ - " + Model.User.FullName;
    var isOwner = ViewBag.IsOwner is bool owner && owner;

    var fullName = Model.User.FullName;
    var initial = string.IsNullOrWhiteSpace(fullName)
        ? "?"
        : fullName.Trim().Substring(0, 1).ToUpperInvariant();
    var phone = Model.User.Phone;
}

<section class="resume-page">

    <!-- ============ COVER ============ -->
    <header class="resume-cover">
        <div class="resume-cover-glow resume-cover-glow-1" aria-hidden="true"></div>
        <div class="resume-cover-glow resume-cover-glow-2" aria-hidden="true"></div>

        <div class="container resume-cover-inner">
            <a href="@Url.Action("Candidates", "Profile")" class="resume-back">
                <span aria-hidden="true">←</span> Danh sách ứng viên
            </a>
        </div>
    </header>

    <div class="container resume-wrap">

        <!-- ============ IDENTITY ============ -->
        <div class="resume-identity">
            <div class="resume-avatar">
                <span class="resume-avatar-initial" aria-hidden="true">@initial</span>

                @if (!string.IsNullOrWhiteSpace(Model.User.AvatarUrl))
                {
                    <img src="@Url.Action("Avatar", "Profile",
                                                       new { alumniId = Model.AlumniId })"
                     alt="Ảnh đại diện của @fullName"
                     onerror="this.hidden = true;" />
                                }
            </div>

            <div class="resume-name">
                <span class="resume-badge">
                    <i class="fa fa-graduation-cap" aria-hidden="true"></i>
                    Sinh viên / Cựu sinh viên
                </span>

                <h1>@fullName</h1>

                <p class="resume-title">
                    @(string.IsNullOrWhiteSpace(Model.CurrentJobTitle)
                                        ? "Đang cập nhật định hướng nghề nghiệp"
                                        : Model.CurrentJobTitle)
                </p>
            </div>

            @if (isOwner)
            {
                <a href="@Url.Action("Index", "Profile")" class="resume-edit">
                    <i class="fa fa-edit" aria-hidden="true"></i>
                    Chỉnh sửa hồ sơ
                </a>
            }
        </div>

        <div class="resume-layout">

            <!-- ============ MAIN ============ -->
            <div class="resume-main">

                <section class="resume-section">
                    <h2>
                        <span class="resume-section-icon">
                            <i class="fa fa-user" aria-hidden="true"></i>
                        </span>
                        Giới thiệu bản thân
                    </h2>

                    <p class="resume-bio">
                        @(string.IsNullOrWhiteSpace(Model.Bio)
                                                ? "Ứng viên chưa cập nhật giới thiệu bản thân."
                                                : Model.Bio)
                    </p>
                </section>

                <section class="resume-section">
                    <h2>
                        <span class="resume-section-icon">
                            <i class="fa fa-briefcase" aria-hidden="true"></i>
                        </span>
                        Thông tin nghề nghiệp
                    </h2>

                    <dl class="resume-facts">
                        <div class="resume-fact">
                            <dt>
                                <i class="fa fa-graduation-cap" aria-hidden="true"></i>
                                Năm tốt nghiệp
                            </dt>
                            <dd>
                                @(Model.GraduationYear?.ToString() ?? "Chưa cập nhật")
                            </dd>
                        </div>

                        <div class="resume-fact">
                            <dt>
                                <i class="fa fa-id-badge" aria-hidden="true"></i>
                                Vị trí hiện tại
                            </dt>
                            <dd>
                                @(string.IsNullOrWhiteSpace(Model.CurrentJobTitle)
                                                                ? "Chưa cập nhật"
                                                                : Model.CurrentJobTitle)
                            </dd>
                        </div>

                        <div class="resume-fact">
                            <dt>
                                <i class="fa fa-building" aria-hidden="true"></i>
                                Đơn vị công tác
                            </dt>
                            <dd>
                                @(string.IsNullOrWhiteSpace(Model.CurrentCompanyName)
                                                                ? "Chưa cập nhật"
                                                                : Model.CurrentCompanyName)
                            </dd>
                        </div>
                    </dl>
                </section>
            </div>

            <!-- ============ CONTACT ============ -->
            <aside class="resume-contact">
                <div class="resume-contact-head">
                    <span class="resume-contact-icon">
                        <i class="fa fa-envelope" aria-hidden="true"></i>
                    </span>
                    <h2>Thông tin liên hệ</h2>
                </div>

                <div class="resume-contact-item">
                    <span>Email</span>
                    <p>
                        <a href="mailto:@Model.User.Email">@Model.User.Email</a>
                    </p>
                </div>

                <div class="resume-contact-item">
                    <span>Số điện thoại</span>
                    <p>
                        @if (string.IsNullOrWhiteSpace(phone))
                        {
                            <text>Chưa cập nhật</text>
                        }
                        else
                        {
                            <a href="tel:@phone">@phone</a>
                        }
                    </p>
                </div>

                <p class="resume-note">
                    Sử dụng thông tin liên hệ để trao đổi
                    cơ hội nghề nghiệp với ứng viên.
                </p>
            </aside>
        </div>
    </div>
</section>

<style>
    .resume-page {
        --c-ink: #12362a;
        --c-muted: #6b8479;
        --c-brand: #009f6b;
        --c-brand-dark: #00734d;
        --c-soft: #eaf8f0;
        --c-line: #e0ede5;
        padding-bottom: 72px;
        background: #f4faf7;
        font-family: "Segoe UI", system-ui, Arial, sans-serif;
    }

        .resume-page * {
            box-sizing: border-box;
        }

    /* ---------- COVER ---------- */
    .resume-cover {
        position: relative;
        overflow: hidden;
        height: 230px;
        background: radial-gradient(circle at 1px 1px, rgb(255 255 255 / 10%) 1px, transparent 0) 0 0 / 22px 22px, linear-gradient(135deg, #0b3d2c 0%, #087a55 55%, #19b383 100%);
    }

    .resume-cover-glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(70px);
        pointer-events: none;
    }

    .resume-cover-glow-1 {
        top: -140px;
        right: -60px;
        width: 360px;
        height: 360px;
        background: rgb(255 214 102 / 35%);
    }

    .resume-cover-glow-2 {
        bottom: -170px;
        left: -90px;
        width: 340px;
        height: 340px;
        background: rgb(120 255 205 / 25%);
    }

    .resume-cover-inner {
        position: relative;
        padding-top: 32px;
    }

    .resume-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 16px;
        color: #fff;
        background: rgb(255 255 255 / 14%);
        border: 1px solid rgb(255 255 255 / 25%);
        border-radius: 999px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        backdrop-filter: blur(6px);
        transition: background .2s, transform .2s;
    }

        .resume-back:hover {
            color: #fff;
            background: rgb(255 255 255 / 24%);
            transform: translateX(-3px);
        }

    /* ---------- IDENTITY ---------- */
    .resume-wrap {
        position: relative;
        margin-top: -74px;
    }

    .resume-identity {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: 24px;
        padding: 0 8px;
    }

    .resume-avatar {
        position: relative;
        display: grid;
        place-items: center;
        flex: none;
        width: 148px;
        height: 148px;
        overflow: hidden;
        color: var(--c-brand-dark);
        background: linear-gradient(135deg, #e4f7ed, #c5ead9);
        border: 6px solid #fff;
        border-radius: 50%;
        box-shadow: 0 14px 34px rgb(11 61 44 / 22%);
    }

    .resume-avatar-initial {
        font-size: 58px;
        font-weight: 800;
    }

    .resume-avatar img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

        .resume-avatar img[hidden] {
            display: none !important;
        }

    .resume-name {
        flex: 1;
        min-width: 220px;
        padding-bottom: 6px;
    }

    .resume-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 10px;
        padding: 6px 13px;
        color: #006f4a;
        background: #fff;
        border: 1px solid #c8ebd9;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
    }

    .resume-page h1,
    .resume-page h2 {
        color: var(--c-ink);
        font-family: inherit;
    }

    .resume-name h1 {
        margin: 0 0 10px;
        font-size: clamp(26px, 3.6vw, 36px);
        font-weight: 800;
        letter-spacing: -.3px;
        overflow-wrap: anywhere;
    }

    .resume-title {
        display: inline-block;
        margin: 0;
        padding: 5px 14px;
        color: var(--c-brand-dark);
        background: var(--c-soft);
        border-radius: 999px;
        font-size: 13px;
        font-weight: 700;
        line-height: 1.7;
    }

    .resume-edit {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 8px;
        padding: 13px 22px;
        color: #fff;
        background: linear-gradient(135deg, #00b27a, #008c60);
        border-radius: 999px;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        box-shadow: 0 8px 20px rgb(0 159 107 / 30%);
        transition: transform .2s, box-shadow .2s;
    }

        .resume-edit:hover {
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 12px 26px rgb(0 159 107 / 40%);
        }

    /* ---------- LAYOUT ---------- */
    .resume-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 340px;
        gap: 26px;
        margin-top: 32px;
        align-items: start;
    }

    .resume-main {
        display: flex;
        flex-direction: column;
        gap: 22px;
        min-width: 0;
    }

    .resume-section {
        padding: 30px;
        background: #fff;
        border: 1px solid var(--c-line);
        border-radius: 24px;
        box-shadow: 0 6px 22px rgb(28 72 49 / 5%);
    }

        .resume-section h2 {
            display: flex;
            align-items: center;
            gap: 14px;
            margin: 0 0 22px;
            font-size: 20px;
            font-weight: 800;
        }

    .resume-section-icon {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        color: #fff;
        background: linear-gradient(135deg, #00b27a, #5fd6a6);
        border-radius: 13px;
        font-size: 16px;
        box-shadow: 0 6px 14px rgb(0 159 107 / 25%);
    }

    .resume-bio {
        margin: 0;
        color: #50685d;
        font-size: 15px;
        line-height: 1.95;
        white-space: pre-line;
        overflow-wrap: anywhere;
    }

    /* ---------- FACTS ---------- */
    .resume-facts {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
        margin: 0;
    }

    .resume-fact {
        padding: 18px;
        background: #f6fbf8;
        border: 1px solid #e0eee6;
        border-radius: 18px;
        transition: transform .2s, border-color .2s, background .2s;
    }

        .resume-fact:hover {
            transform: translateY(-3px);
            background: #fff;
            border-color: #9bdcc0;
        }

        .resume-fact:nth-child(2) i {
            color: #2f9bd6;
        }

        .resume-fact:nth-child(3) i {
            color: #8a63d2;
        }

    .resume-facts dt {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 10px;
        color: #7b9288;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .7px;
        text-transform: uppercase;
    }

        .resume-facts dt i {
            color: var(--c-brand);
            font-size: 14px;
        }

    .resume-facts dd {
        margin: 0;
        color: var(--c-ink);
        font-size: 16px;
        font-weight: 700;
        line-height: 1.5;
        overflow-wrap: anywhere;
    }

    /* ---------- CONTACT ---------- */
    .resume-contact {
        position: sticky;
        top: 24px;
        overflow: hidden;
        padding: 28px;
        color: #fff;
        background: radial-gradient(circle at 1px 1px, rgb(255 255 255 / 9%) 1px, transparent 0) 0 0 / 18px 18px, linear-gradient(160deg, #0b3d2c, #087a55);
        border-radius: 24px;
        box-shadow: 0 18px 40px rgb(11 61 44 / 22%);
    }

    .resume-contact-head {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 24px;
    }

    .resume-contact-icon {
        display: grid;
        place-items: center;
        flex: none;
        width: 44px;
        height: 44px;
        color: #0b3d2c;
        background: #ffd666;
        border-radius: 14px;
        font-size: 18px;
    }

    .resume-contact h2 {
        margin: 0;
        color: #fff;
        font-size: 19px;
        font-weight: 800;
    }

    .resume-contact-item {
        margin-bottom: 14px;
        padding: 14px 16px;
        background: rgb(255 255 255 / 10%);
        border: 1px solid rgb(255 255 255 / 16%);
        border-radius: 14px;
    }

        .resume-contact-item > span {
            color: #bfeeda;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .7px;
            text-transform: uppercase;
        }

        .resume-contact-item p {
            margin: 6px 0 0;
            color: #fff;
            font-size: 14px;
            font-weight: 600;
            overflow-wrap: anywhere;
        }

        .resume-contact-item a {
            color: #fff;
            text-decoration: none;
            border-bottom: 1px dashed rgb(255 255 255 / 50%);
        }

            .resume-contact-item a:hover {
                color: #ffd666;
                border-bottom-color: #ffd666;
            }

    .resume-note {
        margin: 20px 0 0;
        padding-top: 18px;
        color: #c3ecd9;
        border-top: 1px solid rgb(255 255 255 / 18%);
        font-size: 12px;
        line-height: 1.8;
    }

    /* ---------- FOCUS ---------- */
    .resume-page a:focus-visible {
        outline: 3px solid #86d6b6;
        outline-offset: 3px;
    }

    /* ---------- RESPONSIVE ---------- */
    @@media (max-width: 991.98px) {
        .resume-layout {
            grid-template-columns: 1fr;
        }

        .resume-contact {
            position: static;
        }
    }

    @@media (max-width: 767.98px) {
        .resume-facts {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 575.98px) {
        .resume-cover {
            height: 190px;
        }

        .resume-wrap {
            margin-top: -62px;
        }

        .resume-identity {
            gap: 16px;
        }

        .resume-avatar {
            width: 120px;
            height: 120px;
        }

        .resume-avatar-initial {
            font-size: 48px;
        }

        .resume-name {
            flex-basis: 100%;
        }

        .resume-edit {
            width: 100%;
            justify-content: center;
        }

        .resume-section {
            padding: 22px;
        }

        .resume-contact {
            padding: 22px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .resume-back,
        .resume-edit,
        .resume-fact {
            transition: none;
        }

            .resume-back:hover,
            .resume-edit:hover,
            .resume-fact:hover {
                transform: none;
            }
    }
</style>
