@using System.Linq
@model IEnumerable<AlumniJobConnect.Models.AlumniProfile>

@{
    ViewData["Title"] = "Khám phá ứng viên";

    var profiles = Model.ToList();
    var totalCount = profiles.Count;
    var keyword = (string?)ViewBag.Keyword;
    var hasKeyword = !string.IsNullOrWhiteSpace(keyword);
}

<section class="cv-page">

    <!-- ============ HERO ============ -->
    <header class="cv-hero">
        <div class="cv-hero-glow cv-hero-glow-1" aria-hidden="true"></div>
        <div class="cv-hero-glow cv-hero-glow-2" aria-hidden="true"></div>

        <div class="container cv-hero-inner">
            <div class="cv-hero-text">
                <span class="cv-eyebrow">
                    <span class="cv-eyebrow-dot" aria-hidden="true"></span>
                    KẾT NỐI NHÂN TÀI
                </span>

                <h1>
                    Khám phá <em>ứng viên</em><br />
                    sẵn sàng bứt phá
                </h1>

                <p>
                    Kết nối với sinh viên và cựu sinh viên
                    phù hợp với cơ hội nghề nghiệp.
                </p>

                @if (User.IsInRole("Alumni"))
                {
                    <a href="@Url.Action("MyProfile", "Profile")"
                       class="cv-my-profile">
                        <i class="fa fa-user" aria-hidden="true"></i>
                        <span>Hồ sơ của tôi</span>
                        <span aria-hidden="true">→</span>
                    </a>
                }
            </div>

            <div class="cv-stat" aria-label="Thống kê nhanh">
                <strong>@totalCount</strong>
                <span>Hồ sơ ứng viên</span>
            </div>
        </div>
    </header>

    <div class="container cv-body">

        <!-- ============ SEARCH ============ -->
        <form action="@Url.Action("Candidates", "Profile")"
              method="get"
              class="cv-search"
              role="search">

            <label class="cv-search-input">
                <i class="fa fa-search" aria-hidden="true"></i>

                <input type="search"
                       name="keyword"
                       value="@keyword"
                       aria-label="Tìm kiếm ứng viên"
                       placeholder="Nhập họ tên hoặc vị trí công việc..." />
            </label>

            <button type="submit">Tìm kiếm</button>
        </form>

        <div class="cv-result">
            <span>
                @if (hasKeyword)
                {
                    <text>Kết quả cho “<b>@keyword</b>”: </text>
                }
                Tìm thấy <strong>@totalCount</strong> hồ sơ
            </span>

            @if (hasKeyword)
            {
                <a href="@Url.Action("Candidates", "Profile")" class="cv-clear">
                    <span aria-hidden="true">✕</span> Xóa tìm kiếm
                </a>
            }
            else
            {
                <span class="cv-result-note">
                    Khám phá năng lực, kết nối cơ hội
                </span>
            }
        </div>

        <!-- ============ GRID ============ -->
        <div class="cv-grid">
            @for (var i = 0; i < profiles.Count; i++)
            {
                var item = profiles[i];
                var fullName = item.User?.FullName;
                var initial = string.IsNullOrWhiteSpace(fullName)
                ? "?"
                : fullName.Trim().Substring(0, 1).ToUpperInvariant();

                <article class="cv-card accent-@(i % 4)" style="--i:@(i % 12)">

                    <div class="cv-card-banner" aria-hidden="true"></div>

                    <div class="cv-card-top">
                        <div class="cv-avatar">
                            <span class="cv-avatar-initial" aria-hidden="true">@initial</span>

                            @if (!string.IsNullOrWhiteSpace(item.User?.AvatarUrl))
                            {
                                <img src="@Url.Action("Avatar", "Profile",
                                                                               new { alumniId = item.AlumniId })"
                             alt="Ảnh đại diện của @fullName"
                             loading="lazy"
                             onerror="this.hidden = true;" />
                                                }
                    </div>

                    <span class="cv-badge">
                        <i class="fa fa-graduation-cap" aria-hidden="true"></i>
                        Sinh viên / Cựu sinh viên
                    </span>
                </div>

                <h2>@fullName</h2>

                <p class="cv-position">
                    @(string.IsNullOrWhiteSpace(item.CurrentJobTitle)
                                        ? "Chưa cập nhật vị trí công việc"
                                        : item.CurrentJobTitle)
                                                           </p>

                <p class="cv-bio">
                    @(string.IsNullOrWhiteSpace(item.Bio)
                                        ? "Ứng viên chưa cập nhật giới thiệu bản thân."
                                        : item.Bio)
                                               </p>

                <div class="cv-graduation">
                    <i class="fa fa-calendar-check-o" aria-hidden="true"></i>

                    <span>
                        <span class="cv-graduation-label">Tốt nghiệp</span>
                        @(item.GraduationYear.HasValue
                                                ? $"Năm {item.GraduationYear}"
                                                : "Chưa cập nhật năm tốt nghiệp")
                    </span>
                </div>

                <a href="@Url.Action("Details", "Profile",
                                                    new { id = item.AlumniId })"
                   class="cv-view">
                    <span>Xem hồ sơ</span>
                    <span class="cv-view-arrow" aria-hidden="true">→</span>
                </a>
            </article>
                        }
        </div>

        @if (!profiles.Any())
        {
            <div class="cv-empty">
                <div class="cv-empty-icon">
                    <i class="fa fa-search" aria-hidden="true"></i>
                </div>

                <h2>Chưa tìm thấy hồ sơ</h2>

                <p>
                    Hãy thử từ khóa khác hoặc quay lại
                    khi có thêm hồ sơ được cập nhật.
                </p>

                <a href="@Url.Action("Candidates", "Profile")" class="cv-empty-link">
                    Xem tất cả hồ sơ
                </a>
            </div>
        }
    </div>
</section>

<style>
    .cv-page {
        --c-ink: #12362a;
        --c-muted: #6b8479;
        --c-brand: #009f6b;
        --c-brand-dark: #00734d;
        --c-soft: #eaf8f0;
        --c-line: #dcebe2;
        padding-bottom: 72px;
        background: #f4faf7;
        font-family: "Segoe UI", system-ui, Arial, sans-serif;
    }

        .cv-page * {
            box-sizing: border-box;
        }

    /* ---------- HERO ---------- */
    .cv-hero {
        position: relative;
        overflow: hidden;
        padding: 64px 0 112px;
        color: #fff;
        background: radial-gradient(circle at 1px 1px, rgb(255 255 255 / 10%) 1px, transparent 0) 0 0 / 22px 22px, linear-gradient(135deg, #0b3d2c 0%, #087a55 55%, #19b383 100%);
    }

    .cv-hero-glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(70px);
        pointer-events: none;
    }

    .cv-hero-glow-1 {
        top: -120px;
        right: -80px;
        width: 380px;
        height: 380px;
        background: rgb(255 214 102 / 35%);
    }

    .cv-hero-glow-2 {
        bottom: -160px;
        left: -100px;
        width: 360px;
        height: 360px;
        background: rgb(120 255 205 / 25%);
    }

    .cv-hero-inner {
        position: relative;
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 36px;
    }

    .cv-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 7px 14px;
        color: #d8fff0;
        background: rgb(255 255 255 / 12%);
        border: 1px solid rgb(255 255 255 / 22%);
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.6px;
        backdrop-filter: blur(6px);
    }

    .cv-eyebrow-dot {
        width: 8px;
        height: 8px;
        background: #ffd666;
        border-radius: 50%;
        box-shadow: 0 0 0 4px rgb(255 214 102 / 25%);
    }

    .cv-hero h1 {
        margin: 20px 0 16px;
        color: #fff;
        font-family: inherit;
        font-size: clamp(30px, 4.6vw, 52px);
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: -0.5px;
    }

        .cv-hero h1 em {
            color: #ffd666;
            font-style: normal;
            background: linear-gradient(transparent 82%, rgb(255 214 102 / 35%) 82%);
        }

    .cv-hero p {
        max-width: 560px;
        margin: 0;
        color: #d3f1e4;
        font-size: 16px;
        line-height: 1.8;
    }

    .cv-my-profile {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-top: 26px;
        padding: 13px 22px;
        color: #0b3d2c;
        background: #fff;
        border-radius: 999px;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        box-shadow: 0 10px 24px rgb(0 0 0 / 18%);
        transition: transform .2s, box-shadow .2s;
    }

        .cv-my-profile:hover {
            color: #0b3d2c;
            transform: translateY(-2px);
            box-shadow: 0 14px 30px rgb(0 0 0 / 24%);
        }

    .cv-stat {
        min-width: 150px;
        padding: 18px 24px;
        background: rgb(255 255 255 / 12%);
        border: 1px solid rgb(255 255 255 / 22%);
        border-radius: 18px;
        backdrop-filter: blur(8px);
    }

        .cv-stat strong {
            display: block;
            font-size: 34px;
            font-weight: 800;
            line-height: 1.1;
        }

        .cv-stat span {
            color: #c7efdd;
            font-size: 12px;
            letter-spacing: .4px;
        }

    /* ---------- SEARCH ---------- */
    .cv-body {
        position: relative;
        margin-top: -44px;
    }

    .cv-search {
        display: flex;
        gap: 12px;
        padding: 10px;
        background: #fff;
        border: 1px solid var(--c-line);
        border-radius: 999px;
        box-shadow: 0 18px 44px rgb(11 61 44 / 14%);
    }

    .cv-search-input {
        display: flex;
        flex: 1;
        align-items: center;
        gap: 14px;
        min-width: 0;
        margin: 0;
        padding: 0 20px;
        color: var(--c-brand);
        border-radius: 999px;
        font-size: 16px;
    }

        .cv-search-input input {
            width: 100%;
            min-width: 0;
            padding: 14px 0;
            color: #1f4535;
            background: transparent;
            border: 0;
            font-family: inherit;
            font-size: 15px;
        }

            .cv-search-input input:focus {
                outline: none;
            }

        .cv-search-input:focus-within {
            outline: 2px solid #00a36c;
            outline-offset: 0;
        }

    .cv-search button {
        padding: 13px 32px;
        color: #fff;
        background: linear-gradient(135deg, #00b27a, #008c60);
        border: 0;
        border-radius: 999px;
        font-family: inherit;
        font-weight: 700;
        white-space: nowrap;
        cursor: pointer;
        transition: transform .2s, box-shadow .2s;
    }

        .cv-search button:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 18px rgb(0 159 107 / 35%);
        }

    /* ---------- RESULTS BAR ---------- */
    .cv-result {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin: 30px 4px 22px;
        color: var(--c-muted);
        font-size: 14px;
    }

        .cv-result strong,
        .cv-result b {
            color: var(--c-brand-dark);
        }

    .cv-result-note {
        font-size: 12px;
        font-style: italic;
    }

    .cv-clear {
        padding: 6px 14px;
        color: var(--c-brand-dark);
        background: #fff;
        border: 1px solid var(--c-line);
        border-radius: 999px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
    }

        .cv-clear:hover {
            background: var(--c-soft);
        }

    /* ---------- GRID & CARD ---------- */
    .cv-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 26px;
    }

    .cv-card {
        --a1: #00b27a;
        --a2: #7be0b6;
        --a-soft: #e6f8ef;
        --a-ink: #007a52;
        position: relative;
        display: flex;
        flex-direction: column;
        min-width: 0;
        overflow: hidden;
        padding: 0 26px 26px;
        background: #fff;
        border: 1px solid #e0ede5;
        border-radius: 24px;
        box-shadow: 0 6px 22px rgb(28 72 49 / 5%);
        opacity: 0;
        animation: cv-rise .55s cubic-bezier(.2, .7, .2, 1) forwards;
        animation-delay: calc(var(--i) * 60ms);
        transition: transform .25s, box-shadow .25s, border-color .25s;
    }

        .cv-card.accent-1 {
            --a1: #2f9bd6;
            --a2: #9fd8f5;
            --a-soft: #e7f4fc;
            --a-ink: #16739f;
        }

        .cv-card.accent-2 {
            --a1: #f0a516;
            --a2: #ffe08a;
            --a-soft: #fff4d9;
            --a-ink: #a56b00;
        }

        .cv-card.accent-3 {
            --a1: #8a63d2;
            --a2: #cdb8f3;
            --a-soft: #f0eafb;
            --a-ink: #5f3da5;
        }

        .cv-card:hover {
            transform: translateY(-6px);
            border-color: var(--a2);
            box-shadow: 0 22px 44px rgb(28 72 49 / 13%);
        }

    .cv-card-banner {
        height: 86px;
        margin: 0 -26px;
        background: radial-gradient(circle at 1px 1px, rgb(255 255 255 / 30%) 1px, transparent 0) 0 0 / 14px 14px, linear-gradient(120deg, var(--a1), var(--a2));
    }

    .cv-card-top {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 10px;
        margin-top: -36px;
        margin-bottom: 18px;
    }

    .cv-avatar {
        position: relative;
        display: grid;
        place-items: center;
        flex: none;
        width: 76px;
        height: 76px;
        overflow: hidden;
        color: var(--a-ink);
        background: var(--a-soft);
        border: 4px solid #fff;
        border-radius: 50%;
        box-shadow: 0 8px 20px rgb(28 72 49 / 15%);
    }

    .cv-avatar-initial {
        font-size: 30px;
        font-weight: 800;
    }

    .cv-avatar img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

        .cv-avatar img[hidden] {
            display: none !important;
        }

    .cv-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 4px;
        padding: 6px 11px;
        color: var(--a-ink);
        background: var(--a-soft);
        border-radius: 999px;
        font-size: 10.5px;
        font-weight: 700;
    }

    .cv-card h2 {
        margin: 0 0 10px;
        color: var(--c-ink);
        font-family: inherit;
        font-size: 21px;
        font-weight: 800;
        line-height: 1.35;
        overflow-wrap: anywhere;
    }

    .cv-position {
        align-self: flex-start;
        margin: 0 0 16px;
        padding: 4px 12px;
        color: var(--a-ink);
        background: var(--a-soft);
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        line-height: 1.6;
        overflow-wrap: anywhere;
    }

    .cv-bio {
        display: -webkit-box;
        overflow: hidden;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        margin: 0 0 22px;
        color: #5c746a;
        font-size: 14px;
        line-height: 1.8;
        overflow-wrap: anywhere;
    }

    .cv-graduation {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-top: auto;
        margin-bottom: 22px;
        padding-top: 18px;
        color: #476158;
        border-top: 1px dashed #d6e6dc;
        font-size: 13px;
        line-height: 1.7;
    }

        .cv-graduation i {
            margin-top: 3px;
            color: var(--a1);
        }

    .cv-graduation-label {
        display: block;
        color: #7b9288;
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: .8px;
        text-transform: uppercase;
    }

    .cv-view {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 13px 18px;
        color: var(--a-ink);
        background: var(--a-soft);
        border-radius: 14px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        transition: background .2s, color .2s;
    }

    .cv-view-arrow {
        display: inline-block;
        transition: transform .25s;
    }

    .cv-view:hover {
        color: #fff;
        background: var(--a1);
    }

        .cv-view:hover .cv-view-arrow {
            transform: translateX(5px);
        }

    /* ---------- EMPTY ---------- */
    .cv-empty {
        padding: 60px 24px;
        background: #fff;
        border: 2px dashed #c6dccf;
        border-radius: 24px;
        text-align: center;
    }

    .cv-empty-icon {
        display: grid;
        place-items: center;
        width: 76px;
        height: 76px;
        margin: 0 auto 20px;
        color: var(--c-brand);
        background: linear-gradient(135deg, #e4f7ed, #c9eddb);
        border-radius: 50%;
        font-size: 28px;
    }

    .cv-empty h2 {
        color: var(--c-ink);
        font-family: inherit;
        font-size: 24px;
        font-weight: 800;
    }

    .cv-empty p {
        max-width: 440px;
        margin: 14px auto 24px;
        color: var(--c-muted);
        font-size: 14px;
        line-height: 1.8;
    }

    .cv-empty-link {
        display: inline-block;
        padding: 12px 24px;
        color: #fff;
        background: var(--c-brand);
        border-radius: 999px;
        font-weight: 700;
        text-decoration: none;
    }

        .cv-empty-link:hover {
            color: #fff;
            background: var(--c-brand-dark);
        }

    /* ---------- FOCUS & MOTION ---------- */
    .cv-page a:focus-visible,
    .cv-search button:focus-visible {
        outline: 3px solid #86d6b6;
        outline-offset: 3px;
    }

    @@keyframes cv-rise {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ---------- RESPONSIVE ---------- */
    @@media (max-width: 991.98px) {
        .cv-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 575.98px) {
        .cv-hero {
            padding: 44px 0 92px;
        }

        .cv-grid {
            grid-template-columns: 1fr;
        }

        .cv-stat {
            width: 100%;
        }

        .cv-search {
            flex-direction: column;
            border-radius: 24px;
        }

            .cv-search button {
                width: 100%;
            }

        .cv-card {
            padding: 0 22px 22px;
        }

        .cv-card-banner {
            margin: 0 -22px;
        }

        .cv-my-profile {
            width: 100%;
            justify-content: center;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .cv-card {
            opacity: 1;
            animation: none;
            transition: none;
        }

            .cv-card:hover {
                transform: none;
            }

        .cv-view-arrow,
        .cv-my-profile,
        .cv-search button {
            transition: none;
        }
    }
</style>
