        height: 110px;
        background: radial-gradient(circle at 85% 20%, #ffffff25 0 50px, transparent 51px), linear-gradient(120deg, #087f5b, #42bc89);
    }

    .pf-sidebar-body {
        padding: 0 26px 28px;
        text-align: center;
    }

    .pf-avatar {
        position: relative;
        width: 104px;
        height: 104px;
        margin: -52px auto 18px;
        overflow: hidden;
        background: #e9f7ee;
        border: 5px solid white;
