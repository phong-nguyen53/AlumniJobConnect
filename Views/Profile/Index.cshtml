</style>

<script>
    (() => {
        const input = document.getElementById("avatarFile");
        const preview = document.getElementById("avatarPreview");
        const fallback = document.getElementById("avatarDefault");

        const savedSrc = preview.getAttribute("src");
        let previewUrl = null;

        function showDefault() {
            preview.hidden = true;
            fallback.hidden = false;
        }

        function restoreSavedAvatar() {
            if (savedSrc) {
                preview.src = savedSrc;
                preview.hidden = false;
                fallback.hidden = true;
            } else {
                preview.removeAttribute("src");
                showDefault();
            }
        }

        preview.addEventListener("error", showDefault);

        if (savedSrc && preview.complete &&
            preview.naturalWidth === 0) {
            showDefault();
        }

        input.addEventListener("change", () => {
            input.setCustomValidity("");

            if (previewUrl) {
                URL.revokeObjectURL(previewUrl);
                previewUrl = null;
            }

            restoreSavedAvatar();

            const file = input.files[0];

            if (!file) return;

            if (!/\.(jpe?g|png)$/i.test(file.name) ||
                file.size === 0 ||
                file.size > 2 * 1024 * 1024) {

                input.setCustomValidity(
                    "Vui lòng chọn ảnh JPG hoặc PNG, tối đa 2 MB."
                );

                input.reportValidity();
                return;
            }

            previewUrl = URL.createObjectURL(file);
            preview.src = previewUrl;
            preview.hidden = false;
            fallback.hidden = true;
        });
    })();
</script>

<script>
    (() => {
        const company = document.getElementById("workCompany");
        const positions = document.getElementById("workPosition");
        const title = document.getElementById("workTitle");
        const custom = document.getElementById("workCustomTitle");
        const help = document.getElementById("companyJobHelp");
        if (!company || !positions || !title) return;
        let request;
        let generation = 0;
        function toggle() {
            const other = positions.value === "0";
            custom.hidden = !other;
            title.disabled = !other;
        }
        async function load(initial) {
            const current = ++generation;
            if (request) request.abort();
            request = new AbortController();
            const savedTitle = initial ? title.value.trim() : "";
            positions.replaceChildren(new Option("Khác — nhập vị trí thực tế", "0"));
            title.disabled = false;
            if (!initial) title.value = "";
            toggle();
            if (!company.value) {
                help.textContent = "Chọn công ty để xem ngành nghề và vị trí đã đăng tuyển.";
                return;
            }
            positions.disabled = true;
            help.textContent = "Đang tải ngành nghề và vị trí…";
            try {
                const url = new URL(positions.dataset.url, window.location.origin);
                url.searchParams.set("companyId", company.value);
                const response = await fetch(url, { signal: request.signal, headers: { Accept: "application/json" } });
                if (!response.ok) throw new Error("load");
                const data = await response.json();
                if (current !== generation) return;
                const seen = new Set();
                for (const job of data.jobs) {
                    const text = job.title.trim();
                    const key = text.toLocaleLowerCase("vi");
                    if (seen.has(key)) continue;
                    seen.add(key);
                    const option = new Option(text, String(job.id));
                    positions.add(option);
                    if (savedTitle && text === savedTitle) positions.value = option.value;
                }
                const industry = data.industry ? "Ngành nghề: " + data.industry + ". " : "Ngành nghề chưa cập nhật. ";
                help.textContent = industry + (seen.size
                    ? "Vị trí gợi ý lấy từ tin đã duyệt và công khai, gồm cả tin hết hạn."
                    : "Công ty chưa có tin phù hợp. Chọn Khác để nhập vị trí.");
            } catch (error) {
                if (current !== generation || error.name === "AbortError") return;
                help.textContent = "Chưa tải được vị trí. Bạn có thể chọn Khác và nhập công việc thực tế.";
            } finally {
                if (current === generation) { positions.disabled = false; toggle(); }
            }
        }
        positions.addEventListener("change", toggle);
        company.addEventListener("change", () => load(false));
        load(true);
    })();
</script>

@if (ViewData["WorkMentorFailed"] is true)
{
    <script>
        document.getElementById("workMentorSection")?.scrollIntoView({ block: "start" });
    </script>
}
