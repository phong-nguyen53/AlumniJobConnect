@using Microsoft.AspNetCore.Mvc.Rendering
@model AlumniJobConnect.Controllers.ProfileController.ProfileInput

@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    var hasAvatar = !string.IsNullOrWhiteSpace(Model.AvatarUrl);
    var graduationState = ViewData["GraduationState"] is int state ? state : 0;
    var isGraduate = graduationState == 2;
    var work = ViewData["WorkMentor"] as AlumniJobConnect.Controllers.ProfileController.WorkMentorInput
        ?? new AlumniJobConnect.Controllers.ProfileController.WorkMentorInput();
    var companies = ViewData["WorkCompanyOptions"]
        as System.Collections.Generic.IEnumerable<SelectListItem>
        ?? System.Array.Empty<SelectListItem>();
    var currentYear = DateTime.UtcNow.AddHours(7).Year;
    var confirmationYear = Model.GraduationYear.HasValue
        && Model.GraduationYear.Value <= currentYear
        ? Model.GraduationYear.Value.ToString()
        : "";
}

<section class="pf-page">

    <!-- ============ HERO ============ -->
    <header class="pf-hero">
        <div class="pf-hero-glow pf-hero-glow-1" aria-hidden="true"></div>
        <div class="pf-hero-glow pf-hero-glow-2" aria-hidden="true"></div>

        <div class="container pf-hero-inner">
            <div class="pf-hero-text">
                <span class="pf-eyebrow">
                    <span class="pf-eyebrow-dot" aria-hidden="true"></span>
                    KHÔNG GIAN CÁ NHÂN
                </span>

                <h1>Hồ sơ <em>của bạn</em></h1>
                <p>Cập nhật thông tin để kết nối với cơ hội phù hợp.</p>
            </div>

            <a href="@Url.Action("Index", "Home")" class="pf-home">
                <span aria-hidden="true">←</span> Trang chủ
            </a>
        </div>
    </header>

    <div class="container pf-body">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger" role="alert">
                <strong>Chưa lưu được thay đổi. Vui lòng kiểm tra:</strong>
                @Html.ValidationSummary(false, "", new { @class = "mb-0" })
            </div>
        }
        <div class="row g-4 pf-row">

            <!-- Thông tin và ảnh đại diện -->
            <div class="col-lg-4">
                <aside class="pf-card pf-sidebar">
                    <div class="pf-cover"></div>

                    <div class="pf-sidebar-body">
                        <div class="pf-avatar">
                            <img id="avatarPreview"
                                 src="@(hasAvatar
                                                                                                                                        ? Url.Action("Avatar", "Profile")
                                                                                                                                        : null)"
                                 alt="Ảnh đại diện"
                                 hidden="@(!hasAvatar)" />

                            <div id="avatarDefault"
                                 class="pf-avatar-default"
                                 hidden="@hasAvatar">
                                <svg viewBox="0 0 100 100"
                                     xmlns="http://www.w3.org/2000/svg"
                                     aria-hidden="true">
                                    <circle cx="50" cy="50" r="50"
                                            fill="#e4f5ed" />

                                    <circle cx="82" cy="20" r="18"
                                            fill="#c5e9d8" />

                                    <circle cx="14" cy="84" r="24"
                                            fill="#c5e9d8" />

                                    <path d="M18 100V88C18 69 32 59 50 59
                                             C68 59 82 69 82 88V100Z"
                                          fill="#168568" />

                                    <circle cx="50" cy="38" r="20"
                                            fill="#f3cfb0" />

                                    <path d="M30 37C26 18 39 13 50 13
                                             C65 13 75 24 70 40
                                             L65 33C55 34 46 29 42 25
                                             C39 31 35 35 30 37Z"
                                          fill="#244a3e" />

                                    <path d="M40 60L50 72L60 60L56 82H44Z"
                                          fill="#fff" />
                                </svg>
                            </div>
                        </div>

                        <h2>@Model.FullName</h2>
                        <p class="pf-email">@Model.Email</p>

                        <span class="pf-badge">
                            <i class="fa fa-graduation-cap" aria-hidden="true"></i>
                            @(isGraduate ? "Cựu sinh viên" : "Sinh viên")
                        </span>

                        <div class="pf-intro">
                            <h3>Giới thiệu bản thân</h3>

                            <p>
                                @(string.IsNullOrWhiteSpace(Model.Bio)
                                                                ? "Bạn chưa thêm giới thiệu bản thân."
                                                                : Model.Bio)
                            </p>
                        </div>

                        <a href="@Url.Action("jobs", "Home")"
                           class="pf-jobs">
                            Khám phá việc làm
                            <span aria-hidden="true">↗</span>
                        </a>
                    </div>
                </aside>
            </div>

            <!-- Form chỉnh sửa -->
            <div class="col-lg-8">
                <div class="pf-card pf-form-card">
                    <div class="pf-form-heading">
                        <h2>Thông tin cá nhân</h2>
                        <p>Quản lý ảnh đại diện và thông tin của bạn.</p>
                    </div>

                    @if (TempData["ProfileSuccess"] is string message)
                    {
                        <div class="alert alert-success" role="status">
                            @message
                        </div>
                    }

                    <form action="@Url.Action("Index", "Profile")"
                          method="post"
                          enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="row g-4">

                            <div class="col-12">
                                <div class="pf-upload">
                                    <label asp-for="AvatarFile"
                                           class="form-label">
                                        Ảnh đại diện
                                    </label>

                                    <p class="pf-help mb-3">
                                        Chọn ảnh JPG hoặc PNG, tối đa 2 MB.
                                        Ảnh sẽ được lưu khi bạn bấm Lưu thay đổi.
                                    </p>

                                    <input asp-for="AvatarFile"
                                           id="avatarFile"
                                           type="file"
                                           accept=".jpg,.jpeg,.png"
                                           class="form-control" />

                                    <span asp-validation-for="AvatarFile"
                                          class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label">
                                    Họ và tên
                                    <span class="text-danger">*</span>
                                </label>

                                <input asp-for="FullName"
                                       class="form-control"
                                       autocomplete="name"
                                       maxlength="150"
                                       placeholder="Nhập họ và tên"
                                       required />

                                <span asp-validation-for="FullName"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label for="pf-email" class="form-label">
                                    Email đăng nhập
                                </label>

                                <input id="pf-email"
                                       type="email"
                                       value="@Model.Email"
                                       class="form-control"
                                       readonly />

                                <small class="pf-help">
                                    Email không thay đổi tại đây.
                                </small>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label">
                                    Số điện thoại
                                </label>

                                <input asp-for="Phone"
                                       type="tel"
                                       class="form-control"
                                       autocomplete="tel"
                                       maxlength="20"
                                       placeholder="Nhập số điện thoại" />

                                <span asp-validation-for="Phone"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="DateOfBirth"
                                       class="form-label">
                                    Ngày sinh
                                </label>

                                <input asp-for="DateOfBirth"
                                       type="date"
                                       asp-format="{0:yyyy-MM-dd}"
                                       class="form-control" />

                                <span asp-validation-for="DateOfBirth"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="GraduationYear"
                                       class="form-label">
                                    @(isGraduate ? "Năm tốt nghiệp" : "Năm tốt nghiệp dự kiến")
                                </label>

                                <input asp-for="GraduationYear"
                                       type="number"
                                       min="1900"
                                       max="2100"
                                       readonly="@isGraduate"
                                       class="form-control"
                                       placeholder="Ví dụ: 2026" />

                                <span asp-validation-for="GraduationYear"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Bio" class="form-label">
                                    Giới thiệu bản thân
                                </label>

                                <textarea asp-for="Bio"
                                          rows="5"
                                          maxlength="1000"
                                          class="form-control"
                                          placeholder="Chia sẻ kỹ năng, kinh nghiệm và định hướng nghề nghiệp của bạn..."></textarea>

                                <small class="pf-help">
                                    Tối đa 1.000 ký tự.
                                </small>

                                <span asp-validation-for="Bio"
                                      class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="pf-actions">
                            <span>
                                Không chọn ảnh mới sẽ giữ ảnh hiện tại.
                            </span>

                            <button type="submit" class="pf-save">
                                <i class="fa fa-check me-2"
                                   aria-hidden="true"></i>
                                Lưu thay đổi
                            </button>
                        </div>
                    </form>
                    @if (TempData["WorkMentorSuccess"] is string workSuccess)
                    {
                        <div class="alert alert-success mt-3" role="status">@workSuccess</div>
                    }

                    @if (isGraduate)
                    {
                        <section id="workMentorSection" class="pf-graduation mt-4" aria-labelledby="workMentorHeading" style="scroll-margin-top: 140px;">
                            <h2 id="workMentorHeading" class="h5 fw-bold mb-2">Công việc và tư vấn</h2>
                            <p class="pf-help mb-3">
                                Công ty, vị trí và thông tin tư vấn sẽ hiển thị trên thẻ cựu sinh viên.
                            </p>
                            <form method="post" action="@Url.RouteUrl("SaveWorkMentor")">
                                @Html.AntiForgeryToken()
                                @if (ViewData["WorkMentorFailed"] is true)
                                {
                                    <div class="alert alert-danger" role="alert">
                                        <strong>Chưa lưu được công việc và tư vấn:</strong>

                                        @foreach (var entry in ViewData.ModelState)
                                        {
                                            foreach (var error in entry.Value.Errors)
                                            {
                                                <p style="display:block !important; color:#842029; margin:8px 0;">
                                                    <strong>@entry.Key:</strong>
                                                    @(string.IsNullOrWhiteSpace(error.ErrorMessage)
                                                                                        ? "Giá trị gửi lên không hợp lệ."
                                                                                        : error.ErrorMessage)
                                </p>
                                                                }
                                        }
                                    </div>
                                }
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label for="workCompany" class="form-label">Công ty đang làm</label>
                                        @Html.DropDownList("Work.CompanyId", companies, "Chọn doanh nghiệp", new {
                                        id = "workCompany", @class = "form-control"
                                                                        })
                                    @Html.ValidationMessage("Work.CompanyId", "", new { @class = "text-danger small" })
                                    <small class="pf-help">Chọn doanh nghiệp đã đăng ký trên hệ thống.</small>
                                </div>
                                <div class="col-md-6">
                                    <label for="workTitle" class="form-label">Vị trí công việc</label>
                                    <select id="workPosition" name="jobPostId" class="form-control"
                                            data-url="@Url.RouteUrl("ProfileCompanyJobs")">
                                        <option value="0">Khác — nhập vị trí thực tế</option>
                                    </select>
                                    @Html.ValidationMessage("jobPostId", "", new { @class = "text-danger small" })
                                    <div id="workCustomTitle" class="mt-2">
                                        @Html.TextBox("Work.JobTitle", work.JobTitle, new {
                                                                                id = "workTitle", @class = "form-control", maxlength = 100,
                                                                                placeholder = "Nhập vị trí công việc thực tế"
                                                                                })
                                    </div>
                                    @Html.ValidationMessage("Work.JobTitle", "", new { @class = "text-danger small" })
                                    <small id="companyJobHelp" class="pf-help" role="status" aria-live="polite">
                                        Chọn công ty để xem ngành nghề và vị trí công ty đã đăng tuyển.
                                    </small>
                                </div>
                                <div class="col-12">
                                    <label for="workExpertise" class="form-label">Chủ đề có thể tư vấn</label>
                                    @Html.TextBox("Work.Expertise", work.Expertise, new {
                                                                        id = "workExpertise", @class = "form-control", maxlength = 150,
                                                                        placeholder = "Ví dụ góp ý CV, phỏng vấn thực tập .NET"
                                                                        })
                                    @Html.ValidationMessage("Work.Expertise", "", new { @class = "text-danger small" })
                                </div>
                                <div class="col-12">
                                    <label for="workIntroduction" class="form-label">Giới thiệu tư vấn</label>
                                    @Html.TextArea("Work.Introduction", work.Introduction, 3, 0, new {
                                                                        id = "workIntroduction", @class = "form-control", maxlength = 500
                                                                        })
                                    @Html.ValidationMessage("Work.Introduction", "", new { @class = "text-danger small" })
                                </div>
                                <div class="col-12">
                                    <div class="d-flex align-items-center gap-2">
                                        @Html.CheckBox("Work.IsAvailable", work.IsAvailable, new { id = "workAvailable" })
                                        <label for="workAvailable" class="form-label mb-0">Sẵn sàng nhận tư vấn</label>
                                    </div>
                                    <p class="pf-help">
                                        Khi bật, hãy điền công ty, vị trí và chủ đề bạn có thể hỗ trợ.
                                    </p>
                                </div>
                            </div>
                            <button type="submit" class="pf-save mt-3">Lưu công việc và tư vấn</button>
                        </form>
                    </section>
                                        }

                    @if (TempData["GraduationSuccess"] is string graduationSuccess)
                    {
                        <div class="alert alert-success mt-3" role="status">
                            @graduationSuccess
                        </div>
                    }

                    @if (TempData["GraduationError"] is string graduationError)
                    {
                        <div class="alert alert-warning mt-3" role="alert">
                            @graduationError
                        </div>
                    }

                    @if (graduationState > 0)
                    {
                        <section class="pf-graduation mt-4" aria-labelledby="graduationHeading">
                            <div>
                                <h2 id="graduationHeading" class="h5 fw-bold mb-3">Tình trạng tốt nghiệp</h2>

                                @if (graduationState == 2)
                                {
                                    <span class="badge bg-success">Cựu sinh viên</span>
                                }
                                else
                                {
                                    <p class="pf-help mb-3">
                                        Khi xác nhận, hồ sơ của bạn sẽ hiển thị là Cựu sinh viên.
                                        Hãy kiểm tra năm tốt nghiệp trước khi gửi.
                                    </p>
                                    <form method="post" action="@Url.RouteUrl("ConfirmGraduation")">
                                        @Html.AntiForgeryToken()

                                        <label for="confirmGraduationYear" class="form-label">
                                            Năm tốt nghiệp
                                        </label>

                                        <input id="confirmGraduationYear"
                                               name="graduationYear"
                                               type="number"
                                               class="form-control mb-3"
                                               min="1900"
                                               max="@currentYear"
                                               value="@confirmationYear"
                                               required />

                                        <button type="submit" class="pf-save">
                                            Xác nhận đã tốt nghiệp
                                        </button>
                                    </form>
                                }
                            </div>
                        </section>
                    }
                </div>
            </div>

        </div>
    </div>
</section>

<style>
    .pf-page {
        --c-ink: #12362a;
        --c-muted: #6b8479;
        --c-brand: #009f6b;
        --c-brand-dark: #00734d;
        --c-soft: #eaf8f0;
        --c-line: #e0ede5;
        padding-bottom: 72px;
        background: #f4faf7;
        font-family: "Segoe UI", system-ui, Arial, sans-serif;
    }

        .pf-page * {
            box-sizing: border-box;
        }

    /* ---------- HERO ---------- */
    .pf-hero {
        position: relative;
        overflow: hidden;
        padding: 56px 0 120px;
        color: #fff;
        background: radial-gradient(circle at 1px 1px, rgb(255 255 255 / 10%) 1px, transparent 0) 0 0 / 22px 22px, linear-gradient(135deg, #0b3d2c 0%, #087a55 55%, #19b383 100%);
    }

    .pf-hero-glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(70px);
        pointer-events: none;
    }

    .pf-hero-glow-1 {
        top: -130px;
        right: -70px;
        width: 360px;
        height: 360px;
        background: rgb(255 214 102 / 35%);
    }

    .pf-hero-glow-2 {
        bottom: -170px;
        left: -90px;
        width: 340px;
        height: 340px;
        background: rgb(120 255 205 / 25%);
    }

    .pf-hero-inner {
        position: relative;
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
    }

    .pf-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 7px 14px;
        color: #d8fff0;
        background: rgb(255 255 255 / 12%);
        border: 1px solid rgb(255 255 255 / 22%);
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.6px;
        backdrop-filter: blur(6px);
    }

    .pf-eyebrow-dot {
        width: 8px;
        height: 8px;
        background: #ffd666;
        border-radius: 50%;
        box-shadow: 0 0 0 4px rgb(255 214 102 / 25%);
    }

    .pf-hero h1 {
        margin: 20px 0 12px;
        color: #fff;
        font-family: inherit;
        font-size: clamp(30px, 4.6vw, 48px);
        font-weight: 800;
        letter-spacing: -.5px;
    }

        .pf-hero h1 em {
            color: #ffd666;
            font-style: normal;
            background: linear-gradient(transparent 82%, rgb(255 214 102 / 35%) 82%);
        }

    .pf-hero p {
        margin: 0;
        color: #d3f1e4;
        font-size: 16px;
        line-height: 1.8;
    }

    .pf-home {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        color: #fff;
        background: rgb(255 255 255 / 14%);
        border: 1px solid rgb(255 255 255 / 25%);
        border-radius: 999px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        backdrop-filter: blur(6px);
        transition: background .2s, transform .2s;
    }

        .pf-home:hover {
            color: #fff;
            background: rgb(255 255 255 / 24%);
            transform: translateX(-3px);
        }

    .pf-body {
        position: relative;
        margin-top: -64px;
    }

        .pf-body > .alert {
            border-radius: 16px;
            box-shadow: 0 10px 26px rgb(11 61 44 / 12%);
        }

    /* ---------- CARDS ---------- */
    .pf-card {
        background: #fff;
        border: 1px solid var(--c-line);
        border-radius: 24px;
        box-shadow: 0 10px 34px rgb(28 72 49 / 8%);
    }

    .pf-sidebar {
        position: sticky;
        top: 24px;
        overflow: hidden;
    }

    .pf-cover {
        height: 120px;
        background: radial-gradient(circle at 1px 1px, rgb(255 255 255 / 30%) 1px, transparent 0) 0 0 / 14px 14px, linear-gradient(120deg, #00b27a, #7be0b6 70%, #ffe08a);
    }

    .pf-sidebar-body {
        padding: 0 26px 28px;
        text-align: center;
    }

    .pf-avatar {
        position: relative;
        width: 124px;
        height: 124px;
        margin: -62px auto 18px;
        overflow: hidden;
        background: #e9f7ee;
        border: 6px solid #fff;
        border-radius: 50%;
        box-shadow: 0 14px 30px rgb(11 61 44 / 22%);
    }

        .pf-avatar img,
        .pf-avatar-default,
        .pf-avatar-default svg {
            display: block;
            width: 100%;
            height: 100%;
        }

        .pf-avatar img {
            object-fit: cover;
        }

        .pf-avatar [hidden] {
            display: none !important;
        }

    .pf-sidebar h2 {
        margin: 0 0 6px;
        color: var(--c-ink);
        font-family: inherit;
        font-size: 22px;
        font-weight: 800;
        overflow-wrap: anywhere;
    }

    .pf-email {
        margin-bottom: 16px;
        color: var(--c-muted);
        font-size: 13px;
        overflow-wrap: anywhere;
    }

    .pf-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 14px;
        color: #006f4a;
        background: #eaf8f0;
        border: 1px solid #c8ebd9;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
    }

    .pf-intro {
        margin-top: 24px;
        padding: 18px;
        background: #f6fbf8;
        border: 1px solid #e0eee6;
        border-radius: 18px;
        text-align: left;
    }

        .pf-intro h3 {
            margin: 0;
            color: #7b9288;
            font-family: inherit;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .8px;
            text-transform: uppercase;
        }

        .pf-intro p {
            margin: 10px 0 0;
            color: #50685d;
            font-size: 14px;
            line-height: 1.8;
            white-space: pre-line;
            overflow-wrap: anywhere;
        }

    .pf-jobs {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 22px;
        padding: 14px 20px;
        color: #fff;
        background: linear-gradient(135deg, #00b27a, #008c60);
        border-radius: 14px;
        box-shadow: 0 8px 20px rgb(0 159 107 / 28%);
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        transition: transform .2s, box-shadow .2s;
    }

        .pf-jobs:hover {
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 12px 26px rgb(0 159 107 / 38%);
        }

    /* ---------- FORM CARD ---------- */
    .pf-form-card {
        padding: 34px;
    }

    .pf-form-heading {
        margin-bottom: 26px;
        padding-bottom: 22px;
        border-bottom: 1px solid #edf2ef;
    }

        .pf-form-heading h2 {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 0 0 8px;
            color: var(--c-ink);
            font-family: inherit;
            font-size: 24px;
            font-weight: 800;
        }

            .pf-form-heading h2::before {
                content: "";
                width: 6px;
                height: 26px;
                background: linear-gradient(180deg, #00b27a, #ffd666);
                border-radius: 6px;
            }

        .pf-form-heading p {
            margin: 0;
            color: var(--c-muted);
            font-size: 14px;
        }

    .pf-upload {
        padding: 20px;
        background: linear-gradient(135deg, #f3fbf7, #fbfff9);
        border: 2px dashed #a9d9c1;
        border-radius: 18px;
    }

