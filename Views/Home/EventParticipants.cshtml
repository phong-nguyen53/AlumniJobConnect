@model System.Collections.Generic.IReadOnlyList<AlumniJobConnect.Controllers.HomeController.EventParticipantItem>

@{
    ViewData["Title"] = "Danh sách người đăng ký";
}

<div class="container py-5">
    <a class="btn btn-outline-secondary btn-sm mb-3"
       href="@Url.Action("Events", "Home")">
        ← Quay lại danh sách sự kiện
    </a>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <h1 class="h4 fw-bold mb-2">Danh sách người đăng ký</h1>
            <p class="text-muted mb-3">@ViewData["EventName"]</p>

            <span class="badge bg-primary mb-3">
                @Model.Count lượt đăng ký
            </span>

            @if (Model.Count == 0)
            {
                <p class="text-muted mb-0" role="status">
                    Chưa có sinh viên đăng ký sự kiện này.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">STT</th>
                                <th scope="col">Họ và tên</th>
                                <th scope="col">Thời điểm đăng ký</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Count; i++)
                            {
                                var participant = Model[i];

                                <tr>
                                    <td>@(i + 1)</td>
                                    <td>@participant.FullName</td>
                                    <td>@participant.RegisteredAt.ToString("dd/MM/yyyy HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>