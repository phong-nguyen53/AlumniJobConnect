@model IEnumerable<AlumniJobConnect.Models.JobPost>
@using AlumniJobConnect.Models
@using System.Linq
@using System.Collections.Generic

@{
    ViewData["Title"] = "Kết quả tìm việc";

    var jobs = Model.ToList();

    var categories = ViewBag.Categories as List<JobCategory>
        ?? new List<JobCategory>();

    string keyword = ViewBag.Keyword as string ?? "";
    string location = ViewBag.Location as string ?? "";

    int? selectedCategoryId = ViewBag.CategoryId == null
        ? null
        : (int)ViewBag.CategoryId;

    bool hasFilter = !string.IsNullOrWhiteSpace(keyword)
        || !string.IsNullOrWhiteSpace(location)
        || selectedCategoryId != null;
}

<style>
    .job-search-page {
        --jp-primary: #00a673;
        --jp-primary-dark: #008c61;
        --jp-primary-soft: #e8f7f0;
        --jp-ink: #1f3a30;
        --jp-text: #476357;
        --jp-muted: #6b7f76;
        --jp-border: #dcebe4;
        --jp-bg-soft: #f6fbf8;
        padding-top: 32px;
        padding-bottom: 60px;
    }

        /* ---------- Hero ---------- */
        .job-search-page .search-hero {
            padding: 36px 32px 110px;
            border-radius: 22px;
            background: linear-gradient(135deg, #00a673 0%, #0b7f5d 100%);
            color: #fff;
            position: relative;
            overflow: hidden;
        }

            .job-search-page .search-hero::after {
                content: "";
                position: absolute;
                right: -60px;
                top: -60px;
                width: 240px;
                height: 240px;
                border-radius: 50%;
                background: rgba(255, 255, 255, .08);
            }

        .job-search-page .search-heading {
            margin: 0 0 8px;
            font-size: 32px;
            font-weight: 800;
            letter-spacing: -.3px;
            color: #fff;
        }

        .job-search-page .search-sub {
            margin: 0;
            max-width: 560px;
            color: rgba(255, 255, 255, .88);
            font-size: 16px;
        }

        /* ---------- Filter panel ---------- */
        .job-search-page .filter-panel {
            position: relative;
            z-index: 2;
            margin: -70px 20px 32px;
            padding: 24px;
            border: 1px solid var(--jp-border);
            border-radius: 18px;
            background: #fff;
            box-shadow: 0 16px 40px rgba(18, 80, 55, .10);
        }

        .job-search-page .filter-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 20px;
        }

        .job-search-page .filter-label {
            display: block;
            margin-bottom: 8px;
            color: var(--jp-ink);
            font-size: 14px;
            font-weight: 600;
        }

        .job-search-page .filter-input {
            display: block;
            width: 100%;
            min-height: 48px;
            padding: 11px 14px;
            color: var(--jp-ink);
            background: #fff;
            border: 1px solid #d5e4dc;
            border-radius: 12px;
            transition: border-color .15s, box-shadow .15s;
        }

            .job-search-page .filter-input::placeholder {
                color: #98aaa1;
            }

            .job-search-page .filter-input:focus {
                outline: none;
                border-color: var(--jp-primary);
                box-shadow: 0 0 0 4px rgba(0, 166, 115, .12);
            }

        .job-search-page .category-search {
            margin-bottom: 8px;
            background: var(--jp-bg-soft);
        }

        .job-search-page .filter-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 22px;
        }

        .job-search-page .search-button,
        .job-search-page .reset-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 46px;
            padding: 10px 24px;
            border-radius: 12px;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition: background .15s, border-color .15s, transform .1s;
        }

        .job-search-page .search-button {
            border: 1px solid var(--jp-primary);
            background: var(--jp-primary);
            color: #fff;
        }

            .job-search-page .search-button:hover {
                background: var(--jp-primary-dark);
                border-color: var(--jp-primary-dark);
            }

            .job-search-page .search-button:active {
                transform: translateY(1px);
            }

        .job-search-page .reset-button {
            border: 1px solid #d5e4dc;
            background: #fff;
            color: #476357;
        }

            .job-search-page .reset-button:hover {
                background: var(--jp-bg-soft);
                color: var(--jp-ink);
            }

        /* ---------- Result header ---------- */
        .job-search-page .result-head {
            display: flex;
            flex-wrap: wrap;
            align-items: baseline;
            justify-content: space-between;
            gap: 8px 16px;
            margin-bottom: 20px;
        }

        .job-search-page .result-title {
            margin: 0;
            font-size: 22px;
            font-weight: 700;
            color: var(--jp-ink);
        }

        .job-search-page .result-count {
            margin: 0;
            color: var(--jp-muted);
        }

            .job-search-page .result-count strong {
                color: var(--jp-primary-dark);
            }

        /* ---------- Job card ---------- */
        .job-search-page .job-card {
            position: relative;
            padding: 24px 24px 20px 28px;
            margin-bottom: 16px;
            border: 1px solid var(--jp-border);
            border-radius: 16px;
            background: #fff;
            box-shadow: 0 4px 16px rgba(25, 80, 55, .04);
            transition: transform .15s, box-shadow .15s, border-color .15s;
        }

            .job-search-page .job-card::before {
                content: "";
                position: absolute;
                left: 0;
                top: 18px;
                bottom: 18px;
                width: 4px;
                border-radius: 0 4px 4px 0;
                background: var(--jp-primary);
                opacity: 0;
                transition: opacity .15s;
            }

            .job-search-page .job-card:hover {
                transform: translateY(-2px);
                border-color: #bfe3d3;
                box-shadow: 0 12px 28px rgba(25, 80, 55, .10);
            }

                .job-search-page .job-card:hover::before {
                    opacity: 1;
                }

        .job-search-page .card-top {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px;
            margin-bottom: 12px;
        }

        .job-search-page .category-badge {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 20px;
            background: var(--jp-primary-soft);
            color: #008d62;
            font-size: 13px;
            font-weight: 600;
        }

        .job-search-page .status-badge {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
        }

            .job-search-page .status-badge.expired {
                background: #fdecea;
                color: #c0392b;
            }

        .job-search-page .job-title {
            margin: 0 0 14px;
            font-size: 21px;
            font-weight: 700;
            line-height: 1.35;
        }

            .job-search-page .job-title a {
                color: var(--jp-ink);
                text-decoration: none;
            }

                .job-search-page .job-title a:hover {
                    color: var(--jp-primary);
                }

        .job-search-page .job-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 10px 12px;
            margin: 0 0 16px;
            padding: 0;
            list-style: none;
        }

            .job-search-page .job-meta li {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                padding: 6px 12px;
                border-radius: 10px;
                background: var(--jp-bg-soft);
                color: var(--jp-text);
                font-size: 14px;
            }

            .job-search-page .job-meta svg {
                flex: none;
                width: 16px;
                height: 16px;
                stroke: var(--jp-primary);
            }

        .job-search-page details {
            padding-top: 14px;
            border-top: 1px dashed var(--jp-border);
        }

        .job-search-page summary {
            color: #009b6b;
            cursor: pointer;
            font-weight: 600;
            list-style: none;
            user-select: none;
        }

            .job-search-page summary::-webkit-details-marker {
                display: none;
            }

            .job-search-page summary::after {
                content: " ▾";
            }

        .job-search-page details[open] summary::after {
            content: " ▴";
        }

        .job-search-page .job-description {
            margin-top: 12px;
            padding: 14px 16px;
            border-radius: 12px;
            background: var(--jp-bg-soft);
            color: var(--jp-text);
            line-height: 1.65;
            white-space: pre-line;
            overflow-wrap: anywhere;
        }

        /* ---------- Empty ---------- */
        .job-search-page .empty-result {
            padding: 48px 20px;
            text-align: center;
            border: 1px dashed #cbded3;
            border-radius: 18px;
            background: var(--jp-bg-soft);
        }

            .job-search-page .empty-result svg {
                width: 44px;
                height: 44px;
                margin-bottom: 12px;
                stroke: #9bb8aa;
            }

            .job-search-page .empty-result h3 {
                margin-bottom: 6px;
                font-size: 20px;
                color: var(--jp-ink);
            }

    /* ---------- Responsive ---------- */
    @@media (max-width: 991px) {
        .job-search-page .filter-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 767px) {
        .job-search-page .search-hero {
            padding: 26px 20px 100px;
            border-radius: 18px;
        }

        .job-search-page .search-heading {
            font-size: 26px;
        }

        .job-search-page .filter-panel {
            margin: -70px 8px 26px;
            padding: 18px;
        }

        .job-search-page .filter-grid {
            grid-template-columns: 1fr;
        }

        .job-search-page .filter-actions > * {
            flex: 1 1 100%;
        }

        .job-search-page .job-card {
            padding: 18px;
        }
    }
</style>

<div class="container job-search-page">

    <header class="search-hero">
        <h1 class="search-heading">Tìm việc làm phù hợp</h1>
        <p class="search-sub">
            Tìm kiếm công việc theo tên vị trí, ngành nghề và địa điểm.
        </p>
    </header>

    <form asp-controller="Home"
          asp-action="Jobs"
          asp-area=""
          method="get"
          class="filter-panel">

        <div class="filter-grid">
            <div>
                <label for="keyword" class="filter-label">Tên công việc</label>

                <input type="search"
                       id="keyword"
                       name="keyword"
                       value="@keyword"
                       class="filter-input"
                       placeholder="Ví dụ: Lập trình viên, kế toán..." />
            </div>

            <div>
                <label for="categoryId" class="filter-label">Ngành nghề</label>

                <input type="search"
                       id="categorySearch"
                       class="filter-input category-search"
                       placeholder="Tìm nhanh ngành nghề..."
                       aria-label="Tìm nhanh trong danh sách ngành nghề" />

                <select id="categoryId"
                        name="categoryId"
                        class="filter-input">

                    <option value="">Tất cả ngành nghề</option>

                    @foreach (var category in categories)
                    {
                        <option value="@category.JobCategoryId"
                                selected="@(selectedCategoryId == category.JobCategoryId)">
                            @category.CategoryName
                        </option>
                    }
                </select>

                <small id="categorySearchStatus"
                       class="text-muted"
                       aria-live="polite"></small>
            </div>

            <div>
                <label for="location" class="filter-label">Địa điểm làm việc</label>

                <input type="search"
                       id="location"
                       name="location"
                       value="@location"
                       class="filter-input"
                       placeholder="Ví dụ: Nghệ An, Hà Nội..." />
            </div>
        </div>

        <div class="filter-actions">
            <button type="submit" class="search-button">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" />
                    <path d="m20 20-3.5-3.5" />
                </svg>
                Tìm việc
            </button>

            <a asp-controller="Home"
               asp-action="Jobs"
               asp-area=""
               class="reset-button">
                Xóa bộ lọc
            </a>
        </div>
    </form>

    <div class="result-head">
        <h2 class="result-title">Kết quả tìm việc</h2>

        <p class="result-count">
            Tìm thấy <strong>@jobs.Count</strong> tin tuyển dụng
        </p>
    </div>

    @if (jobs.Count == 0)
    {
        <div class="empty-result">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="7" width="18" height="13" rx="2" />
                <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
            </svg>

            <h3>Chưa tìm thấy công việc phù hợp</h3>

            <p class="text-muted mb-0">
                @(hasFilter
                            ? "Bạn hãy thử từ khóa khác hoặc xóa bớt điều kiện lọc."
                            : "Hiện chưa có tin tuyển dụng nào được đăng.")
        </p>
    </div>
        }

    @foreach (var item in jobs)
    {
        bool expired = item.Deadline.HasValue
        && item.Deadline.Value < DateOnly.FromDateTime(DateTime.Today);

        <article class="job-card">
            <div class="card-top">
                <span class="category-badge">
                    @(item.JobCategory?.CategoryName ?? "Ngành nghề khác")
                </span>

                @if (expired)
                {
                    <span class="status-badge expired">Đã hết hạn</span>
                }
        </div>

        <h3 class="job-title">
            <a asp-controller="Jobs"
               asp-action="Details"
               asp-area=""
               asp-route-id="@item.JobPostId">
                @item.Title
            </a>
        </h3>

        <ul class="job-meta">
            <li>
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11z" />
                    <circle cx="12" cy="10" r="2.5" />
                </svg>
                @(string.IsNullOrWhiteSpace(item.WorkLocation)
                                ? "Chưa cập nhật"
                                : item.WorkLocation)
                                                </li>

            <li>
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="7" width="18" height="13" rx="2" />
                    <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                </svg>
                @(string.IsNullOrWhiteSpace(item.EmploymentType)
                                ? "Chưa cập nhật"
                                : item.EmploymentType)
            </li>

                <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="9" cy="8" r="3.5" />
                        <path d="M2.5 20a6.5 6.5 0 0 1 13 0" />
                        <path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14.5a6.5 6.5 0 0 1 3.5 5.5" />
                    </svg>
                    Tuyển @item.Quantity người
                </li>

                <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="5" width="18" height="16" rx="2" />
                        <path d="M3 10h18M8 3v4M16 3v4" />
                    </svg>
                    Hạn nộp:
                    @(item.Deadline?.ToString("dd/MM/yyyy") ?? "Chưa quy định")
                </li>
            </ul>

            <details>
                <summary>Mô tả công việc</summary>

                <div class="job-description">@item.JobDescription</div>
            </details>
        </article>
        }
</div>

@section Scripts {
    <script>
        (() => {
            const search = document.getElementById("categorySearch");
            const select = document.getElementById("categoryId");
            const status = document.getElementById("categorySearchStatus");

            if (!search || !select || !status) {
                return;
            }

            // Giữ các option gốc để khôi phục khi đổi từ khóa.
            const categories = Array.from(select.options)
                .filter(option => option.value !== "")
                .map(option => ({
                    value: option.value,
                    text: option.text.trim()
                }));

            let selectedValue = select.value;

            const normalize = value => value
                .normalize("NFD")
                .replace(/[̀-ͯ]/g, "")
                .replace(/đ/g, "d")
                .replace(/Đ/g, "D")
                .toLowerCase()
                .trim();

            select.addEventListener("change", () => {
                selectedValue = select.value;
            });

            search.addEventListener("input", () => {
                const term = normalize(search.value);

                const matches = categories.filter(category =>
                    normalize(category.text).includes(term)
                );

                select.replaceChildren(
                    new Option("Tất cả ngành nghề", "")
                );

                // Giữ ngành đang chọn dù nó không khớp từ khóa tìm nhanh.
                const visibleCategories = categories.filter(category =>
                    category.value === selectedValue ||
                    normalize(category.text).includes(term)
                );

                visibleCategories.forEach(category => {
                    select.add(new Option(
                        category.text,
                        category.value,
                        false,
                        category.value === selectedValue
                    ));
                });

                select.value = selectedValue;

                status.textContent = term
                    ? `Có ${matches.length} ngành nghề phù hợp.`
                    : "";
            });
        })();
    </script>
}
