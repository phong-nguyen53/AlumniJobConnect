@model System.Collections.Generic.IReadOnlyList<AlumniJobConnect.Models.Company>

@{
    ViewData["Title"] = "Doanh nghiệp";
}

<div class="container py-5">
    <header class="rounded-3 bg-light p-4 p-md-5 mb-4">
        <h1 class="h2 fw-bold mb-2">Doanh nghiệp</h1>
        <p class="text-muted mb-0">
            Khám phá các doanh nghiệp đang tham gia AlumniJobConnect.
        </p>
    </header>

    @if (Model.Count == 0)
    {
        <div class="alert alert-light border" role="status">
            Chưa có hồ sơ doanh nghiệp nào.
        </div>
    }
    else
    {
        <p class="text-muted mb-3">@Model.Count doanh nghiệp</p>

        <div class="row g-4">
            @foreach (var company in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <article class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4 d-flex flex-column">
                            <h2 class="h5 fw-bold mb-2">
                                @company.CompanyName
                            </h2>

                            <p class="text-muted mb-3">
                                @(string.IsNullOrWhiteSpace(company.Industry)
                                                        ? "Chưa cập nhật ngành nghề"
                                                        : company.Industry)
                    </p>

                            <div class="mt-auto">
                                <a class="btn btn-outline-primary btn-sm"
                                   href="@Url.Action("Details", "CompanyProfile", new { area = "", id = company.CompanyId })">
                                    Xem hồ sơ
                                </a>
                            </div>
                        </div>
                    </article>
                </div>
                }
        </div>
    }
</div>