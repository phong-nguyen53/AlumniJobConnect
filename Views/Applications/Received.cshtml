<script>
    (() => {
        function setupInterviewForms() {
            document.querySelectorAll(".js-status-select").forEach(select => {
                const form = select.closest("form");
                const fields = form?.querySelector(".js-interview-fields");

                if (!fields) return;

                function updateFields() {
                    const selectedOption = select.options[select.selectedIndex];
                    const isInterview = selectedOption?.dataset.code === "INTERVIEW";

                    fields.hidden = !isInterview;
                    select.setAttribute("aria-expanded", String(isInterview));

                    fields.querySelectorAll("input, textarea").forEach(input => {
                        input.disabled = !isInterview;
                        input.required = isInterview &&
                            (input.name === "interviewAt" ||
                             input.name === "interviewLocation");
                    });
                }

                select.addEventListener("change", updateFields);
                updateFields();
            });
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", setupInterviewForms);
        } else {
            setupInterviewForms();
        }
    })();
</script>
<script>
    document.querySelectorAll(".js-interview-date").forEach(input => {
        const preview = input.parentElement.querySelector(".rx-date-preview");
        function showDate() {
            if (!input.value) { preview.textContent = "Chọn ngày và giờ để đặt lịch."; return; }
            // Dùng các thành phần nhập trực tiếp, không đổi múi giờ.
            const parts = input.value.split("T");
            const date = parts[0].split("-");
            const time = parts[1]?.slice(0, 5) || "";
            preview.textContent = "Lịch hẹn: " + time + " · " + date[2] + "/" + date[1] + "/" + date[0];
        }
        input.addEventListener("input", showDate);
        showDate();
    });
</script>
<script>
    (() => {
        const cards = Array.from(document.querySelectorAll(".rx-card"));
        const search = document.getElementById("rx-search");
        const chips = Array.from(document.querySelectorAll(".rx-chip"));
        const counter = document.getElementById("rx-visible-count");
        const noResult = document.getElementById("rx-no-result");
        if (!search || cards.length === 0) return;

        let filter = "ALL";

        function normalize(s) {
            return (s || "").toLowerCase().normalize("NFC").trim();
        }

        function apply() {
            const q = normalize(search.value);
            let visible = 0;
            cards.forEach(card => {
                const okStatus = filter === "ALL" || card.dataset.status === filter;
                const okText = !q || (card.dataset.search || "").includes(q);
                const show = okStatus && okText;
                card.hidden = !show;
                if (show) visible++;
            });
            if (counter) {
                counter.textContent = (q || filter !== "ALL")
                    ? "Hiển thị " + visible + "/" + cards.length + " hồ sơ"
                    : "↓ Mới gửi nhất ở trên";
            }
            if (noResult) noResult.hidden = visible !== 0;
        }

        chips.forEach(chip => chip.addEventListener("click", () => {
            filter = chip.dataset.filter;
            chips.forEach(c => c.classList.toggle("is-active", c === chip));
            apply();
        }));
        search.addEventListener("input", apply);
    })();
</script>

