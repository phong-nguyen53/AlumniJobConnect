@using System.Linq
@model IEnumerable<AlumniJobConnect.Models.Application>

@{
    ViewData["Title"] = "Đơn ứng tuyển của tôi";

    // Chọn màu badge theo trạng thái
    string GetStatusClass(string? statusName)
    {
        var s = (statusName ?? string.Empty).Trim().ToLowerInvariant();

        if (s.Contains("chấp nhận") || s.Contains("trúng tuyển") || s.Contains("đạt") || s.Contains("accepted") || s.Contains("hired"))
            return "status-success";
        if (s.Contains("từ chối") || s.Contains("không đạt") || s.Contains("rejected"))
            return "status-danger";
        if (s.Contains("phỏng vấn") || s.Contains("interview"))
            return "status-info";
        if (s.Contains("xem xét") || s.Contains("đang xử lý") || s.Contains("review"))
            return "status-warning";

        return "status-secondary";
    }
}

<style>
    .app-hero {
        background: linear-gradient(135deg, #198754 0%, #20c997 100%);
        color: #fff;
        border-radius: 1rem;
        padding: 2rem 2rem;
    }

        .app-hero .count-pill {
            background: rgba(255, 255, 255, .2);
            border-radius: 50rem;
            padding: .35rem .9rem;
            font-weight: 600;
            backdrop-filter: blur(4px);
        }

    .app-card {
        border: 0;
        border-radius: 1rem;
        transition: transform .2s ease, box-shadow .2s ease;
        overflow: hidden;
        position: relative;
    }

        .app-card::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 5px;
            background: linear-gradient(180deg, #198754, #20c997);
        }

        .app-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 .75rem 1.5rem rgba(0, 0, 0, .12) !important;
        }

    .company-avatar {
        width: 48px;
        height: 48px;
        border-radius: .75rem;
        background: #e8f5ee;
        color: #198754;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1.2rem;
        flex-shrink: 0;
    }

    .job-title {
        font-size: 1.1rem;
        font-weight: 600;
        line-height: 1.3;
    }

    .meta-row {
        color: #6c757d;
        font-size: .9rem;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .4rem .8rem;
        border-radius: 50rem;
        font-size: .8rem;
        font-weight: 600;
    }

        .status-badge::before {
            content: "";
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: currentColor;
        }

    .status-success {
        background: #d1e7dd;
        color: #0f5132;
    }

    .status-danger {
        background: #f8d7da;
        color: #842029;
    }

    .status-info {
        background: #cff4fc;
        color: #055160;
    }

    .status-warning {
        background: #fff3cd;
        color: #664d03;
    }

    .status-secondary {
        background: #e9ecef;
        color: #495057;
    }

    .empty-state {
        text-align: center;
        padding: 3.5rem 1rem;
        background: #f8f9fa;
        border: 2px dashed #ced4da;
        border-radius: 1rem;
    }

        .empty-state .empty-icon {
            font-size: 3.5rem;
            line-height: 1;
            margin-bottom: 1rem;
        }
</style>

<section class="container py-5">

    <!-- Header -->
    <div class="app-hero shadow-sm mb-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <h1 class="h2 fw-bold mb-1">📄 Đơn ứng tuyển của tôi</h1>
                <p class="mb-0 opacity-75">
                    Theo dõi trạng thái các hồ sơ bạn đã gửi.
                </p>
            </div>
            <span class="count-pill">
                @Model.Count() đơn
            </span>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state" role="status">
            <div class="empty-icon">📭</div>
            <h2 class="h5 mb-2">Bạn chưa gửi đơn ứng tuyển nào</h2>
            <p class="text-muted mb-4">
                Hãy khám phá các doanh nghiệp và gửi hồ sơ đầu tiên của bạn.
            </p>
            <a href="@Url.Action("Index", "CompanyProfile")"
               class="btn btn-success btn-lg px-4">
                🔍 Khám phá doanh nghiệp
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                var companyName = item.JobPost.Company.CompanyName ?? "";
                var initial = string.IsNullOrWhiteSpace(companyName)
                ? "?"
                : companyName.Trim().Substring(0, 1).ToUpper();

                <div class="col-12 col-md-6">
                    <article class="card app-card h-100 shadow-sm">
                        <div class="card-body p-4 ps-4">

                            <!-- Tiêu đề + công ty -->
                            <div class="d-flex align-items-start gap-3 mb-3">
                                <div class="company-avatar" aria-hidden="true">@initial</div>
                                <div class="flex-grow-1">
                                    <h2 class="job-title mb-1">@item.JobPost.Title</h2>
                                    <div class="meta-row">🏢 @companyName</div>
                                </div>
                            </div>

                            <hr class="my-3 opacity-25" />

                            <!-- Thông tin -->
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
                                <div class="meta-row">
                                    🗓️ <span class="fw-semibold text-dark">Ngày gửi:</span>
                                    @item.AppliedAt.ToString("dd/MM/yyyy HH:mm")
                                </div>

                                <span class="status-badge @GetStatusClass(item.ApplicationStatus?.StatusName)">
                                    @item.ApplicationStatus?.StatusName
                                </span>
                            </div>

                            <!-- Hành động -->
                            <div class="d-flex flex-wrap gap-2">
                                <a href="@Url.Action("Details", "CompanyProfile", new { id = item.JobPost.CompanyId })"
                                   class="btn btn-success btn-sm px-3">
                                    Xem doanh nghiệp
                                </a>

                                @if (!string.IsNullOrWhiteSpace(item.Cvurl))
                                {
                                    <a href="@Url.Action("DownloadCv", "Applications", new { id = item.ApplicationId })"
                                       class="btn btn-outline-secondary btn-sm px-3">
                                        ⬇️ Tải CV đã gửi
                                    </a>
                                }
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>