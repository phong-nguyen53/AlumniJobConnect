@{
    ViewData["Title"] = "Trợ lý AI doanh nghiệp & việc làm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/assets/css/aichat-history.css" asp-append-version="true" />
<div class="aichat-page" id="aichat-app"
     data-send="@Url.Action("Send", "AiChat", new { area = "" })"
     data-history="@Url.Action("History", "AiChat", new { area = "" })"
     data-messages="@Url.Action("Messages", "AiChat", new { area = "" })"
     data-delete="@Url.Action("Delete", "AiChat", new { area = "" })">
    <div class="aichat-intro">
        <div>
            <span class="aichat-eyebrow">ALUMNIJOBCONNECT / TRỢ LÝ NGHỀ NGHIỆP</span>
            <h1>Cơ hội phù hợp, bắt đầu từ một câu hỏi.</h1>
            <p>Tìm hiểu doanh nghiệp và việc làm qua dữ liệu trên hệ thống.</p>
        </div>
        <span class="aichat-label">✦ Hỗ trợ bằng AI</span>
    </div>
    <div class="aichat-workspace">
        <aside class="aichat-sidebar" aria-label="Lịch sử trò chuyện">
            <button class="aichat-new" id="aichat-new" type="button">＋ Cuộc trò chuyện mới</button>
            <div class="aichat-history-heading">
                <h2>Lịch sử trò chuyện</h2>
                <button type="button" id="aichat-refresh" class="aichat-icon-button" aria-label="Tải lại lịch sử" title="Tải lại lịch sử">↻</button>
            </div>
            <p class="aichat-sidebar-note">Các cuộc trò chuyện của riêng bạn.</p>
            <div id="aichat-history-list" class="aichat-history-list"></div>
            <p id="aichat-history-empty" class="aichat-history-empty" hidden>Chưa có cuộc trò chuyện.<br>Hãy gửi câu hỏi đầu tiên nhé.</p>
            <button type="button" id="aichat-more-history" class="aichat-more" hidden>Xem thêm lịch sử</button>
            <div class="aichat-saved-note"><span>◷</span><p>Lịch sử được lưu theo tài khoản.<br>Bạn có thể quay lại và hỏi tiếp.</p></div>
        </aside>
        <section class="aichat-main" aria-label="Trợ lý AI">
            <header class="aichat-chat-header">
                <div class="aichat-assistant-icon" aria-hidden="true">✦</div>
                <div class="aichat-header-copy">
                    <h2 id="aichat-title">Trợ lý AI doanh nghiệp & việc làm</h2>
                    <p><span class="aichat-dot"></span> Hỏi về công ty, vị trí tuyển dụng và yêu cầu công việc</p>
                </div>
            </header>
            <div id="aichat-error" class="aichat-error" role="alert" hidden></div>
            <div class="aichat-timeline" id="aichat-timeline">
                <button id="aichat-older" type="button" class="aichat-more aichat-older" hidden>Xem tin nhắn trước</button>
                <div id="aichat-log" role="log" aria-live="polite" aria-label="Nội dung cuộc trò chuyện"></div>
            </div>
            <div class="aichat-suggestions" id="aichat-suggestions">
                <span>Thử hỏi</span>
                <button type="button" data-question="Có những doanh nghiệp nào trên hệ thống?">Doanh nghiệp trên hệ thống</button>
                <button type="button" data-question="Có việc lập trình ở Vinh không?">Việc lập trình ở Vinh</button>
                <button type="button" data-question="Có tin nào với khoảng lương đạt từ 10 triệu đồng không?">Việc lương từ 10 triệu</button>
            </div>
            <form id="aichat-form" class="aichat-form">
                @Html.AntiForgeryToken()
                <label class="aichat-visually-hidden" for="aichat-question">Câu hỏi của bạn</label>
                <div class="aichat-compose">
                    <textarea id="aichat-question" rows="2" maxlength="1500" required placeholder="Bạn muốn tìm hiểu điều gì về doanh nghiệp hoặc việc làm?"></textarea>
                    <div class="aichat-compose-bottom">
                        <span id="aichat-count">0 / 1500</span>
                        <button id="aichat-send" type="submit">Gửi câu hỏi <span aria-hidden="true">↗</span></button>
                    </div>
                </div>
                <div class="aichat-helper"><span id="aichat-status" role="status">Enter để gửi · Shift + Enter để xuống dòng</span><span>Lưu lịch sử tự động</span></div>
                <p class="aichat-disclosure">AI có thể nhầm; hãy đối chiếu nguồn tham khảo. Câu hỏi và dữ liệu liên quan được gửi đến OpenAI để xử lý. Không nhập thông tin bí mật. Đây là trợ lý AI, không phải tin nhắn gửi doanh nghiệp.</p>
            </form>
        </section>
    </div>
</div>
<script src="~/assets/js/aichat-history.js" asp-append-version="true" defer></script>
