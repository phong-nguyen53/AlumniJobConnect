        <symbol id="jd-gift" viewBox="0 0 24 24"><rect x="3" y="8" width="18" height="4" rx="1" /><path d="M12 8v13M5 12v8a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-8M7.5 8a2.5 2.5 0 0 1 0-5C10 3 12 8 12 8s2-5 4.5-5a2.5 2.5 0 0 1 0 5" /></symbol>
        <symbol id="jd-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20a6.5 6.5 0 0 1 13 0" /><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14.5a6.5 6.5 0 0 1 3.5 5.5" /></symbol>
        <symbol id="jd-case" viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="13" rx="2" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></symbol>
        <symbol id="jd-cal" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></symbol>
        <symbol id="jd-flag" viewBox="0 0 24 24"><path d="M5 21V4M5 4h11l-2 4 2 4H5" /></symbol>
        <symbol id="jd-send" viewBox="0 0 24 24"><path d="m22 2-11 11M22 2l-7 20-4-9-9-4z" /></symbol>
        <symbol id="jd-robot" viewBox="0 0 24 24"><rect x="4" y="8" width="16" height="12" rx="3" /><path d="M12 8V4M9 14h.01M15 14h.01M2 14v2M22 14v2" /></symbol>
        <symbol id="jd-chatic" viewBox="0 0 24 24"><path d="M21 12a8 8 0 0 1-11.5 7.2L4 20l1-4.3A8 8 0 1 1 21 12z" /></symbol>
        <symbol id="jd-login" viewBox="0 0 24 24"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3" /></symbol>
    </defs>
</svg>

<section class="job-detail-page">
    <div class="container">

        <div class="jd-topbar">
            <a href="@Url.Action("Jobs", "Home",
                                                          new { area = "", categoryId = Model.JobCategoryId })"
               class="jd-back">
                <svg class="ic" width="16" height="16" aria-hidden="true"><use href="#jd-back" /></svg>
                Xem việc làm cùng ngành
            </a>

            <button type="button" class="jd-share" id="jdShare">
                <svg class="ic" width="16" height="16" aria-hidden="true"><use href="#jd-link" /></svg>
                <span>Sao chép liên kết</span>
            </button>
        </div>

        @* ================= HEADER ================= *@
        <header class="jd-header">
            <div class="jd-head-row">
                <div class="jd-avatar" aria-hidden="true">@avatarInitial</div>

                <div class="jd-head-main">
                    <div class="jd-tags">
                        <span class="jd-category">@categoryName</span>

                        <span class="jd-status @deadlineClass">
                            @deadlineStatus
                        </span>
                    </div>

                    <h1>@Model.Title</h1>

                    @if (!string.IsNullOrWhiteSpace(Model.Company?.CompanyName))
                    {
                        <p class="jd-company">
                            <svg class="ic" aria-hidden="true"><use href="#jd-building" /></svg>
                            @Model.Company.CompanyName
                        </p>
                    }
                </div>
            </div>
        </header>

        @* ================= SUMMARY ================= *@
        <div class="jd-summary">
            <div class="jd-summary-item">
                <span class="jd-summary-icon">
                    <svg class="ic" aria-hidden="true"><use href="#jd-money" /></svg>
                </span>
                <div>
                    <span class="jd-summary-label">Mức lương</span>
                    <strong class="jd-salary">@GetSalary()</strong>
                </div>
            </div>

            <div class="jd-summary-item">
                <span class="jd-summary-icon">
                    <svg class="ic" aria-hidden="true"><use href="#jd-pin" /></svg>
                </span>
                <div>
                    <span class="jd-summary-label">Địa điểm làm việc</span>
                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.WorkLocation)
                                                ? "Chưa cập nhật"
                                                : Model.WorkLocation)
                    </strong>
                </div>
            </div>

            <div class="jd-summary-item">
                <span class="jd-summary-icon">
                    <svg class="ic" aria-hidden="true"><use href="#jd-clock" /></svg>
                </span>
                <div>
                    <span class="jd-summary-label">Hình thức làm việc</span>
                    <strong>@employmentText</strong>
                </div>
            </div>
        </div>

        <div class="jd-grid">
            @* ================= CONTENT ================= *@
            <article class="jd-box">
                <section class="jd-block">
                    <h2 class="jd-title">
                        <span class="jd-title-icon"><svg class="ic" aria-hidden="true"><use href="#jd-doc" /></svg></span>
                        Mô tả công việc
                    </h2>
                    <div class="jd-text">@Model.JobDescription</div>
                </section>

                <section class="jd-block">
                    <h2 class="jd-title">
                        <span class="jd-title-icon"><svg class="ic" aria-hidden="true"><use href="#jd-target" /></svg></span>
                        Yêu cầu ứng viên
                    </h2>

                    @if (requirementLines.Length == 0)
                    {
                        <div class="jd-text jd-empty">Doanh nghiệp chưa cập nhật yêu cầu.</div>
                    }
                    else if (requirementLines.Length == 1)
                    {
                        <div class="jd-text">@requirementLines[0]</div>
                    }
                    else
                    {
                        <ul class="jd-list">
                            @foreach (var line in requirementLines)
                            {
                                <li>@line</li>
                            }
                        </ul>
                    }
                </section>

                <section class="jd-block">
                    <h2 class="jd-title">
                        <span class="jd-title-icon"><svg class="ic" aria-hidden="true"><use href="#jd-gift" /></svg></span>
                        Quyền lợi
                    </h2>

                    @if (benefitLines.Length == 0)
                    {
                        <div class="jd-text jd-empty">Doanh nghiệp chưa cập nhật quyền lợi.</div>
                    }
                    else if (benefitLines.Length == 1)
                    {
                        <div class="jd-text">@benefitLines[0]</div>
                    }
                    else
                    {
                        <ul class="jd-list is-benefit">
                            @foreach (var line in benefitLines)
                            {
                                <li>@line</li>
                            }
                        </ul>
                    }
                </section>
            </article>

            @* ================= SIDEBAR ================= *@
            <aside class="jd-box jd-side">
                <h2 class="jd-title">Thông tin tuyển dụng</h2>

                @if (Model.Deadline.HasValue)
                {
                    <div class="jd-deadline @(deadlineClass == "is-open" ? "" : deadlineClass)">
                        <div class="jd-deadline-top">
                            <small>Hạn nộp hồ sơ</small>
                            <b>@deadlineText</b>
                        </div>

                        @if (isOpen)
                        {
                            <div class="jd-bar"
                                 role="progressbar"
                                 aria-valuemin="0"
                                 aria-valuemax="100"
                                 aria-valuenow="@progress"
                                 aria-label="Tiến độ thời gian nhận hồ sơ">
                                <span style="width:@(progress)%"></span>
                            </div>
                        }

                        <p class="jd-deadline-note">@deadlineStatus</p>
                    </div>
                }

                <dl class="jd-facts">
                    <div>
                        <span class="fi"><svg class="ic" width="16" height="16" aria-hidden="true"><use href="#jd-users" /></svg></span>
                        <div>
                            <dt>Số lượng tuyển</dt>
                            <dd>@Model.Quantity người</dd>
                        </div>
                    </div>

                    <div>
                        <span class="fi"><svg class="ic" width="16" height="16" aria-hidden="true"><use href="#jd-case" /></svg></span>
                        <div>
                            <dt>Ngành nghề</dt>
                            <dd>@categoryName</dd>
                        </div>
                    </div>

                    <div>
                        <span class="fi"><svg class="ic" width="16" height="16" aria-hidden="true"><use href="#jd-cal" /></svg></span>
                        <div>
                            <dt>Ngày đăng</dt>
                            <dd>@Model.CreatedAt.ToString("dd/MM/yyyy")</dd>
                        </div>
                    </div>

                    @if (!Model.Deadline.HasValue)
                    {
                        <div>
                            <span class="fi"><svg class="ic" width="16" height="16" aria-hidden="true"><use href="#jd-clock" /></svg></span>
                            <div>
                                <dt>Hạn nộp hồ sơ</dt>
                                <dd>@deadlineText</dd>
                            </div>
                        </div>
                    }
                </dl>

                <div class="jd-actions">
                    @if (isAlumni)
                    {
                        <a href="@Url.Action("Create", "JobReports", new { area = "", jobPostId = Model.JobPostId })" class="jd-button jd-chat">
                            <svg class="ic" aria-hidden="true"><use href="#jd-flag" /></svg> Báo cáo tin tuyển dụng
                        </a>
                        <a href="@Url.Action("Index", "JobReports", new { area = "" })" class="jd-help">Theo dõi báo cáo của tôi →</a>
                    }

                    @if (!isOpen)
                    {
                        <div class="jd-notice">
                            Tin tuyển dụng hiện không nhận hồ sơ.
                        </div>
                    }
                    else if (!isLoggedIn)
                    {
                        <a href="@loginUrl" class="jd-button jd-apply">
                            <svg class="ic" aria-hidden="true"><use href="#jd-login" /></svg>
                            Đăng nhập để ứng tuyển
                        </a>

                        <p class="jd-help">
                            Đăng nhập bằng tài khoản sinh viên/cựu sinh viên
                            để ứng tuyển và luyện phỏng vấn.
                        </p>
                    }
                    else if (isAlumni)
                    {
                        <a href="@applyUrl" class="jd-button jd-apply">
                            <svg class="ic" aria-hidden="true"><use href="#jd-send" /></svg>
                            Ứng tuyển ngay
                        </a>

                        <div>
                            <a href="@aiUrl" class="jd-button jd-ai">
                                <svg class="ic" aria-hidden="true"><use href="#jd-robot" /></svg>
                                Luyện phỏng vấn với AI
                            </a>

                            <p class="jd-help">
                                Chuẩn bị với 5 câu hỏi theo vị trí này.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="jd-notice">
                            Chức năng ứng tuyển dành cho tài khoản
                            sinh viên/cựu sinh viên.
                        </div>
                    }

                    @if (isAlumni &&
                                        !string.IsNullOrWhiteSpace(companyChatUrl))
                    {
                        <form method="post"
                              action="@companyChatUrl"
                              class="jd-chat-form">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="companyId"
                                   value="@Model.CompanyId" />

                            <input type="hidden"
                                   name="jobPostId"
                                   value="@Model.JobPostId" />

                            <button type="submit"
                                    class="jd-button jd-chat">
                                <svg class="ic" aria-hidden="true"><use href="#jd-chatic" /></svg>
                                Nhắn tin doanh nghiệp
                            </button>
                        </form>
                    }
                </div>
            </aside>
        </div>
    </div>

    @* Thanh ứng tuyển cố định trên di động *@
    @if (isOpen && !isLoggedIn)
    {
        <div class="jd-mobile-cta">
            <a href="@loginUrl" class="jd-button jd-apply">
                <svg class="ic" aria-hidden="true"><use href="#jd-login" /></svg>
                Đăng nhập để ứng tuyển
            </a>
        </div>
    }
    else if (isOpen && isAlumni)
    {
        <div class="jd-mobile-cta">
            <a href="@applyUrl" class="jd-button jd-apply">
                <svg class="ic" aria-hidden="true"><use href="#jd-send" /></svg>
                Ứng tuyển ngay
            </a>
        </div>
    }
</section>

@section Scripts {
    <script>
        (() => {
            const button = document.getElementById("jdShare");
            if (!button) return;

            const label = button.querySelector("span");
            const original = label.textContent;

            button.addEventListener("click", async () => {
                try {
                    await navigator.clipboard.writeText(window.location.href);
                    label.textContent = "Đã sao chép!";
                    button.classList.add("is-done");
                } catch {
                    label.textContent = "Không thể sao chép";
                }

                setTimeout(() => {
                    label.textContent = original;
                    button.classList.remove("is-done");
                }, 1800);
            });
        })();
    </script>
}
