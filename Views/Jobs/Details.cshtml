@using System.Globalization
@model AlumniJobConnect.Models.JobPost

@{
    ViewData["Title"] = Model.Title;

    var culture = CultureInfo.GetCultureInfo("vi-VN");
    var today = DateOnly.FromDateTime(DateTime.UtcNow.AddHours(7));

    var isExpired = Model.Deadline.HasValue
        && Model.Deadline.Value < today;

    var isOpen = Model.ApprovalStatus == "Approved"
        && Model.IsPublished
        && !isExpired;

    var isLoggedIn = User.Identity?.IsAuthenticated == true;
    var isAlumni = isLoggedIn && User.IsInRole("Alumni");

    var categoryName = Model.JobCategory?.CategoryName
        ?? "Ngành nghề khác";

    // Đổi "Apply" nếu action mở form ứng tuyển của bạn tên khác.
    var applyUrl = Url.Action(
     "Create",
     "Applications",
     new
     {
         area = "",
         companyId = Model.CompanyId,
         jobPostId = Model.JobPostId
     });

    var aiUrl = Url.Action(
        "Index",
        "AiInterview",
        new { area = "", jobPostId = Model.JobPostId });

    var detailsUrl = Url.Action(
        "Details",
        "Jobs",
        new { area = "", id = Model.JobPostId });

    var loginUrl = Url.Action(
        "Login",
        "Account",
        new { area = "", returnUrl = detailsUrl });

    var companyChatUrl = Url.RouteUrl("StartCompanyChat");

    var employmentText = Model.EmploymentType switch
    {
        "Full Time" => "Toàn thời gian",
        "Part Time" => "Bán thời gian",
        _ => Model.EmploymentType ?? "Chưa cập nhật"
    };

    var deadlineText = Model.Deadline?.ToString("dd/MM/yyyy")
        ?? "Không quy định";

    var deadlineStatus = "Đang tuyển";
    var deadlineClass = "is-open";

    if (!Model.IsPublished || Model.ApprovalStatus != "Approved")
    {
        deadlineStatus = "Chưa mở tuyển dụng";
        deadlineClass = "is-expired";
    }
    else if (Model.Deadline.HasValue)
    {
        var daysLeft = Model.Deadline.Value.DayNumber - today.DayNumber;

        if (daysLeft < 0)
        {
            deadlineStatus = "Đã hết hạn";
            deadlineClass = "is-expired";
        }
        else if (daysLeft == 0)
        {
            deadlineStatus = "Hết hạn hôm nay";
            deadlineClass = "is-soon";
        }
        else
        {
            deadlineStatus = $"Còn {daysLeft} ngày";
            deadlineClass = daysLeft <= 7 ? "is-soon" : "is-open";
        }
    }

    string GetSalary()
    {
        var currency = string.IsNullOrWhiteSpace(Model.CurrencyCode)
            ? "VND"
            : Model.CurrencyCode;

        if (Model.SalaryMin.HasValue && Model.SalaryMax.HasValue)
        {
            return $"{Model.SalaryMin.Value.ToString("N0", culture)}"
                + $" – {Model.SalaryMax.Value.ToString("N0", culture)} {currency}";
        }

        if (Model.SalaryMin.HasValue)
        {
            return $"Từ {Model.SalaryMin.Value.ToString("N0", culture)} {currency}";
        }

        if (Model.SalaryMax.HasValue)
        {
            return $"Đến {Model.SalaryMax.Value.ToString("N0", culture)} {currency}";
        }

        return "Thỏa thuận";
    }
}

<style>
    .job-detail-page {
        padding: 36px 0 80px;
        background: #f4f9f6;
        color: #203b32;
        font-family: "Segoe UI", Arial, sans-serif;
    }

        .job-detail-page * {
            box-sizing: border-box;
        }

    .jd-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 20px;
        padding: 9px 15px;
        border: 1px solid #dcebe2;
        border-radius: 999px;
        background: #fff;
        color: #008859;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
    }

        .jd-back:hover {
            background: #eaf8f0;
            color: #006b48;
            text-decoration: none;
        }

    .jd-header,
    .jd-box {
        border: 1px solid #e1ebe5;
        border-radius: 20px;
        background: #fff;
        box-shadow: 0 10px 30px rgba(25, 57, 44, .05);
    }

    .jd-header {
        position: relative;
        overflow: hidden;
        margin-bottom: 24px;
        padding: 34px;
    }

        .jd-header::before {
            content: "";
            position: absolute;
            inset: 0 0 auto;
            height: 5px;
            background: linear-gradient(90deg, #009565, #3ccf91);
        }

    .jd-tags {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .jd-category,
    .jd-status {
        display: inline-block;
        padding: 7px 13px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
    }

    .jd-category {
        background: #eaf8f0;
        color: #008859;
    }

    .jd-status.is-open {
        background: #e6f6ee;
        color: #0b6b47;
    }

    .jd-status.is-soon {
        background: #fff3dc;
        color: #956000;
    }

    .jd-status.is-expired {
        background: #fde8e6;
        color: #b42318;
    }

    .job-detail-page h1 {
        margin: 20px 0 12px;
        color: #1f3a2c;
        font-family: inherit;
        font-size: clamp(26px, 3vw, 36px);
        font-weight: 750;
        line-height: 1.4;
        overflow-wrap: anywhere;
    }

    .jd-company {
        margin: 0 0 25px;
        color: #61776b;
        font-size: 15px;
    }

    .jd-summary {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        padding-top: 25px;
        border-top: 1px solid #edf2ef;
    }

    .jd-summary-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 16px;
        border: 1px solid #e5eee8;
        border-radius: 14px;
        background: #f8fbf9;
    }

    .jd-summary-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: #009b72;
        color: #fff;
        font-size: 17px;
    }

    .jd-summary-label {
        display: block;
        margin-bottom: 6px;
        color: #71837c;
        font-size: 12px;
    }

    .jd-summary-item strong {
        color: #234733;
        font-size: 15px;
        line-height: 1.6;
        overflow-wrap: anywhere;
    }

    .jd-salary {
        color: #008859 !important;
    }

    .jd-grid {
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(300px, 1fr);
        align-items: start;
        gap: 24px;
    }

    .jd-box {
        padding: 30px;
    }

    .jd-block + .jd-block {
        margin-top: 28px;
        padding-top: 28px;
        border-top: 1px dashed #e0eae4;
    }

    .job-detail-page .jd-title {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 0 0 18px;
        color: #243e31;
        font-family: inherit;
        font-size: 20px;
        font-weight: 700;
    }

    .jd-title::before {
        content: "";
        flex-shrink: 0;
        width: 5px;
        height: 23px;
        border-radius: 4px;
        background: #00a36c;
    }

    .jd-text {
        color: #55695c;
        font-size: 15px;
        line-height: 1.9;
        white-space: pre-line;
        overflow-wrap: anywhere;
    }

    .jd-facts {
        margin: 0;
    }

        .jd-facts > div {
            padding: 17px 0;
            border-bottom: 1px solid #edf2ef;
        }

            .jd-facts > div:last-child {
                border-bottom: 0;
            }

        .jd-facts dt {
            display: flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 7px;
            color: #71837c;
            font-size: 13px;
            font-weight: 400;
        }

            .jd-facts dt i {
                width: 17px;
                color: #00a36c;
                text-align: center;
            }

        .jd-facts dd {
            margin: 0 0 0 26px;
            color: #344f3e;
            font-size: 14px;
            font-weight: 600;
            line-height: 1.7;
            overflow-wrap: anywhere;
        }

    .jd-actions {
        display: grid;
        gap: 12px;
        margin-top: 20px;
        padding-top: 23px;
        border-top: 1px solid #e1ebe5;
    }

    .jd-button {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        width: 100%;
        min-height: 49px;
        padding: 13px 15px;
        border: 1px solid transparent;
        border-radius: 12px;
        font: inherit;
        font-size: 14px;
        font-weight: 650;
        line-height: 1.5;
        text-align: center;
        text-decoration: none;
        cursor: pointer;
        transition: background .2s;
    }

        .jd-button:hover {
            text-decoration: none;
        }

    .jd-apply {
        background: #009b72;
        color: #fff;
    }

        .jd-apply:hover {
            background: #007e5d;
            color: #fff;
        }

    .jd-ai {
        border-color: #b9dfce;
        background: #effaf5;
        color: #00835f;
    }

        .jd-ai:hover {
            background: #dff3e8;
            color: #006b4d;
        }

    .jd-chat {
        border-color: #dce7e2;
        background: #fff;
        color: #466354;
    }

        .jd-chat:hover {
            background: #f3f8f5;
            color: #234733;
        }

    .jd-chat-form {
        margin: 0;
    }

    .jd-help {
        margin: 8px 0 0;
        color: #71837c;
        font-size: 12px;
        line-height: 1.7;
        text-align: center;
    }

    .jd-notice {
        padding: 13px 15px;
        border: 1px solid #eadfbd;
        border-radius: 11px;
        background: #fff9ec;
        color: #886721;
        font-size: 13px;
        line-height: 1.8;
    }

    @@media (max-width: 991.98px) {
        .jd-grid {
            grid-template-columns: 1fr;
        }

        .jd-summary {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 575.98px) {
        .job-detail-page {
            padding: 24px 0 100px;
        }

        .jd-header,
        .jd-box {
            padding: 24px 20px;
            border-radius: 16px;
        }
    }
</style>

<section class="job-detail-page">
    <div class="container">
        <a href="@Url.Action("Jobs", "Home",
                                           new { area = "", categoryId = Model.JobCategoryId })"
           class="jd-back">
            ← Xem việc làm cùng ngành
        </a>

        <header class="jd-header">
            <div class="jd-tags">
                <span class="jd-category">@categoryName</span>

                <span class="jd-status @deadlineClass">
                    @deadlineStatus
                </span>
            </div>

            <h1>@Model.Title</h1>

            @if (!string.IsNullOrWhiteSpace(Model.Company?.CompanyName))
            {
                <p class="jd-company">
                    <i class="far fa-building" aria-hidden="true"></i>
                    @Model.Company.CompanyName
                </p>
            }

            <div class="jd-summary">
                <div class="jd-summary-item">
                    <span class="jd-summary-icon">
                        <i class="fas fa-money-bill-wave"
                           aria-hidden="true"></i>
                    </span>
                    <div>
                        <span class="jd-summary-label">Mức lương</span>
                        <strong class="jd-salary">@GetSalary()</strong>
                    </div>
                </div>

                <div class="jd-summary-item">
                    <span class="jd-summary-icon">
                        <i class="fas fa-map-marker-alt"
                           aria-hidden="true"></i>
                    </span>
                    <div>
                        <span class="jd-summary-label">
                            Địa điểm làm việc
                        </span>
                        <strong>
                            @(string.IsNullOrWhiteSpace(Model.WorkLocation)
                                                        ? "Chưa cập nhật"
                                                        : Model.WorkLocation)
                        </strong>
                    </div>
                </div>

                <div class="jd-summary-item">
                    <span class="jd-summary-icon">
                        <i class="far fa-clock" aria-hidden="true"></i>
                    </span>
                    <div>
                        <span class="jd-summary-label">
                            Hình thức làm việc
                        </span>
                        <strong>@employmentText</strong>
                    </div>
                </div>
            </div>
        </header>

        <div class="jd-grid">
            <article class="jd-box">
                <section class="jd-block">
                    <h2 class="jd-title">Mô tả công việc</h2>
                    <div class="jd-text">@Model.JobDescription</div>
                </section>

                <section class="jd-block">
                    <h2 class="jd-title">Yêu cầu ứng viên</h2>
                    <div class="jd-text">
                        @(string.IsNullOrWhiteSpace(Model.Requirements)
                                                ? "Doanh nghiệp chưa cập nhật yêu cầu."
                                                : Model.Requirements)
                    </div>
                </section>

                <section class="jd-block">
                    <h2 class="jd-title">Quyền lợi</h2>
                    <div class="jd-text">
                        @(string.IsNullOrWhiteSpace(Model.Benefits)
                                                ? "Doanh nghiệp chưa cập nhật quyền lợi."
                                                : Model.Benefits)
                    </div>
                </section>
            </article>

            <aside class="jd-box">
                <h2 class="jd-title">Thông tin tuyển dụng</h2>

                <dl class="jd-facts">
                    <div>
                        <dt>
                            <i class="fas fa-users" aria-hidden="true"></i>
                            Số lượng tuyển
                        </dt>
                        <dd>@Model.Quantity người</dd>
                    </div>

                    <div>
                        <dt>
                            <i class="fas fa-briefcase" aria-hidden="true"></i>
                            Ngành nghề
                        </dt>
                        <dd>@categoryName</dd>
                    </div>

                    <div>
                        <dt>
                            <i class="far fa-calendar-alt" aria-hidden="true"></i>
                            Ngày đăng
                        </dt>
                        <dd>@Model.CreatedAt.ToString("dd/MM/yyyy")</dd>
                    </div>

                    <div>
                        <dt>
                            <i class="far fa-clock" aria-hidden="true"></i>
                            Hạn nộp hồ sơ
                        </dt>
                        <dd>@deadlineText</dd>
                    </div>
                </dl>

                <div class="jd-actions">
                    @if (isAlumni)
                    {
                        <a href="@Url.Action("Create", "JobReports", new { area = "", jobPostId = Model.JobPostId })" class="jd-button jd-chat">
                            <i class="fas fa-flag" aria-hidden="true"></i> Báo cáo tin tuyển dụng
                        </a>
                        <a href="@Url.Action("Index", "JobReports", new { area = "" })" class="jd-help">Theo dõi báo cáo của tôi →</a>
                    }

                    @if (!isOpen)
                    {
                        <div class="jd-notice">
                            Tin tuyển dụng hiện không nhận hồ sơ.
                        </div>
                    }
                    else if (!isLoggedIn)
                    {
                        <a href="@loginUrl" class="jd-button jd-apply">
                            Đăng nhập để ứng tuyển
                        </a>

                        <p class="jd-help">
                            Đăng nhập bằng tài khoản sinh viên/cựu sinh viên
                            để ứng tuyển và luyện phỏng vấn.
                        </p>
                    }
                    else if (isAlumni)
                    {
                        <a href="@applyUrl" class="jd-button jd-apply">
                            <i class="fas fa-paper-plane"
                               aria-hidden="true"></i>
                            Ứng tuyển ngay
                        </a>

                        <div>
                            <a href="@aiUrl" class="jd-button jd-ai">
                                <i class="fas fa-robot"
                                   aria-hidden="true"></i>
                                Luyện phỏng vấn với AI
                            </a>

                            <p class="jd-help">
                                Chuẩn bị với 5 câu hỏi theo vị trí này.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="jd-notice">
                            Chức năng ứng tuyển dành cho tài khoản
                            sinh viên/cựu sinh viên.
                        </div>
                    }

                    @if (isAlumni &&
                                        !string.IsNullOrWhiteSpace(companyChatUrl))
                    {
                        <form method="post"
                              action="@companyChatUrl"
                              class="jd-chat-form">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="companyId"
                                   value="@Model.CompanyId" />

                            <input type="hidden"
                                   name="jobPostId"
                                   value="@Model.JobPostId" />

                            <button type="submit"
                                    class="jd-button jd-chat">
                                <i class="fas fa-comments"
                                   aria-hidden="true"></i>
                                Nhắn tin doanh nghiệp
                            </button>
                        </form>
                    }
                </div>
            </aside>
        </div>
    </div>
</section>