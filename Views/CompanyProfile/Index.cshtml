@using System.Linq
@model IEnumerable<AlumniJobConnect.Models.Company>

@{
    ViewData["Title"] = "Khám phá doanh nghiệp";

    var companies = Model.ToList();
    var totalCount = companies.Count;
    var verifiedCount = companies.Count(c => string.Equals(
        c.VerificationStatus, "Verified", StringComparison.OrdinalIgnoreCase));
    var keyword = (string?)ViewBag.Keyword;
    var hasKeyword = !string.IsNullOrWhiteSpace(keyword);
}

<section class="company-page">

    <!-- ============ HERO ============ -->
    <header class="company-hero">
        <div class="company-hero-glow company-hero-glow-1" aria-hidden="true"></div>
        <div class="company-hero-glow company-hero-glow-2" aria-hidden="true"></div>

        <div class="container company-hero-inner">
            <div class="company-hero-text">
                <span class="company-eyebrow">
                    <span class="company-eyebrow-dot" aria-hidden="true"></span>
                    KẾT NỐI CƠ HỘI NGHỀ NGHIỆP
                </span>

                <h1>
                    Khám phá <em>doanh nghiệp</em><br />
                    đồng hành cùng cựu sinh viên
                </h1>

                <p>
                    Tìm hiểu doanh nghiệp, lĩnh vực hoạt động
                    và môi trường làm việc phù hợp với bạn.
                </p>

                @if (User.IsInRole("Employer"))
                {
                    <a href="@Url.Action("MyProfile", "CompanyProfile")"
                       class="company-my-profile">
                        <span>Hồ sơ doanh nghiệp của tôi</span>
                        <span aria-hidden="true">→</span>
                    </a>
                }
            </div>

            <div class="company-stats" aria-label="Thống kê nhanh">
                <div class="company-stat">
                    <strong>@totalCount</strong>
                    <span>Doanh nghiệp</span>
                </div>
                <div class="company-stat">
                    <strong>@verifiedCount</strong>
                    <span>Đã xác minh</span>
                </div>
            </div>
        </div>
    </header>

    <div class="container company-body">

        <!-- ============ SEARCH ============ -->
        <form action="@Url.Action("Index", "CompanyProfile")"
              method="get"
              class="company-search"
              role="search">

            <label class="company-search-field">
                <svg class="company-search-icon" viewBox="0 0 24 24"
                     width="22" height="22" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" />
                    <path d="m20 20-3.5-3.5" />
                </svg>

                <input type="search"
                       name="keyword"
                       value="@keyword"
                       aria-label="Tìm doanh nghiệp"
                       placeholder="Tên doanh nghiệp, lĩnh vực hoặc địa chỉ..." />
            </label>

            <button type="submit">Tìm kiếm</button>
        </form>

        <div class="company-results">
            <span>
                @if (hasKeyword)
                {
                    <text>Kết quả cho “<b>@keyword</b>”: </text>
                }
                Tìm thấy <strong>@totalCount</strong> doanh nghiệp
            </span>

            @if (hasKeyword)
            {
                <a href="@Url.Action("Index", "CompanyProfile")" class="company-clear">
                    <span aria-hidden="true">✕</span> Xóa tìm kiếm
                </a>
            }
        </div>

        <!-- ============ GRID ============ -->
        <div class="company-grid">
            @for (var i = 0; i < companies.Count; i++)
            {
                var item = companies[i];
                var isVerified = string.Equals(
                item.VerificationStatus, "Verified",
                StringComparison.OrdinalIgnoreCase);
                var initial = string.IsNullOrWhiteSpace(item.CompanyName)
                ? "DN"
                : item.CompanyName.Trim().Substring(0, 1).ToUpperInvariant();

                <article class="company-card accent-@(i % 4)"
                         style="--i:@(i % 12)">

                    <div class="company-card-banner" aria-hidden="true"></div>

                    <div class="company-card-top">
                        <div class="company-symbol" aria-hidden="true">@initial</div>

                        @if (isVerified)
                        {
                            <span class="company-badge">
                                <svg viewBox="0 0 24 24" width="13" height="13" fill="none"
                                     stroke="currentColor" stroke-width="3"
                                     stroke-linecap="round" stroke-linejoin="round"
                                     aria-hidden="true">
                                    <path d="m5 12.5 4.5 4.5L19 7.5" />
                                </svg>
                                Đã xác minh
                            </span>
                        }
                </div>

                <h2>@item.CompanyName</h2>

                <p class="company-industry">
                    @(string.IsNullOrWhiteSpace(item.Industry)
                                        ? "Chưa cập nhật lĩnh vực"
                                        : item.Industry)
                                                    </p>

                <p class="company-description">
                    @(string.IsNullOrWhiteSpace(item.Description)
                                        ? "Doanh nghiệp chưa cập nhật giới thiệu."
                                        : item.Description)
                                                       </p>

                <div class="company-address">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round"
                         aria-hidden="true">
                        <path d="M12 21s7-6.1 7-11.5A7 7 0 0 0 5 9.5C5 14.9 12 21 12 21Z" />
                        <circle cx="12" cy="9.5" r="2.5" />
                    </svg>
                    <span>
                        <span class="company-address-label">Địa chỉ</span>
                        @(string.IsNullOrWhiteSpace(item.Address)
                                                ? "Chưa cập nhật"
                                                : item.Address)
                    </span>
                </div>

                <a href="@Url.Action("Details", "CompanyProfile",
                                                    new { id = item.CompanyId })"
                   class="company-view">
                    <span>Xem hồ sơ doanh nghiệp</span>
                    <span class="company-view-arrow" aria-hidden="true">→</span>
                </a>
            </article>
                        }
        </div>

        @if (!companies.Any())
        {
            <div class="company-empty">
                <div class="company-empty-symbol" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="30" height="30" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <circle cx="11" cy="11" r="7" />
                        <path d="m20 20-3.5-3.5" />
                    </svg>
                </div>

                <h2>Chưa tìm thấy doanh nghiệp</h2>

                <p>
                    Thử tìm bằng tên, lĩnh vực hoặc địa chỉ khác.
                    Nếu chưa có doanh nghiệp, danh sách sẽ xuất hiện
                    khi tài khoản doanh nghiệp được tạo.
                </p>

                <a href="@Url.Action("Index", "CompanyProfile")"
                   class="company-empty-link">
                    Xem tất cả doanh nghiệp
                </a>
            </div>
        }
    </div>
</section>

<style>
    .company-page {
        --c-ink: #12362a;
        --c-muted: #6b8479;
        --c-brand: #009f6b;
        --c-brand-dark: #00734d;
        --c-soft: #eaf8f0;
        --c-line: #dcebe2;
        padding-bottom: 72px;
        background: #f4faf7;
        font-family: "Segoe UI", system-ui, Arial, sans-serif;
    }

        .company-page * {
            box-sizing: border-box;
        }

    /* ---------- HERO ---------- */
    .company-hero {
        position: relative;
        overflow: hidden;
        padding: 64px 0 112px;
        color: #fff;
        background: radial-gradient(circle at 1px 1px, rgb(255 255 255 / 10%) 1px, transparent 0) 0 0 / 22px 22px, linear-gradient(135deg, #0b3d2c 0%, #087a55 55%, #19b383 100%);
    }

    .company-hero-glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(70px);
        pointer-events: none;
    }

    .company-hero-glow-1 {
        top: -120px;
        right: -80px;
        width: 380px;
        height: 380px;
        background: rgb(255 214 102 / 35%);
    }

    .company-hero-glow-2 {
        bottom: -160px;
        left: -100px;
        width: 360px;
        height: 360px;
        background: rgb(120 255 205 / 25%);
    }

    .company-hero-inner {
        position: relative;
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 36px;
    }

    .company-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 7px 14px;
        color: #d8fff0;
        background: rgb(255 255 255 / 12%);
        border: 1px solid rgb(255 255 255 / 22%);
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.6px;
        backdrop-filter: blur(6px);
    }

    .company-eyebrow-dot {
        width: 8px;
        height: 8px;
        background: #ffd666;
        border-radius: 50%;
        box-shadow: 0 0 0 4px rgb(255 214 102 / 25%);
    }

    .company-hero h1 {
        margin: 20px 0 16px;
        color: #fff;
        font-family: inherit;
        font-size: clamp(30px, 4.6vw, 52px);
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: -0.5px;
    }

        .company-hero h1 em {
            color: #ffd666;
            font-style: normal;
            background: linear-gradient(transparent 82%, rgb(255 214 102 / 35%) 82%);
        }

    .company-hero p {
        max-width: 560px;
        margin: 0;
        color: #d3f1e4;
        font-size: 16px;
        line-height: 1.8;
    }

    .company-my-profile {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-top: 26px;
        padding: 13px 22px;
        color: #0b3d2c;
        background: #fff;
        border-radius: 999px;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        box-shadow: 0 10px 24px rgb(0 0 0 / 18%);
        transition: transform .2s, box-shadow .2s;
    }

        .company-my-profile:hover {
            color: #0b3d2c;
            transform: translateY(-2px);
            box-shadow: 0 14px 30px rgb(0 0 0 / 24%);
        }

    .company-stats {
        display: flex;
        gap: 14px;
    }

    .company-stat {
        min-width: 130px;
        padding: 18px 22px;
        background: rgb(255 255 255 / 12%);
        border: 1px solid rgb(255 255 255 / 22%);
        border-radius: 18px;
        backdrop-filter: blur(8px);
    }

        .company-stat strong {
            display: block;
            font-size: 34px;
            font-weight: 800;
            line-height: 1.1;
        }

        .company-stat span {
            color: #c7efdd;
            font-size: 12px;
            letter-spacing: .4px;
        }

    /* ---------- SEARCH ---------- */
    .company-body {
        position: relative;
        margin-top: -44px;
    }

    .company-search {
        display: flex;
        gap: 12px;
        padding: 10px;
        background: #fff;
        border: 1px solid var(--c-line);
        border-radius: 999px;
        box-shadow: 0 18px 44px rgb(11 61 44 / 14%);
    }

    .company-search-field {
        display: flex;
        flex: 1;
        align-items: center;
        gap: 12px;
        min-width: 0;
        margin: 0;
        padding: 0 20px;
        border-radius: 999px;
    }

    .company-search-icon {
        flex: none;
        color: var(--c-brand);
    }

    .company-search input {
        width: 100%;
        min-width: 0;
        padding: 14px 0;
        color: #1f4535;
        background: transparent;
        border: none;
        font-family: inherit;
        font-size: 15px;
    }

        .company-search input:focus {
            outline: none;
        }

    .company-search-field:focus-within {
        outline: 2px solid #00a36c;
        outline-offset: 0;
    }

    .company-search button {
        padding: 13px 32px;
        color: #fff;
        background: linear-gradient(135deg, #00b27a, #008c60);
        border: none;
        border-radius: 999px;
        font-family: inherit;
        font-weight: 700;
        cursor: pointer;
        transition: transform .2s, box-shadow .2s;
    }

        .company-search button:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 18px rgb(0 159 107 / 35%);
        }

    /* ---------- RESULTS BAR ---------- */
    .company-results {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin: 30px 4px 22px;
        color: var(--c-muted);
        font-size: 14px;
    }

        .company-results strong,
        .company-results b {
            color: var(--c-brand-dark);
        }

    .company-clear {
        padding: 6px 14px;
        color: var(--c-brand-dark);
        background: #fff;
        border: 1px solid var(--c-line);
        border-radius: 999px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
    }

        .company-clear:hover {
            background: var(--c-soft);
        }

    /* ---------- GRID & CARD ---------- */
    .company-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 26px;
    }

    .company-card {
        --a1: #00b27a;
        --a2: #7be0b6;
        --a-soft: #e6f8ef;
        --a-ink: #007a52;
        position: relative;
        display: flex;
        flex-direction: column;
        min-width: 0;
        overflow: hidden;
        padding: 0 26px 26px;
        background: #fff;
        border: 1px solid #e0ede5;
        border-radius: 24px;
        box-shadow: 0 6px 22px rgb(28 72 49 / 5%);
        opacity: 0;
        animation: company-rise .55s cubic-bezier(.2, .7, .2, 1) forwards;
        animation-delay: calc(var(--i) * 60ms);
        transition: transform .25s, box-shadow .25s, border-color .25s;
    }

        .company-card.accent-1 {
            --a1: #2f9bd6;
            --a2: #9fd8f5;
            --a-soft: #e7f4fc;
            --a-ink: #16739f;
        }

        .company-card.accent-2 {
            --a1: #f0a516;
            --a2: #ffe08a;
            --a-soft: #fff4d9;
            --a-ink: #a56b00;
        }

        .company-card.accent-3 {
            --a1: #8a63d2;
            --a2: #cdb8f3;
            --a-soft: #f0eafb;
            --a-ink: #5f3da5;
        }

        .company-card:hover {
            transform: translateY(-6px);
            border-color: var(--a2);
            box-shadow: 0 22px 44px rgb(28 72 49 / 13%);
        }

    .company-card-banner {
        height: 86px;
        margin: 0 -26px;
        background: radial-gradient(circle at 1px 1px, rgb(255 255 255 / 30%) 1px, transparent 0) 0 0 / 14px 14px, linear-gradient(120deg, var(--a1), var(--a2));
    }

    .company-card-top {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 12px;
        margin-top: -36px;
        margin-bottom: 18px;
    }

    .company-symbol {
        display: grid;
        place-items: center;
        flex: none;
        width: 72px;
        height: 72px;
        color: var(--a-ink);
        background: #fff;
        border: 4px solid #fff;
        border-radius: 22px;
        box-shadow: 0 8px 20px rgb(28 72 49 / 15%), inset 0 0 0 2px var(--a-soft);
        font-size: 30px;
        font-weight: 800;
    }

    .company-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 4px;
        padding: 6px 11px;
        color: #006f4a;
        background: #eaf8f0;
        border: 1px solid #c8ebd9;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
    }

    .company-card h2 {
        margin: 0 0 10px;
        color: var(--c-ink);
        font-family: inherit;
        font-size: 21px;
        font-weight: 800;
        line-height: 1.35;
        overflow-wrap: anywhere;
    }

    .company-industry {
        align-self: flex-start;
        margin: 0 0 16px;
        padding: 4px 12px;
        color: var(--a-ink);
        background: var(--a-soft);
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        line-height: 1.6;
        overflow-wrap: anywhere;
    }

    .company-description {
        display: -webkit-box;
        overflow: hidden;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        margin: 0 0 22px;
        color: #5c746a;
        font-size: 14px;
        line-height: 1.8;
        overflow-wrap: anywhere;
    }

    .company-address {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-top: auto;
        margin-bottom: 22px;
        padding-top: 18px;
        color: #476158;
        border-top: 1px dashed #d6e6dc;
        font-size: 13px;
        line-height: 1.7;
        overflow-wrap: anywhere;
    }

        .company-address svg {
            flex: none;
            margin-top: 3px;
            color: var(--a1);
        }

    .company-address-label {
        display: block;
        color: #7b9288;
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: .8px;
        text-transform: uppercase;
    }

    .company-view {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 13px 18px;
        color: var(--a-ink);
        background: var(--a-soft);
        border-radius: 14px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        transition: background .2s, color .2s;
    }

    .company-view-arrow {
        display: inline-block;
        transition: transform .25s;
    }

    .company-view:hover {
        color: #fff;
        background: var(--a1);
    }

        .company-view:hover .company-view-arrow {
            transform: translateX(5px);
        }

    /* ---------- EMPTY ---------- */
    .company-empty {
        padding: 60px 24px;
        background: #fff;
        border: 2px dashed #c6dccf;
        border-radius: 24px;
        text-align: center;
    }

    .company-empty-symbol {
        display: grid;
        place-items: center;
        width: 76px;
        height: 76px;
        margin: 0 auto 20px;
        color: var(--c-brand);
        background: linear-gradient(135deg, #e4f7ed, #c9eddb);
        border-radius: 50%;
    }

    .company-empty h2 {
        color: var(--c-ink);
        font-family: inherit;
        font-size: 24px;
        font-weight: 800;
    }

    .company-empty p {
        max-width: 480px;
        margin: 14px auto 24px;
        color: var(--c-muted);
        font-size: 14px;
        line-height: 1.8;
    }

    .company-empty-link {
        display: inline-block;
        padding: 12px 24px;
        color: #fff;
        background: var(--c-brand);
        border-radius: 999px;
        font-weight: 700;
        text-decoration: none;
    }

        .company-empty-link:hover {
            color: #fff;
            background: var(--c-brand-dark);
        }

    /* ---------- FOCUS & MOTION ---------- */
    .company-page a:focus-visible,
    .company-search button:focus-visible {
        outline: 3px solid #82cfac;
        outline-offset: 3px;
    }

    @@keyframes company-rise {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ---------- RESPONSIVE ---------- */
    @@media (max-width: 991.98px) {
        .company-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 575.98px) {
        .company-hero {
            padding: 44px 0 92px;
        }

        .company-grid {
            grid-template-columns: 1fr;
        }

        .company-stats {
            width: 100%;
        }

        .company-stat {
            flex: 1;
            min-width: 0;
        }

        .company-search {
            flex-direction: column;
            border-radius: 24px;
        }

            .company-search button {
                width: 100%;
            }

        .company-card {
            padding: 0 22px 22px;
        }

        .company-card-banner {
            margin: 0 -22px;
        }

        .company-my-profile {
            width: 100%;
            justify-content: center;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .company-card {
            opacity: 1;
            animation: none;
            transition: none;
        }

            .company-card:hover {
                transform: none;
            }

        .company-view-arrow,
        .company-my-profile,
        .company-search button {
            transition: none;
        }
    }
</style>
