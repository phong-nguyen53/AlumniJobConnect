<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8">
    <title>@ViewData["Title"] - AlumniJobConnect</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="cựu sinh viên, việc làm, cố vấn, kết nối doanh nghiệp" name="keywords">
    <meta content="AlumniJobConnect - Nền tảng kết nối cựu sinh viên, doanh nghiệp và cơ hội việc làm." name="description">
    <meta name="theme-color" content="#00b074">

    <!-- Favicon -->
    <link href="~/assets/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600&family=Inter:wght@700;800&display=swap" rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="~/assets/lib/animate/animate.min.css" rel="stylesheet">
    <link href="~/assets/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="~/assets/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="~/assets/css/style.css" rel="stylesheet">

    <!-- Layout enhancements -->
    <style>
        html {
            scroll-behavior: smooth;
        }

        body {
            -webkit-font-smoothing: antialiased;
            text-rendering: optimizeLegibility;
        }

        /* Footer */
        .site-footer {
            background: linear-gradient(180deg, #14232a 0%, #0e1a20 100%);
        }

            .site-footer h5 {
                position: relative;
                padding-bottom: .75rem;
                font-weight: 700;
            }

                .site-footer h5::after {
                    content: "";
                    position: absolute;
                    left: 0;
                    bottom: 0;
                    width: 36px;
                    height: 3px;
                    border-radius: 3px;
                    background: #00b074;
                }

            .site-footer .footer-brand {
                font-family: 'Inter', sans-serif;
                font-size: 1.5rem;
                font-weight: 800;
                color: #fff;
                text-decoration: none;
            }

                .site-footer .footer-brand span {
                    color: #00b074;
                }

            .site-footer .btn.btn-link {
                display: block;
                padding: .3rem 0;
                text-align: left;
                transition: color .2s ease, padding-left .2s ease;
            }

                .site-footer .btn.btn-link::before {
                    content: "›";
                    margin-right: .5rem;
                    color: #00b074;
                }

                .site-footer .btn.btn-link:hover {
                    padding-left: .35rem;
                    color: #fff !important;
                    letter-spacing: 0;
                }

            .site-footer .contact-line i {
                width: 22px;
                color: #00b074;
            }

            .site-footer .btn-social {
                transition: transform .2s ease, background .2s ease, border-color .2s ease;
            }

                .site-footer .btn-social:hover {
                    transform: translateY(-3px);
                    background: #00b074;
                    border-color: #00b074;
                }

            .site-footer .newsletter-box .form-control {
                height: 52px;
                border-radius: 50rem;
                color: #fff;
                border-color: rgba(255, 255, 255, .25);
            }

                .site-footer .newsletter-box .form-control:focus {
                    border-color: #00b074;
                    box-shadow: 0 0 0 .2rem rgba(0, 176, 116, .2);
                }

            .site-footer .newsletter-box .btn {
                border-radius: 50rem;
            }

            .site-footer .copyright {
                border-top: 1px solid rgba(255, 255, 255, .1);
            }

        /* Back to top */
        .back-to-top {
            border-radius: 50%;
            box-shadow: 0 8px 20px rgba(0, 176, 116, .35);
        }

        /* Nút tin nhắn tư vấn */
        .mentor-inbox {
            position: fixed;
            bottom: 90px;
            right: 24px;
            z-index: 1050;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 14px 20px;
            color: #fff;
            font-weight: 600;
            text-decoration: none;
            background: linear-gradient(135deg, #00b074, #008f68);
            border-radius: 30px;
            box-shadow: 0 10px 26px rgba(0, 143, 104, .4);
            transition: transform .2s ease, box-shadow .2s ease;
        }

            .mentor-inbox:hover,
            .mentor-inbox:focus-visible {
                color: #fff;
                transform: translateY(-3px);
                box-shadow: 0 14px 32px rgba(0, 143, 104, .5);
            }

            .mentor-inbox .mentor-badge {
                min-width: 24px;
                padding: 2px 8px;
                font-size: .8rem;
                text-align: center;
                color: #fff;
                background: #dc3545;
                border-radius: 20px;
            }

                .mentor-inbox .mentor-badge[hidden] {
                    display: none;
                }

        .visually-hidden-live {
            position: fixed;
            width: 1px;
            height: 1px;
            overflow: hidden;
            clip-path: inset(50%);
        }

        @@media (max-width: 575.98px) {
            .mentor-inbox {
                right: 14px;
                bottom: 80px;
                padding: 12px 16px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            html {
                scroll-behavior: auto;
            }

            .mentor-inbox,
            .site-footer .btn-social,
            .site-footer .btn.btn-link {
                transition: none;
            }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="container-xxl bg-white p-0">
        <!-- Spinner Start -->
        <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                <span class="visually-hidden">Đang tải...</span>
            </div>
        </div>
        <!-- Spinner End -->
        <!-- Navbar Start -->
        <header class="ac-header">
            <div class="ac-header-inner">

                <a href="@Url.Content("~/")" class="ac-brand">
                    <span class="ac-brand-icon" aria-hidden="true">
                        <svg width="26" height="26"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8">
                            <path d="M3 9 12 4l9 5-9 5-9-5Z" />
                            <path d="M6 11v6c4 3 8 3 12 0v-6M21 9v7" />
                        </svg>
                    </span>

                    <span class="ac-brand-name">
                        Alumni<span>JobConnect</span>
                        <small>KẾT NỐI CỰU SINH VIÊN & CƠ HỘI</small>
                    </span>
                </a>

                <nav class="ac-navigation" aria-label="Điều hướng chính">
                    @await Component.InvokeAsync("MenuTop")
                </nav>

            </div>
        </header>
        <!-- Navbar End -->
        @RenderBody()
        <!-- Footer Start -->
        <footer class="container-fluid site-footer text-white-50 footer pt-5 mt-5 wow fadeIn" data-wow-delay="0.1s">
            <div class="container py-5">
                <div class="row g-5">
                    <div class="col-lg-3 col-md-6">
                        <a class="footer-brand d-inline-block mb-3" href="@Url.Content("~/")">Alumni<span>JobConnect</span></a>
                        <p class="mb-4">
                            Nền tảng kết nối cựu sinh viên, doanh nghiệp và cơ hội việc làm –
                            cùng nhau xây dựng cộng đồng vững mạnh.
                        </p>
                        <div class="d-flex pt-1">
                            <a class="btn btn-outline-light btn-social" href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                            <a class="btn btn-outline-light btn-social" href="#" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                            <a class="btn btn-outline-light btn-social" href="#" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
                            <a class="btn btn-outline-light btn-social" href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <h5 class="text-white mb-4">Khám phá</h5>
                        <a class="btn btn-link text-white-50" href="@Url.Action("jobs", "Home")">Việc làm</a>
                        <a class="btn btn-link text-white-50" href="/Companies">Doanh nghiệp</a>
                        <a class="btn btn-link text-white-50" href="/Alumni">Cựu sinh viên</a>
                        <a class="btn btn-link text-white-50" href="/Events">Sự kiện</a>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <h5 class="text-white mb-4">Liên hệ</h5>
                        <p class="mb-2 contact-line"><i class="fa fa-map-marker-alt me-2"></i>123 Đường Mẫu, Thành phố, Việt Nam</p>
                        <p class="mb-2 contact-line"><i class="fa fa-phone-alt me-2"></i>+84 123 456 789</p>
                        <p class="mb-2 contact-line"><i class="fa fa-envelope me-2"></i>info@example.com</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <h5 class="text-white mb-4">Nhận tin mới</h5>
                        <p>Đăng ký để nhận thông tin việc làm và sự kiện mới nhất.</p>
                        <div class="newsletter-box position-relative mx-auto" style="max-width: 400px;">
                            <input class="form-control bg-transparent w-100 py-3 ps-4 pe-5" type="email" placeholder="Email của bạn" aria-label="Email của bạn">
                            <button type="button" class="btn btn-primary py-2 position-absolute top-0 end-0 mt-2 me-2">Đăng ký</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="container">
                <div class="copyright">
                    <div class="row">
                        <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                            &copy; <a class="border-bottom" href="#">AlumniJobConnect</a>. Đã đăng ký bản quyền.

                            <!--/*** This template is free as long as you keep the footer author’s credit link/attribution link/backlink. If you'd like to use the template without the footer author’s credit link/attribution link/backlink, you can purchase the Credit Removal License from "https://htmlcodex.com/credit-removal". Thank you for your support. ***/-->
                            Thiết kế bởi <a class="border-bottom" href="https://htmlcodex.com">HTML Codex</a>
                            <br>Phân phối bởi <a class="border-bottom" href="https://themewagon.com" target="_blank" rel="noopener">ThemeWagon</a>
                        </div>
                        <div class="col-md-6 text-center text-md-end">
                            <div class="footer-menu">
                                <a href="@Url.Content("~/")">Trang chủ</a>
                                <a href="#">Cookies</a>
                                <a href="#">Trợ giúp</a>
                                <a href="#">Câu hỏi thường gặp</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
        <!-- Footer End -->
        <!-- Back to Top -->
        <a href="#" class="btn btn-lg btn-primary btn-lg-square back-to-top" aria-label="Lên đầu trang"><i class="bi bi-arrow-up"></i></a>
    </div>

    <!-- JavaScript Libraries -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/lib/wow/wow.min.js"></script>
    <script src="~/assets/lib/easing/easing.min.js"></script>
    <script src="~/assets/lib/waypoints/waypoints.min.js"></script>
    <script src="~/assets/lib/owlcarousel/owl.carousel.min.js"></script>

    <!-- Template Javascript -->
    <script src="~/assets/js/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    @if (User.Identity?.IsAuthenticated == true &&
        (User.IsInRole("Alumni") || User.IsInRole("Employer")))
    {
        <a id="mentorInbox"
           class="mentor-inbox"
           href="@Url.RouteUrl("MentorChat")"
           data-unread-url="@Url.RouteUrl("MentorChatUnread")"
           aria-label="Mở tin nhắn tư vấn">

            <span aria-hidden="true">💬</span>
            <span>Tin nhắn</span>

            <span id="mentorUnreadBadge"
                  class="mentor-badge"
                  hidden>
            </span>
        </a>

        <div id="mentorMessageNotice"
             class="visually-hidden-live"
             role="status"
             aria-live="polite">
        </div>

        <script>
            (() => {
                const inbox = document.getElementById("mentorInbox");
                const badge = document.getElementById("mentorUnreadBadge");
                const notice = document.getElementById("mentorMessageNotice");

                if (!inbox) return;

                let previousCount = -1;
                let stopped = false;

                async function checkUnread() {
                    try {
                        const response = await fetch(inbox.dataset.unreadUrl, {
                            cache: "no-store",
                            headers: { Accept: "application/json" }
                        });

                        if (response.ok && !response.redirected) {
                            const data = await response.json();
                            const count = Number(data.count);

                            if (Number.isFinite(count)) {
                                badge.hidden = count === 0;
                                badge.textContent = count > 99 ? "99+" : count;

                                inbox.setAttribute(
                                    "aria-label",
                                    `Mở tin nhắn tư vấn, ${count} tin chưa đọc`
                                );

                                if (count > 0 && count !== previousCount) {
                                    notice.textContent =
                                        `Bạn có ${count} tin nhắn tư vấn chưa đọc.`;
                                }

                                previousCount = count;
                            }
                        }
                    } catch {
                        // Nút hộp thư vẫn hoạt động khi kiểm tra tin mới lỗi.
                    } finally {
                        if (!stopped) {
                            window.setTimeout(checkUnread, 5000);
                        }
                    }
                }

                window.addEventListener("pagehide", () => {
                    stopped = true;
                });

                checkUnread();
            })();
        </script>
    }


</body>

</html>
