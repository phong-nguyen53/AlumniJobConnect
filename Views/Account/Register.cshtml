@model AlumniJobConnect.Controllers.AccountController.RegisterInput

@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<div class="register-page">
    <div class="register-shell">

        <!-- Bên trái: giới thiệu (ẩn trên mobile) -->
        <aside class="register-aside">
            <a href="@Url.Content("~/")" class="register-brand register-brand--light">
                <i class="brand-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5z" /><path d="M6 12v5c3 3 9 3 12 0v-5" /><path d="M22 10v6" /></svg>
                </i>
                <span class="brand-text">Alumni<span>JobConnect</span></span>
            </a>

            <div class="aside-art" aria-hidden="true">
                <div class="art-badge">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5z" /><path d="M6 12v5c3 3 9 3 12 0v-5" /><path d="M22 10v6" /></svg>
                </div>
            </div>

            <div class="aside-body">
                <h2>Kết nối cộng đồng,<br />mở rộng cơ hội nghề nghiệp.</h2>
                <p>
                    Nền tảng dành cho cựu sinh viên và doanh nghiệp cùng tìm
                    kiếm, chia sẻ và phát triển cơ hội việc làm.
                </p>

                <ul class="aside-list">
                    <li><span>✓</span> Đăng ký nhanh chỉ trong vài phút</li>
                    <li><span>✓</span> Kết nối trực tiếp với doanh nghiệp</li>
                    <li><span>✓</span> Cập nhật cơ hội việc làm mới mỗi ngày</li>
                </ul>
            </div>

            <small class="aside-foot">© AlumniJobConnect</small>
        </aside>

        <!-- Bên phải: form -->
        <section class="register-card">
            <a href="@Url.Content("~/")" class="register-brand register-brand--mobile">
                <i class="brand-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5z" /><path d="M6 12v5c3 3 9 3 12 0v-5" /><path d="M22 10v6" /></svg>
                </i>
                <span class="brand-text">Alumni<span>JobConnect</span></span>
            </a>

            <h1>Tạo tài khoản</h1>
            <p class="register-caption">
                Điền thông tin bên dưới để bắt đầu hành trình của bạn.
            </p>

            @if (TempData["RegisterSuccess"] is string message)
            {
                <div class="alert alert-success" role="status">
                    @message
                </div>
            }

            <form action="@Url.Action("Register", "Account")" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="validation-box"></div>

                <!-- Chọn vai trò -->
                <div class="mb-4">
                    <span class="form-label d-block">Bạn muốn đăng ký với vai trò</span>

                    <div class="role-switch" id="roleSwitch">
                        <label class="role-option">
                            <input type="radio" asp-for="AccountType" value="Alumni" />
                            <span class="role-card">
                                <span class="role-icon">🎓</span>
                                <span class="role-title">Cựu sinh viên</span>
                                <span class="role-sub">Sinh viên / Cựu sinh viên</span>
                            </span>
                        </label>

                        <label class="role-option">
                            <input type="radio" asp-for="AccountType" value="Employer" />
                            <span class="role-card">
                                <span class="role-icon">🏢</span>
                                <span class="role-title">Doanh nghiệp</span>
                                <span class="role-sub">Tuyển dụng nhân tài</span>
                            </span>
                        </label>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">
                        Họ và tên / Người đại diện
                    </label>
                    <input asp-for="FullName"
                           class="form-control"
                           placeholder="Nguyễn Văn A"
                           autocomplete="name"
                           maxlength="150"
                           required />
                    <span asp-validation-for="FullName" class="field-error"></span>
                </div>

                <div class="mb-3" id="companyField">
                    <label asp-for="CompanyName" class="form-label">
                        Tên doanh nghiệp
                    </label>
                    <input asp-for="CompanyName"
                           class="form-control"
                           placeholder="Công ty TNHH ABC"
                           autocomplete="organization"
                           maxlength="200" />
                    <span asp-validation-for="CompanyName" class="field-error"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           placeholder="ban@example.com"
                           autocomplete="email"
                           maxlength="256"
                           required />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Mật khẩu</label>
                    <div class="password-wrap">
                        <input asp-for="Password"
                               type="password"
                               class="form-control"
                               placeholder="Ít nhất 10 ký tự"
                               autocomplete="new-password"
                               minlength="10"
                               maxlength="128"
                               required />
                        <button type="button" class="toggle-pass" data-target="Password"
                                aria-label="Hiện / ẩn mật khẩu">
                            Hiện
                        </button>
                    </div>
                    <small class="form-hint">Sử dụng từ 10 đến 128 ký tự.</small>
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label">
                        Nhập lại mật khẩu
                    </label>
                    <div class="password-wrap">
                        <input asp-for="ConfirmPassword"
                               type="password"
                               class="form-control"
                               placeholder="Nhập lại mật khẩu"
                               autocomplete="new-password"
                               maxlength="128"
                               required />
                        <button type="button" class="toggle-pass" data-target="ConfirmPassword"
                                aria-label="Hiện / ẩn mật khẩu">
                            Hiện
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                </div>

                <button type="submit" class="register-submit">
                    Đăng ký tài khoản <span aria-hidden="true">→</span>
                </button>
            </form>
            <p class="text-center mt-4">
                Đã có tài khoản?
                <a href="@Url.Action("Login", "Account")">
                    Đăng nhập
                </a>
            </p>

            <a href="@Url.Content("~/")" class="register-back">
                ← Quay lại trang chủ
            </a>
        </section>
    </div>
</div>

<style>
    .register-page {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        padding: 40px 16px;
        background: radial-gradient(circle at 10% 10%, #d9f2e6 0, transparent 40%), radial-gradient(circle at 90% 90%, #e3f1fb 0, transparent 40%), #f3f8f5;
        font-family: "Segoe UI", Arial, sans-serif;
    }

    .register-shell {
        display: grid;
        grid-template-columns: 0.9fr 1.1fr;
        width: 100%;
        max-width: 960px;
        overflow: hidden;
        background: #fff;
        border: 1px solid #e1ece5;
        border-radius: 24px;
        box-shadow: 0 24px 60px rgb(25 57 44 / 10%);
    }

    /* ---------- Cột trái ---------- */
    .register-aside {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 40px 36px;
        color: #fff;
        background: linear-gradient(155deg, #00a36c 0%, #007a54 55%, #0b4f3a 100%);
        overflow: hidden;
    }

        .register-aside::before,
        .register-aside::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            background: rgb(255 255 255 / 8%);
        }

        .register-aside::before {
            width: 260px;
            height: 260px;
            top: -90px;
            right: -90px;
        }

        .register-aside::after {
            width: 200px;
            height: 200px;
            bottom: -70px;
            left: -60px;
        }

        .register-aside > * {
            position: relative;
            z-index: 1;
        }

    .aside-art {
        display: flex;
        flex: 1;
        align-items: center;
        justify-content: center;
        padding: 24px 0;
    }

    .art-badge {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 190px;
        height: 190px;
        color: #fff;
        background: linear-gradient(145deg, rgb(255 255 255 / 24%), rgb(255 255 255 / 8%));
        border: 1px solid rgb(255 255 255 / 35%);
        border-radius: 48px;
        box-shadow: 0 24px 50px rgb(0 0 0 / 18%), inset 0 1px 0 rgb(255 255 255 / 35%);
        animation: art-float 5s ease-in-out infinite;
    }

        .art-badge::before {
            content: "";
            position: absolute;
            inset: -22px;
            border: 1px dashed rgb(255 255 255 / 28%);
            border-radius: 64px;
        }

        .art-badge svg {
            width: 108px;
            height: 108px;
            filter: drop-shadow(0 6px 10px rgb(0 0 0 / 20%));
        }

    @@keyframes art-float {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-8px);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .art-badge {
            animation: none;
        }
    }

    .aside-body h2 {
        margin-bottom: 14px;
        color: #fff !important;
        font-family: inherit !important;
        font-size: 26px;
        font-weight: 700;
        line-height: 1.35;
        letter-spacing: -.4px;
    }

    .aside-body p {
        margin-bottom: 26px;
        font-size: 14px;
        line-height: 1.75;
        color: rgb(255 255 255 / 82%);
    }

    .aside-list {
        margin: 0;
        padding: 0;
        list-style: none;
    }

        .aside-list li {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 12px;
            font-size: 14px;
        }

        .aside-list span {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 22px;
            height: 22px;
            flex: none;
            font-size: 12px;
            background: rgb(255 255 255 / 20%);
            border-radius: 50%;
        }

    .aside-foot {
        color: rgb(255 255 255 / 60%);
    }

    /* ---------- Thương hiệu ---------- */
    .register-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        color: #243e31;
        font-size: 23px;
        font-weight: 750;
        text-decoration: none;
        letter-spacing: -.7px;
    }

        .register-brand .brand-text {
            color: inherit;
        }

            .register-brand .brand-text span {
                color: #00a36c;
            }

    .brand-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        flex: none;
        color: #fff;
        background: linear-gradient(135deg, #00b377, #00a36c);
        border-radius: 12px;
        box-shadow: 0 6px 14px rgb(0 163 108 / 30%);
    }

        .brand-icon svg {
            width: 22px;
            height: 22px;
        }

    .register-brand--light {
        color: #fff;
    }

        .register-brand--light .brand-text span {
            color: #b9f3d9;
        }

        .register-brand--light .brand-icon {
            background: rgb(255 255 255 / 20%);
            border: 1px solid rgb(255 255 255 / 35%);
            box-shadow: none;
        }

    .register-brand--mobile {
        display: none;
        margin-bottom: 22px;
    }

    /* ---------- Cột phải ---------- */
    .register-card {
        padding: 40px 44px;
    }

        .register-card h1 {
            margin-bottom: 8px;
            color: #243e31;
            font-family: inherit !important;
            font-size: 28px;
            font-weight: 700 !important;
            letter-spacing: -.5px;
        }

    .register-caption {
        margin-bottom: 26px;
        color: #7b8980;
        font-size: 14px;
        line-height: 1.7;
    }

    .register-card .form-label {
        margin-bottom: 6px;
        color: #40574a;
        font-size: 13.5px;
        font-weight: 600;
    }

    .register-card .form-control {
        min-height: 46px;
        padding: 10px 14px;
        font-size: 14.5px;
        color: #243e31;
        background: #fafcfb;
        border: 1px solid #dce7df;
        border-radius: 10px;
        transition: border-color .15s, box-shadow .15s, background .15s;
    }

        .register-card .form-control::placeholder {
            color: #a9b6ae;
        }

        .register-card .form-control:hover {
            border-color: #c5d8cc;
        }

        .register-card .form-control:focus {
            background: #fff;
            border-color: #00a36c;
            box-shadow: 0 0 0 4px rgb(0 163 108 / 12%);
        }

    .form-hint {
        display: block;
        margin-top: 6px;
        color: #8a978f;
        font-size: 12.5px;
    }

    .field-error {
        display: block;
        margin-top: 4px;
        color: #d64545;
        font-size: 12.5px;
    }

    .validation-box:not(.validation-summary-valid) {
        margin-bottom: 18px;
        padding: 12px 16px;
        color: #b42318;
        background: #fef3f2;
        border: 1px solid #fecdca;
        border-radius: 10px;
        font-size: 13.5px;
    }

    .validation-box ul {
        margin: 0;
        padding-left: 18px;
    }

    .register-card .alert-success {
        border-radius: 10px;
        font-size: 14px;
    }

    /* ---------- Chọn vai trò ---------- */
    .role-switch {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .role-option {
        position: relative;
        margin: 0;
        cursor: pointer;
    }

        .role-option input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

    .role-card {
        display: flex;
        flex-direction: column;
        gap: 2px;
        height: 100%;
        padding: 14px 14px 12px;
        background: #fafcfb;
        border: 1.5px solid #dce7df;
        border-radius: 12px;
        transition: all .15s;
    }

    .role-option:hover .role-card {
        border-color: #9fd9c0;
    }

    .role-option input:checked + .role-card {
        background: #effaf5;
        border-color: #00a36c;
        box-shadow: 0 0 0 3px rgb(0 163 108 / 12%);
    }

    .role-option input:focus-visible + .role-card {
        outline: 2px solid #00a36c;
        outline-offset: 2px;
    }

    .role-icon {
        margin-bottom: 4px;
        font-size: 22px;
        line-height: 1;
    }

    .role-title {
        color: #243e31;
        font-size: 14.5px;
        font-weight: 650;
    }

    .role-sub {
        color: #7b8980;
        font-size: 12px;
    }

    /* ---------- Mật khẩu ---------- */
    .password-wrap {
        position: relative;
    }

        .password-wrap .form-control {
            padding-right: 64px;
        }

    .toggle-pass {
        position: absolute;
        top: 50%;
        right: 8px;
        padding: 6px 10px;
        color: #00a36c;
        background: none;
        border: 0;
        border-radius: 6px;
        font-size: 12.5px;
        font-weight: 600;
        transform: translateY(-50%);
    }

        .toggle-pass:hover {
            background: #effaf5;
        }

    /* ---------- Nút ---------- */
    .register-submit {
        width: 100%;
        padding: 14px;
        color: #fff;
        background: linear-gradient(135deg, #00b377, #00a36c);
        border: 0;
        border-radius: 12px;
        font-size: 15px;
        font-weight: 600;
        box-shadow: 0 8px 20px rgb(0 163 108 / 25%);
        transition: transform .15s, box-shadow .15s, background .15s;
    }

        .register-submit:hover {
            background: linear-gradient(135deg, #00a36c, #00885a);
            box-shadow: 0 10px 24px rgb(0 163 108 / 32%);
            transform: translateY(-1px);
        }

        .register-submit:active {
            transform: translateY(0);
        }

    .register-back {
        display: block;
        margin-top: 22px;
        color: #75857a;
        text-align: center;
        text-decoration: none;
        font-size: 13px;
    }

        .register-back:hover {
            color: #00a36c;
        }

    /* ---------- Responsive ---------- */
    @@media (max-width: 860px) {
        .register-shell {
            grid-template-columns: 1fr;
            max-width: 520px;
        }

        .register-aside {
            display: none;
        }

        .register-brand--mobile {
            display: flex;
        }
    }

    @@media (max-width: 575.98px) {
        .register-page {
            padding: 20px 12px;
        }

        .register-card {
            padding: 26px 20px;
        }

        .role-switch {
            grid-template-columns: 1fr;
        }
    }
</style>

<script>
    (() => {
        const radios = document.querySelectorAll('input[name="AccountType"]');
        const companyField = document.getElementById("companyField");
        const companyInput = companyField.querySelector("input");

        // Mặc định chọn "Alumni" nếu chưa có giá trị nào
        if (![...radios].some(r => r.checked)) {
            const first = [...radios].find(r => r.value === "Alumni");
            if (first) first.checked = true;
        }

        function updateCompanyField() {
            const current = [...radios].find(r => r.checked);
            const isEmployer = current && current.value === "Employer";
            companyField.hidden = !isEmployer;
            companyInput.required = isEmployer;
            companyInput.disabled = !isEmployer;
        }

        radios.forEach(r => r.addEventListener("change", updateCompanyField));
        updateCompanyField();

        // Hiện / ẩn mật khẩu
        document.querySelectorAll(".toggle-pass").forEach(btn => {
            btn.addEventListener("click", () => {
                const input = document.getElementById(btn.dataset.target);
                const show = input.type === "password";
                input.type = show ? "text" : "password";
                btn.textContent = show ? "Ẩn" : "Hiện";
            });
        });
    })();
</script>
