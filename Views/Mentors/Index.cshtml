@using System.Security.Claims
@model System.Collections.Generic.IReadOnlyList<AlumniJobConnect.Controllers.MentorsController.MentorCard>

@{
    ViewData["Title"] = "Tìm cựu sinh viên";
    var companyFilter = ViewData["CompanyFilter"] as string ?? "";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="container py-5">
    <header class="rounded-3 bg-light p-4 p-md-5 mb-4">
        <h1 class="h2 fw-bold mb-2">Tìm cựu sinh viên</h1>
        <p class="text-muted mb-0">
            Tìm anh chị đi trước để hỏi về công việc và kinh nghiệm ứng tuyển.
        </p>
    </header>

    @if (TempData["MentorRequestSuccess"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }

    <form method="get" action="@Url.RouteUrl("MentorDirectory")" class="mb-4">
        <label for="company" class="form-label fw-semibold">Công ty đang làm</label>
        <div class="d-flex flex-wrap gap-2">
            <input id="company" name="company" type="search"
                   class="form-control w-auto flex-grow-1"
                   value="@companyFilter" placeholder="Ví dụ FPT Software" />
            <button type="submit" class="btn btn-primary">Tìm cựu sinh viên</button>
            <a class="btn btn-outline-secondary" href="@Url.RouteUrl("MentorDirectory")">Đặt lại</a>
        </div>
    </form>

    @if (Model.Count == 0)
    {
        <div class="alert alert-light border" role="status">
            @(companyFilter.Length > 0
                    ? "Không tìm thấy cựu sinh viên tại công ty bạn nhập."
                    : "Hiện chưa có hồ sơ cựu sinh viên.")
    </div>
        }
    else
    {
        <p class="text-muted">@Model.Count cựu sinh viên trong kết quả</p>
        <div class="row g-4">
            @foreach (var person in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <article class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4 d-flex flex-column">
                            <h2 class="h5 fw-bold mb-2">@person.FullName</h2>
                            <p class="mb-1">
                                @(string.IsNullOrWhiteSpace(person.JobTitle) ? "Chưa cập nhật vị trí" : person.JobTitle)
                            </p>
                            <p class="text-muted mb-3">
                                @(string.IsNullOrWhiteSpace(person.CompanyName) ? "Chưa cập nhật công ty" : person.CompanyName)
                            </p>
                            @if (!string.IsNullOrWhiteSpace(person.Expertise))
                            {
                                <p class="text-primary fw-semibold mb-2">@person.Expertise</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(person.Introduction))
                            {
                                <p class="text-break" style="white-space: pre-wrap;">@person.Introduction</p>
                            }
                            <div class="mt-auto pt-3">
                                @if (person.IsAvailable)
                                {
                                    <span class="badge bg-success">Sẵn sàng tư vấn</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Tạm ngừng nhận tư vấn</span>
                                }

                                @if (currentUserId == person.UserId.ToString())
                                {
                                    <a class="btn btn-outline-primary btn-sm mt-3 d-block"
                                       href="@Url.Action("Index", "Profile")">
                                        Cập nhật công việc và tư vấn
                                    </a>
                                }
                                else if (person.IsAvailable)
                                {
                                    <form method="post"
                                          action="@Url.RouteUrl("StartMentorChat")"
                                          class="mt-3">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="mentorUserId"
                                               value="@person.UserId" />

                                        <button type="submit" class="btn btn-primary w-100">
                                            Nhắn tin tư vấn
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</div>
