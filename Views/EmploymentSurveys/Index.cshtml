@model AlumniJobConnect.Features.EmploymentSurveys.SurveyListPage
@{
    ViewData["Title"] = "Khảo sát việc làm";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var total = Model.Items.Count();
    var openCount = Model.Items.Count(x => x.IsOpen);
    var doneCount = Model.Items.Count(x => x.HasResponded);
    var pct = total == 0 ? 0 : (int)Math.Round(doneCount * 100.0 / total);
}
<link rel="stylesheet" href="~/assets/css/employment-surveys.css" asp-append-version="true" />

<div class="es-page">

    <header class="es-hero">
        <div class="es-hero-text">
            <span class="es-eyebrow">KẾT NỐI CỰU SINH VIÊN</span>
            <h1>Khảo sát tình hình việc làm</h1>
            <p>Chia sẻ tình hình công việc để nhà trường có cơ sở hỗ trợ bạn tốt hơn.</p>
        </div>
        <div class="es-hero-stats" aria-label="Tổng quan khảo sát">
            <div class="es-stat"><strong>@total</strong><span>Được mời</span></div>
            <div class="es-stat"><strong>@openCount</strong><span>Đang mở</span></div>
            <div class="es-stat"><strong>@doneCount</strong><span>Đã trả lời</span></div>
        </div>
        @if (total > 0)
        {
            <div class="es-progress">
                <div class="es-progress-label"><span>Tiến độ hoàn thành</span><span>@doneCount/@total · @(pct)%</span></div>
                <div class="es-progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@pct">
                    <div class="es-progress-bar" style="width:@(pct)%"></div>
                </div>
            </div>
        }
    </header>

    @if (User.IsInRole("Admin"))
    {
        <div class="es-note es-admin-note">
            <span>Đây là danh sách khảo sát tài khoản của bạn được mời. Để quản lý các đợt và xem kết quả,</span>
            <a asp-area="Admin" asp-controller="EmploymentSurveys" asp-action="Index">vào trang quản trị khảo sát →</a>
        </div>
    }

    @if (Model.Items.Any())
    {
        <div class="es-toolbar">
            <h2>Khảo sát của bạn</h2>
            <div class="es-filters" role="group" aria-label="Lọc khảo sát">
                <button type="button" class="es-filter is-active" data-es-filter="all" aria-pressed="true">Tất cả</button>
                <button type="button" class="es-filter" data-es-filter="open" aria-pressed="false">Đang mở</button>
                <button type="button" class="es-filter" data-es-filter="pending" aria-pressed="false">Chưa trả lời</button>
                <button type="button" class="es-filter" data-es-filter="done" aria-pressed="false">Đã trả lời</button>
            </div>
        </div>

        <section class="es-cards">
            @foreach (var s in Model.Items)
            {
                <article class="es-card @(s.IsOpen ? "es-card-open" : "es-card-closed")"
                         data-open="@(s.IsOpen ? "1" : "0")" data-done="@(s.HasResponded ? "1" : "0")">
                    <div class="es-card-top">
                        <span class="es-badge @(s.IsOpen ? "es-green" : "")">
                            <i class="es-dot"></i>@s.State
                        </span>
                        <span class="es-response-pill @(s.HasResponded ? "is-done" : "is-pending")">
                            @(s.HasResponded ? "✓ Đã trả lời" : "Chưa trả lời")
                        </span>
                    </div>

                    <h2 class="es-card-title">@s.Title</h2>

                    <div class="es-card-date">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="3" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                        <span>@s.StartsOn.ToString("dd/MM/yyyy") – hết ngày @s.EndsOn.ToString("dd/MM/yyyy")</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(s.Description))
                    {
                        <p class="es-card-desc">@s.Description</p>
                    }

                    <div class="es-card-footer">
                        <a class="es-button @(s.HasResponded ? "es-outline" : "")"
                           asp-area="" asp-action="Answer" asp-route-id="@s.SurveyId">
                            @(s.HasResponded ? (s.IsOpen ? "Xem / sửa câu trả lời" : "Xem câu trả lời") : (s.IsOpen ? "Tham gia khảo sát" : "Xem đợt khảo sát")) →
                        </a>
                    </div>
                </article>
            }
        </section>

        <div class="es-filter-empty" id="es-filter-empty" hidden>Không có khảo sát nào phù hợp bộ lọc này.</div>
    }
    else
    {
        <div class="es-panel es-empty-state">
            <div class="es-empty-icon">
                <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11l3 3 8-8" /><path d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9" /></svg>
            </div>
            <h2>Chưa có khảo sát nào</h2>
            <p>Bạn chưa có khảo sát được mời trong trang này. Đối tượng của mỗi đợt được nhà trường chốt khi tạo khảo sát.</p>
        </div>
    }

    <nav class="es-pagination es-pager" aria-label="Phân trang khảo sát">
        @if (Model.Page > 1)
        {
            <a class="es-pager-btn" asp-action="Index" asp-route-page="@(Model.Page - 1)">← Trang trước</a>
        }
        <span class="es-pager-current">Trang @Model.Page</span>
        @if (Model.HasMore)
        {
            <a class="es-pager-btn" asp-action="Index" asp-route-page="@(Model.Page + 1)">Trang sau →</a>
        }
    </nav>
</div>

<script src="~/assets/js/employment-surveys.js" asp-append-version="true" defer></script>
