@model AlumniJobConnect.Models.JobPost
@{
    ViewData["Title"] = "Luyện phỏng vấn với AI";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/assets/css/ai-interview-history.css" asp-append-version="true" />
<div class="aiv-page" id="aivApp"
     data-chat="@Url.Action("Chat", "AiInterview", new { area = "" })"
     data-history="@Url.Action("History", "AiInterview", new { area = "" })"
     data-session="@Url.Action("Session", "AiInterview", new { area = "" })"
     data-delete="@Url.Action("Delete", "AiInterview", new { area = "" })"
     data-index="@Url.Action("Index", "AiInterview", new { area = "" })"
     data-job-id="@Model.JobPostId" data-initial-session="@ViewBag.InitialSessionId">
    <div class="aiv-heading">
        <div>
            <span class="aiv-eyebrow">PHÁT TRIỂN SỰ NGHIỆP</span>
            <h1>Luyện phỏng vấn với AI</h1><p>Luyện trả lời, nhận góp ý và xem lại tiến trình của bạn.</p>
        </div>
        <span class="aiv-pill">✦ 5 câu hỏi / buổi</span>
    </div>
    <div class="aiv-workspace">
        <aside class="aiv-sidebar" aria-label="Lịch sử luyện phỏng vấn">
            <button type="button" id="aivNew" class="aiv-primary">＋ Buổi luyện tập mới</button>
            <div class="aiv-history-heading"><h2>Lịch sử luyện tập</h2><button id="aivRefresh" type="button" aria-label="Tải lại lịch sử">↻</button></div>
            <p class="aiv-muted aiv-small">Lưu riêng theo tài khoản của bạn.</p>
            <div id="aivHistoryList" class="aiv-history-list"></div>
            <p id="aivHistoryEmpty" class="aiv-muted aiv-small" hidden>Chưa có buổi luyện tập.<br>Bấm Bắt đầu để tạo buổi đầu tiên.</p>
            <button type="button" id="aivMore" class="aiv-secondary" hidden>Xem thêm lịch sử</button>
            <p class="aiv-sidebar-note">◷ Tự động lưu sau mỗi phản hồi AI.<br>Bạn có thể quay lại để luyện tiếp.</p>
        </aside>
        <section class="aiv-main" aria-label="Nội dung luyện phỏng vấn">
            <header class="aiv-job-header">
                <span class="aiv-eyebrow">VỊ TRÍ LUYỆN TẬP</span>
                <h2 id="aivJobTitle">@Model.Title</h2>
                <div class="aiv-job-meta"><span id="aivCompany">@Model.Company?.CompanyName</span><span id="aivProgress">Chưa bắt đầu</span></div>
            </header>
            <div class="aiv-notes">Buổi luyện tập gồm 5 câu hỏi. Nhận xét của AI chỉ hỗ trợ ôn tập, không phải kết quả tuyển dụng của doanh nghiệp.</div>
            <div class="aiv-setup">
                <label for="aivLevel">Mức kinh nghiệm</label><select id="aivLevel">
                    <option value="intern">Thực tập sinh</option>
                    <option value="graduate" selected>Mới tốt nghiệp</option>
                    <option value="experienced">Có kinh nghiệm</option>
                </select><button type="button" id="aivStart" class="aiv-primary">Bắt đầu luyện tập</button>
            </div>
            <div id="aivError" class="aiv-error" role="alert" hidden></div>
            <div id="aivChat" class="aiv-chat" role="log" aria-live="polite" aria-label="Câu hỏi, câu trả lời và nhận xét"></div>
            <div id="aivFinished" class="aiv-finished" hidden>✓ Đã hoàn thành 5 câu hỏi. Nhận xét tổng kết nằm ở cuối hội thoại. Bạn có thể xem lại bất cứ lúc nào.</div>
            <form id="aivForm" class="aiv-compose">
                @Html.AntiForgeryToken()
                <div id="aivAnswerGroup" hidden>
                    <label for="aivAnswer">Câu trả lời của bạn</label>
                    <textarea id="aivAnswer" maxlength="2000" rows="4" placeholder="Trình bày suy nghĩ của bạn, tối đa 2.000 ký tự…"></textarea>
                    <div class="aiv-bottom"><span id="aivCounter">0 / 2000</span><button id="aivSend" type="submit" class="aiv-primary">Gửi câu trả lời ↗</button></div>
                </div>
                <p id="aivStatus" class="aiv-muted aiv-small" role="status"></p>
                <p class="aiv-disclosure">Mô tả vị trí và hội thoại được gửi đến OpenAI để xử lý. Không nhập thông tin bí mật. Lịch sử được lưu trong hệ thống theo tài khoản đăng nhập. Ctrl + Enter để gửi câu trả lời.</p>
            </form>
        </section>
    </div>
</div>
<script src="~/assets/js/ai-interview-history.js" asp-append-version="true" defer></script>
