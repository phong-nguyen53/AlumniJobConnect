<!DOCTYPE html>
<html lang="vi">

<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>@ViewData["Title"] - AlumniJobConnect Admin</title>
    <!-- plugins:css -->
    <link rel="stylesheet" href="~/admin/assets/vendors/feather/feather.css">
    <link rel="stylesheet" href="~/admin/assets/vendors/mdi/css/materialdesignicons.min.css">
    <link rel="stylesheet" href="~/admin/assets/vendors/ti-icons/css/themify-icons.css">
    <link rel="stylesheet" href="~/admin/assets/vendors/typicons/typicons.css">
    <link rel="stylesheet" href="~/admin/assets/vendors/simple-line-icons/css/simple-line-icons.css">
    <link rel="stylesheet" href="~/admin/assets/vendors/css/vendor.bundle.base.css">
    <!-- endinject -->
    <!-- Plugin css for this page -->
    <link rel="stylesheet" href="~/admin/assets/vendors/datatables.net-bs4/dataTables.bootstrap4.css">
    <link rel="stylesheet" href="~/admin/assets/js/select.dataTables.min.css">
    <!-- End plugin css for this page -->
    <!-- inject:css -->
    <link rel="stylesheet" href="~/admin/assets/css/vertical-layout-light/style.css">
    <!-- endinject -->
    <link rel="shortcut icon" href="~/admin/assets/images/favicon.png" />
    <style>
        #admin-menu-backdrop {
            position: fixed;
            inset: 0;
            z-index: 1039;
            border: 0;
            background: rgba(16,34,28,.35);
            cursor: pointer;
        }

            #admin-menu-backdrop[hidden] {
                display: none !important;
            }

        #sidebar .nav .nav-link {
            min-height: 48px;
        }

        #sidebar .menu-title {
            white-space: normal;
            line-height: 1.45;
        }

        @@media (min-width: 992px) {
            #admin-menu-backdrop {
                display: none !important;
            }
        }

        @@media (max-width: 991.98px) {
            #sidebar.sidebar-offcanvas {
                position: fixed;
                top: var(--admin-nav-height, 97px);
                bottom: 0;
                height: calc(100dvh - var(--admin-nav-height, 97px));
                overflow-y: auto;
                right: auto;
                left: 0;
                transform: translateX(-100%);
                transition: transform .2s ease;
                z-index: 1041;
            }

                #sidebar.sidebar-offcanvas.active {
                    transform: translateX(0);
                }

            body.admin-menu-open {
                overflow: hidden;
            }
        }
    </style>
    <style>
        body {
            background: #f4f6fa
        }

        .navbar.fixed-top {
            height: 86px;
            min-height: 86px;
            background: #fff;
            border-bottom: 1px solid #e4e9f0;
            padding: 0;
            z-index: 1042
        }

        .navbar .navbar-brand-wrapper {
            width: 260px !important;
            height: 86px !important;
            padding: 0 20px;
            gap: 15px;
            flex-shrink: 0;
            background: #fff
        }

        .navbar .navbar-menu-wrapper {
            width: calc(100% - 260px) !important;
            height: 86px !important;
            padding: 0 28px
        }

        .admin-brand {
            font-size: 21px;
            font-weight: 750;
            color: #223553;
            text-decoration: none;
            white-space: nowrap
        }

            .admin-brand span {
                color: #009b72
            }

        .admin-heading small {
            display: block;
            color: #718195;
            font-size: 10px;
            letter-spacing: 1.3px
        }

        .admin-heading strong {
            display: block;
            color: #213553;
            font-size: 17px;
            margin-top: 4px
        }

        .admin-public-link {
            font-size: 13px;
            color: #52687c;
            text-decoration: none
        }

        .admin-account {
            display: flex;
            align-items: center;
            gap: 9px;
            border: 1px solid #e4e9f0;
            border-radius: 10px;
            background: #f7faf9;
            color: #243d39;
            padding: 10px 13px
        }

            .admin-account .mdi-account-circle {
                font-size: 23px;
                color: #009b72
            }

        .navbar .navbar-toggler {
            padding: 5px;
            color: #34465a;
            font-size: 25px;
            border: 0;
            background: none
        }

        .container-scroller > .page-body-wrapper {
            padding-top: 86px !important;
            display: flex;
            min-height: 100vh
        }

        .page-body-wrapper > #sidebar {
            width: 260px;
            min-width: 260px;
            flex: 0 0 260px;
            background: #fff;
            margin: 0
        }

        .page-body-wrapper > .main-panel {
            flex: 1;
            min-width: 0;
            width: calc(100% - 260px);
            min-height: calc(100vh - 86px);
            margin: 0
        }

        .main-panel > .content-wrapper {
            padding: 28px !important;
            background: #f4f6fa;
            width: 100%;
            min-width: 0
        }

        .main-panel > .footer {
            padding: 20px 28px;
            background: #f4f6fa;
            font-size: 12px;
            color: #768397
        }

        #sidebar > .nav {
            margin-top: 18px;
            padding-bottom: 25px
        }

        #sidebar .nav-item .nav-link {
            padding: 14px 22px;
            min-height: 48px;
            border-radius: 0 24px 24px 0;
            margin-right: 12px
        }

        #sidebar .menu-title {
            font-size: 13px
        }

        #sidebar .nav-item.active > .nav-link {
            background: #e9f7f1;
            color: #008260
        }

            #sidebar .nav-item.active > .nav-link .menu-icon {
                color: #008260
            }

        @@media(min-width:992px) {
            body.sidebar-icon-only .page-body-wrapper > #sidebar {
                width: 78px;
                min-width: 78px;
                flex-basis: 78px
            }

            body.sidebar-icon-only .page-body-wrapper > .main-panel {
                width: calc(100% - 78px)
            }

            body.sidebar-icon-only #sidebar .menu-title {
                display: none !important
            }

            body.sidebar-icon-only #sidebar .nav-link {
                justify-content: center;
                padding: 15px 0;
                margin-right: 0
            }

            body.sidebar-icon-only #sidebar .menu-icon {
                margin: 0 !important
            }

            body.sidebar-icon-only .navbar .navbar-brand-wrapper {
                width: 260px !important
            }
        }

        @@media(max-width:991.98px) {
            .navbar .navbar-brand-wrapper {
                width: 220px !important;
                padding: 0 14px
            }

            .navbar .navbar-menu-wrapper {
                width: calc(100% - 220px) !important;
                padding: 0 15px
            }

            .admin-heading {
                display: none
            }

            .navbar .navbar-menu-wrapper {
                justify-content: flex-end !important
            }

            .page-body-wrapper > .main-panel {
                width: 100% !important
            }

            .main-panel > .content-wrapper {
                padding: 20px !important
            }

            #sidebar.sidebar-offcanvas {
                width: 260px !important;
                min-width: 260px !important
            }
        }

        @@media(max-width:600px) {
            .navbar .navbar-brand-wrapper {
                width: auto !important;
                gap: 8px;
                padding: 0 10px
            }

            .navbar .navbar-menu-wrapper {
                flex: 1;
                width: auto !important;
                padding: 0 10px
            }

            .admin-brand {
                font-size: 17px
            }

            .admin-account {
                padding: 7px
            }

                .admin-account > span, .admin-public-link {
                    display: none
                }

            .main-panel > .content-wrapper {
                padding: 14px !important
            }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="container-scroller">
        <!-- partial:partials/_navbar.html -->
        <nav class="navbar default-layout fixed-top d-flex flex-row align-items-center" aria-label="Thanh công cụ quản trị">
            <div class="navbar-brand-wrapper d-flex align-items-center">
                <button class="navbar-toggler" type="button" data-admin-menu aria-controls="sidebar" aria-expanded="true" aria-label="Đóng hoặc mở menu"><span class="mdi mdi-menu" aria-hidden="true"></span></button>
                <a class="admin-brand" href="@Url.Content("~/Admin")">Alumni<span>Connect</span></a>
            </div>
            <div class="navbar-menu-wrapper d-flex align-items-center justify-content-between">
                <div class="admin-heading"><small>KHU VỰC QUẢN TRỊ</small><strong>@ViewData["Title"]</strong></div>
                <div class="d-flex align-items-center gap-3">
                    <a class="admin-public-link" href="@Url.Content("~/")">Về website ↗</a>
                    <div class="dropdown user-dropdown">
                        <button class="admin-account" id="UserDropdown" type="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="mdi mdi-account-circle" aria-hidden="true"></i><span>@(User.Identity?.Name ?? "Quản trị viên")</span><i class="mdi mdi-chevron-down" aria-hidden="true"></i></button>
                        <div class="dropdown-menu dropdown-menu-end navbar-dropdown" aria-labelledby="UserDropdown">
                            <div class="dropdown-header"><strong>@(User.Identity?.Name)</strong><p class="mb-0">@(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value)</p></div>
                            <form method="post" action="@Url.Action("Logout", "Account", new { area = "" })" class="m-0">@Html.AntiForgeryToken()<button type="submit" class="dropdown-item text-danger">Đăng xuất</button></form>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
        <div class="container-fluid page-body-wrapper">
            <nav class="sidebar sidebar-offcanvas" id="sidebar" aria-label="Menu quản trị">
                <ul class="nav">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Content("~/Admin")" title="Trang chủ">
                            <i class="mdi mdi-home menu-icon" aria-hidden="true"></i>
                            <span class="menu-title">Trang chủ</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Content("~/Admin/Statistics")" title="Thống kê">
                            <i class="mdi mdi-chart-bar menu-icon" aria-hidden="true"></i>
                            <span class="menu-title">Thống kê</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@(Url.RouteUrl("AdminUsers") ?? Url.Content("~/Admin/Users"))" title="Người dùng">
                            <i class="mdi mdi-account-multiple menu-icon" aria-hidden="true"></i>
                            <span class="menu-title">Người dùng</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "AlumniProfiles", new { area = "Admin" })" title="Hồ sơ sinh viên / cựu sinh viên">
                            <i class="mdi mdi-account-card-details menu-icon" aria-hidden="true"></i>
                            <span class="menu-title">Hồ sơ sinh viên / cựu sinh viên</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@(Url.RouteUrl("AdminCompanies") ?? Url.Content("~/Admin/Companies"))" title="Doanh nghiệp">
                            <i class="mdi mdi-domain menu-icon" aria-hidden="true"></i>
                            <span class="menu-title">Doanh nghiệp</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "JobCategories", new { area = "Admin" })" title="Ngành nghề">
                            <i class="mdi mdi-format-list-bulleted menu-icon" aria-hidden="true"></i>
                            <span class="menu-title">Ngành nghề</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@(Url.RouteUrl("AdminJobPosts") ?? Url.Content("~/Admin/JobPosts"))" title="Tin tuyển dụng">
                            <i class="mdi mdi-briefcase menu-icon" aria-hidden="true"></i>
                            <span class="menu-title">Tin tuyển dụng</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Applications", new { area = "Admin" })" title="Đơn ứng tuyển">
                            <i class="mdi mdi-file-document menu-icon" aria-hidden="true"></i>
                            <span class="menu-title">Đơn ứng tuyển</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "MentorProfiles", new { area = "Admin" })" title="Hồ sơ cố vấn">
                            <i class="mdi mdi-account-star menu-icon" aria-hidden="true"></i>
                            <span class="menu-title">Hồ sơ cố vấn</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "MentorMessages", new { area = "Admin" })" title="Tin nhắn tư vấn">
                            <i class="mdi mdi-message-text menu-icon" aria-hidden="true"></i>
                            <span class="menu-title">Tin nhắn tư vấn</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Events", new { area = "Admin" })" title="Sự kiện">
                            <i class="mdi mdi-calendar menu-icon" aria-hidden="true"></i>
                            <span class="menu-title">Sự kiện</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Index", "EmploymentSurveys",
                                               new { area = "Admin" })">
                            <i class="mdi mdi-clipboard-text menu-icon"
                               aria-hidden="true"></i>

                            <span class="menu-title">Khảo sát việc làm</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Menus", new { area = "Admin" })" title="Quản lý menu">
                            <i class="mdi mdi-menu menu-icon" aria-hidden="true"></i>
                            <span class="menu-title">Quản lý menu</span>
                        </a>
                    </li>
                </ul>
            </nav>
            <button type="button" id="admin-menu-backdrop" aria-label="Đóng menu" hidden></button>
            <div class="main-panel">
                <div class="content-wrapper">
                    @RenderBody()
                </div>
                <footer class="footer">AlumniJobConnect · Quản trị hệ thống · © @DateTime.Now.Year</footer>
            </div>
        </div>
    </div>
    <!-- container-scroller -->
    <!-- plugins:~/admin/assets/js -->
    <script src="~/admin/assets/vendors/js/vendor.bundle.base.js"></script>
    <!-- endinject -->
    <!-- Plugin ~/admin/assets/js for this page -->
    <script src="~/admin/assets/vendors/chart.js/Chart.min.js"></script>
    <script src="~/admin/assets/vendors/bootstrap-datepicker/bootstrap-datepicker.min.js"></script>
    <script src="~/admin/assets/vendors/progressbar.js/progressbar.min.js"></script>

    <!-- End plugin ~/admin/assets/js for this page -->
    <!-- inject:~/admin/assets/js -->
    <script src="~/admin/assets/js/off-canvas.js"></script>
    <script src="~/admin/assets/js/hoverable-collapse.js"></script>
    <script src="~/admin/assets/js/template.js"></script>
    <!-- endinject -->
    <!-- Custom ~/admin/assets/js for this page-->
    <!-- End custom ~/admin/assets/js for this page-->
    <script>
        // These buttons are owned here, so template handlers do not toggle twice.
        (() => {
            const sidebar = document.getElementById('sidebar');
            const backdrop = document.getElementById('admin-menu-backdrop');
            const buttons = document.querySelectorAll('[data-admin-menu]');
            const desktop = window.matchMedia('(min-width: 992px)');
            if (!sidebar || !backdrop) return;
            function sync() {
                const opened = desktop.matches
                    ? !document.body.classList.contains('sidebar-icon-only')
                    : sidebar.classList.contains('active');
                buttons.forEach(button => button.setAttribute('aria-expanded', String(opened)));
                backdrop.hidden = desktop.matches || !opened;
                document.body.classList.toggle('admin-menu-open', !desktop.matches && opened);
                const navbar = document.querySelector('.navbar.fixed-top');
                if (navbar) document.documentElement.style.setProperty('--admin-nav-height', navbar.getBoundingClientRect().height + 'px');
            }
            function closeMobile(returnFocus = false) {
                sidebar.classList.remove('active');
                sync();
                if (returnFocus) Array.from(buttons).find(b => b.getClientRects().length)?.focus();
            }
            buttons.forEach(button => button.addEventListener('click', () => {
                if (desktop.matches) document.body.classList.toggle('sidebar-icon-only');
                else sidebar.classList.toggle('active');
                sync();
            }));
            backdrop.addEventListener('click', () => closeMobile(true));
            document.addEventListener('keydown', event => {
                if (event.key === 'Escape' && !desktop.matches && sidebar.classList.contains('active')) closeMobile(true);
            });
            sidebar.querySelectorAll('a.nav-link').forEach(link => {
                const url = new URL(link.href, window.location.href);
                if (url.pathname.replace(/\/$/, '').toLowerCase() === window.location.pathname.replace(/\/$/, '').toLowerCase()) {
                    link.parentElement.classList.add('active');
                    link.setAttribute('aria-current', 'page');
                }
                link.addEventListener('click', () => { if (!desktop.matches) closeMobile(); });
            });
            window.addEventListener('resize', () => {
                if (desktop.matches) sidebar.classList.remove('active');
                sync();
            });
            sync();
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>

