@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<AlumniJobConnect.Models.Menu>

@{
    ViewData["Title"] = "Quản lý menu";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    var menus = Model.ToList();
    var createUrl = Url.Action("Create", "Menus", new { area = "Admin" });
    var activeCount = menus.Count(m => m.IsActive == true);
}

<style>
    .menu-admin {
        --ma-green: #009b72;
        --ma-green-dark: #007e5d;
        --ma-border: #e3ece8;
        --ma-muted: #71837c;
        width: 100%;
        max-width: 1450px;
        margin: 0 auto;
        padding: 28px 24px;
        color: #203b32;
    }

        .menu-admin * {
            box-sizing: border-box;
        }

        .menu-admin [hidden] {
            display: none !important;
        }

    /* ---------- Header ---------- */
    .ma-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 26px;
    }

    .ma-eyebrow {
        margin-bottom: 8px;
        color: var(--ma-green);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .ma-header h1 {
        margin: 0 0 9px;
        font-size: 28px;
        font-weight: 700;
        color: #203b32;
    }

    .ma-subtitle {
        margin: 0;
        color: var(--ma-muted);
        font-size: 14px;
        line-height: 1.6;
    }

    .ma-muted {
        color: var(--ma-muted);
        font-size: 12px;
    }

    .ma-placeholder {
        color: #94a29b;
        font-style: italic;
        font-size: 13px;
    }

    /* ---------- Nút ---------- */
    .ma-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 10px 18px;
        border: 1px solid #dce7e2;
        border-radius: 11px;
        background: #fff;
        color: #35564a;
        font: inherit;
        font-size: 13px;
        text-decoration: none;
        white-space: nowrap;
        cursor: pointer;
        transition: background .2s, transform .2s, box-shadow .2s;
    }

        .ma-button:hover {
            background: #f0f8f4;
            color: #35564a;
            text-decoration: none;
        }

    .ma-primary {
        border-color: var(--ma-green);
        background: var(--ma-green);
        color: #fff;
        font-weight: 600;
        box-shadow: 0 6px 16px rgba(0, 155, 114, .22);
    }

        .ma-primary:hover {
            background: var(--ma-green-dark);
            border-color: var(--ma-green-dark);
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 8px 20px rgba(0, 155, 114, .3);
        }

    .ma-header .ma-primary {
        min-height: 46px;
        padding: 12px 20px;
        border-radius: 12px;
        font-size: 14px;
    }

    .ma-plus {
        font-size: 18px;
        line-height: 1;
    }

    .ma-primary-sm {
        box-shadow: none;
    }

    /* ---------- Thẻ thống kê ---------- */
    .ma-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 22px;
    }

    .ma-stat {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 18px 20px;
        border: 1px solid var(--ma-border);
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 8px 28px rgba(26, 65, 49, .03);
    }

    .ma-stat-icon {
        display: inline-flex;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border-radius: 12px;
        font-size: 18px;
        font-weight: 700;
    }

    .ma-stat-green {
        background: #e9f8f1;
        color: var(--ma-green);
    }

    .ma-stat-gray {
        background: #f0f2f5;
        color: #75808d;
    }

    .ma-stat-blue {
        background: #edf3ff;
        color: #3669c9;
    }

    .ma-stat strong {
        display: block;
        font-size: 22px;
        line-height: 1.2;
        color: #203b32;
    }

    .ma-stat span {
        color: var(--ma-muted);
        font-size: 13px;
    }

    /* ---------- Panel & toolbar ---------- */
    .ma-panel {
        overflow: hidden;
        border: 1px solid var(--ma-border);
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 8px 28px rgba(26, 65, 49, .04);
    }

    .ma-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 18px;
        padding: 24px;
        border-bottom: 1px solid var(--ma-border);
    }

        .ma-toolbar h2 {
            margin: 0 0 7px;
            font-size: 18px;
            font-weight: 700;
        }

    .ma-count {
        margin: 0;
        color: var(--ma-muted);
        font-size: 13px;
    }

        .ma-count strong {
            color: var(--ma-green);
        }

    .ma-filters {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        flex-wrap: wrap;
        flex: 1;
        gap: 10px;
    }

    .ma-control {
        min-height: 44px;
        padding: 10px 13px;
        border: 1px solid #dce7e2;
        border-radius: 11px;
        background: #f8fbf9;
        color: #35564a;
        font: inherit;
        font-size: 13px;
        transition: border-color .2s, box-shadow .2s;
    }

        .ma-control:focus {
            outline: none;
            border-color: var(--ma-green);
            box-shadow: 0 0 0 3px rgba(0, 155, 114, .1);
        }

    .ma-search {
        width: 280px;
        max-width: 100%;
    }

    /* ---------- Bảng ---------- */
    .ma-scroll {
        overflow-x: auto;
    }

    .ma-table {
        width: 100%;
        min-width: 1040px;
        border-collapse: collapse;
    }

        .ma-table th {
            padding: 17px 20px;
            border-bottom: 1px solid var(--ma-border);
            background: #f6faf8;
            color: #61786d;
            font-size: 12px;
            font-weight: 600;
            text-align: left;
            white-space: nowrap;
        }

        .ma-table td {
            padding: 20px;
            border-bottom: 1px solid #edf2ef;
            font-size: 13px;
            vertical-align: middle;
        }

        .ma-table tbody tr:last-child td {
            border-bottom: 0;
        }

    .ma-row:hover {
        background: #fbfdfc;
    }

    .ma-menu-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .ma-icon {
        display: inline-flex;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: #e9f8f1;
        color: var(--ma-green);
    }

        .ma-icon svg {
            width: 21px;
            height: 21px;
        }

    .ma-name {
        display: block;
        margin-bottom: 5px;
        font-weight: 700;
        font-size: 14px;
        color: #203b32;
        overflow-wrap: anywhere;
    }

    .ma-code {
        display: inline-block;
        max-width: 250px;
        padding: 6px 9px;
        border-radius: 7px;
        background: #f3f6f5;
        color: #526d60;
        font-size: 12px;
        overflow-wrap: anywhere;
        white-space: normal;
    }

    .ma-order {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 32px;
        height: 32px;
        padding: 0 10px;
        border-radius: 9px;
        background: #f3f6f5;
        color: #35564a;
        font-weight: 600;
    }

    .ma-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 11px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

        .ma-badge::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }

    .ma-active {
        background: #e4f8ed;
        color: #00835f;
    }

    .ma-inactive {
        background: #f0f2f5;
        color: #75808d;
    }

    .ma-parent {
        border-radius: 8px;
        background: #edf3ff;
        color: #426bb6;
    }

        .ma-parent::before {
            display: none;
        }

    /* ---------- Thao tác ---------- */
    .ma-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 7px;
    }

    .ma-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 34px;
        padding: 7px 12px;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        transition: background .2s;
    }

        .ma-action:hover {
            text-decoration: none;
        }

    .ma-detail {
        background: #edf3ff;
        color: #3669c9;
    }

        .ma-detail:hover {
            background: #dfeaff;
            color: #2654ac;
        }

    .ma-edit {
        background: #e9f8f1;
        color: #00835f;
    }

        .ma-edit:hover {
            background: #d7f2e4;
            color: #006f50;
        }

    .ma-delete {
        background: #fff0f2;
        color: #d44760;
    }

        .ma-delete:hover {
            background: #ffe1e7;
            color: #b62c45;
        }

    /* ---------- Trạng thái trống ---------- */
    .ma-empty {
        padding: 55px 20px !important;
        text-align: center;
        color: var(--ma-muted);
        line-height: 1.8;
    }

        .ma-empty strong {
            display: block;
            margin-bottom: 5px;
            color: #35564a;
            font-size: 16px;
        }

    .ma-empty-add {
        margin-top: 18px;
    }

    /* ---------- Footer & thông báo ---------- */
    .ma-footer {
        padding: 15px 24px;
        border-top: 1px solid var(--ma-border);
        background: #fcfefd;
        color: var(--ma-muted);
        font-size: 12px;
    }

    .ma-alert {
        margin-bottom: 18px;
        padding: 14px 18px;
        border: 1px solid;
        border-radius: 12px;
        font-size: 14px;
        line-height: 1.6;
    }

    .ma-success {
        background: #edf9f2;
        border-color: #c9ead8;
        color: #17633c;
    }

    .ma-error {
        background: #fff1f3;
        border-color: #f4ccd2;
        color: #a93148;
    }

    /* ---------- Responsive ---------- */
    @@media (max-width: 768px) {
        .menu-admin {
            padding: 20px 12px;
        }

        .ma-header {
            align-items: flex-start;
            flex-direction: column;
        }

            .ma-header h1 {
                font-size: 24px;
            }

            .ma-header .ma-primary {
                width: 100%;
            }

        .ma-stats {
            grid-template-columns: 1fr;
        }

        .ma-toolbar {
            padding: 20px 16px;
        }

        .ma-filters {
            width: 100%;
            flex-direction: column;
            align-items: stretch;
        }

        .ma-search {
            width: 100%;
        }
    }
</style>

<div class="menu-admin">
    <div class="ma-header">
        <div>
            <div class="ma-eyebrow">Điều hướng website</div>
            <h1>Quản lý menu</h1>
            <p class="ma-subtitle">
                Quản lý tên menu, đường dẫn, thứ tự và trạng thái hiển thị.
            </p>
        </div>

        <a href="@createUrl" class="ma-button ma-primary">
            <span class="ma-plus" aria-hidden="true">＋</span>
            Thêm menu
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="ma-alert ma-success" role="status">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="ma-alert ma-error" role="alert">
            @TempData["Error"]
        </div>
    }

    <div class="ma-stats">
        <div class="ma-stat">
            <span class="ma-stat-icon ma-stat-blue" aria-hidden="true">≡</span>
            <div>
                <strong>@menus.Count</strong>
                <span>Tổng số menu</span>
            </div>
        </div>

        <div class="ma-stat">
            <span class="ma-stat-icon ma-stat-green" aria-hidden="true">✓</span>
            <div>
                <strong>@activeCount</strong>
                <span>Đang bật</span>
            </div>
        </div>

        <div class="ma-stat">
            <span class="ma-stat-icon ma-stat-gray" aria-hidden="true">✕</span>
            <div>
                <strong>@(menus.Count - activeCount)</strong>
                <span>Đang tắt</span>
            </div>
        </div>
    </div>

    <div class="ma-panel">
        <div class="ma-toolbar">
            <div>
                <h2>Danh sách menu</h2>
                <p class="ma-count">
                    Tổng cộng <strong>@menus.Count</strong> menu
                </p>
            </div>

            <div class="ma-filters">
                <input id="menuSearch"
                       type="search"
                       class="ma-control ma-search"
                       placeholder="Tìm tên menu, đường dẫn..."
                       aria-label="Tìm menu"
                       autocomplete="off" />

                <select id="menuStatus"
                        class="ma-control"
                        aria-label="Lọc trạng thái">
                    <option value="">Tất cả trạng thái</option>
                    <option value="active">Đang bật</option>
                    <option value="inactive">Đang tắt</option>
                </select>

                <button id="menuReset"
                        type="button"
                        class="ma-button">
                    Đặt lại
                </button>

                <a href="@createUrl" class="ma-button ma-primary ma-primary-sm">
                    <span class="ma-plus" aria-hidden="true">＋</span>
                    Thêm mới
                </a>
            </div>
        </div>

        <div class="ma-scroll">
            <table class="ma-table">
                <thead>
                    <tr>
                        <th scope="col">Tên menu</th>
                        <th scope="col">Đường dẫn</th>
                        <th scope="col">Mã biểu tượng</th>
                        <th scope="col">Thứ tự</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col">Menu cha</th>
                        <th scope="col" style="width: 230px;">Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in menus)
                    {
                        var active = item.IsActive == true;

                        <tr class="ma-row"
                            data-status="@(active ? "active" : "inactive")"
                            data-search="@($"{item.MenuName} {item.MenuUrl} {item.Parent?.MenuName}")">

                            <td>
                                <div class="ma-menu-cell">
                                    <span class="ma-icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.7"
                                             stroke-linecap="round"
                                             stroke-linejoin="round">
                                            <path d="M4 6h16"></path>
                                            <path d="M4 12h16"></path>
                                            <path d="M4 18h10"></path>
                                        </svg>
                                    </span>

                                    <div>
                                        <span class="ma-name">@item.MenuName</span>
                                        <span class="ma-muted">Mã: #@item.MenuId</span>
                                    </div>
                                </div>
                            </td>

                            <td>
                                @if (string.IsNullOrWhiteSpace(item.MenuUrl))
                                {
                                    <span class="ma-placeholder">Chưa có đường dẫn</span>
                                }
                                else
                                {
                                    <code class="ma-code">@item.MenuUrl</code>
                                }
                            </td>

                            <td>
                                @if (string.IsNullOrWhiteSpace(item.Icon))
                                {
                                    <span class="ma-placeholder">Chưa có</span>
                                }
                                else
                                {
                                    <code class="ma-code">@item.Icon</code>
                                }
                            </td>

                            <td>
                                <span class="ma-order">@item.SortOrder</span>
                            </td>

                            <td>
                                <span class="ma-badge @(active ? "ma-active" : "ma-inactive")">
                                    @(active ? "Đang bật" : "Đang tắt")
                                </span>
                            </td>

                            <td>
                                @if (item.Parent != null)
                                {
                                    <span class="ma-badge ma-parent">
                                        @item.Parent.MenuName
                                    </span>
                                }
                                else
                                {
                                    <span class="ma-placeholder">—</span>
                                }
                            </td>

                            <td>
                                <div class="ma-actions">
                                 
                                    <a href="@Url.Action("Edit", "Menus", new { area = "Admin", id = item.MenuId })"
                                       class="ma-action ma-edit"
                                       aria-label="@($"Sửa menu {item.MenuName}")">
                                        Sửa
                                    </a>

                                    <a href="@Url.Action("Delete", "Menus", new { area = "Admin", id = item.MenuId })"
                                       class="ma-action ma-delete"
                                       aria-label="@($"Xóa menu {item.MenuName}")">
                                        Xóa
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }

                    <tr id="menuEmpty" hidden="@(menus.Count > 0)">
                        <td colspan="7" class="ma-empty">
                            <strong id="menuEmptyTitle">Chưa có menu</strong>
                            <div id="menuEmptyText">
                                Bấm “Thêm menu” để tạo menu đầu tiên.
                            </div>
                            <a href="@createUrl" class="ma-button ma-primary ma-primary-sm ma-empty-add">
                                <span class="ma-plus" aria-hidden="true">＋</span>
                                Thêm menu
                            </a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="ma-footer" role="status" aria-live="polite">
            Đang hiển thị
            <strong id="menuVisibleCount">@menus.Count</strong>
            / @menus.Count menu
        </div>
    </div>
</div>

<script>
    (() => {
        const search = document.getElementById("menuSearch");
        const status = document.getElementById("menuStatus");
        const reset = document.getElementById("menuReset");
        const empty = document.getElementById("menuEmpty");
        const count = document.getElementById("menuVisibleCount");
        const emptyTitle = document.getElementById("menuEmptyTitle");
        const emptyText = document.getElementById("menuEmptyText");

        function normalize(value) {
            return (value || "")
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "")
                .replace(/[đĐ]/g, "d")
                .toLowerCase()
                .trim();
        }

        const rows = Array.from(
            document.querySelectorAll(".menu-admin .ma-row")
        ).map(row => ({
            element: row,
            text: normalize(row.dataset.search),
            status: row.dataset.status
        }));

        function filterMenus() {
            const keyword = normalize(search.value);
            let visible = 0;

            rows.forEach(row => {
                const matches =
                    row.text.includes(keyword) &&
                    (!status.value || row.status === status.value);

                row.element.hidden = !matches;

                if (matches) visible++;
            });

            count.textContent = visible;
            empty.hidden = visible > 0;

            emptyTitle.textContent = rows.length === 0
                ? "Chưa có menu"
                : "Không tìm thấy menu phù hợp";

            emptyText.textContent = rows.length === 0
                ? "Bấm “Thêm menu” để tạo menu đầu tiên."
                : "Thử từ khóa khác, bấm “Đặt lại” hoặc thêm menu mới.";
        }

        search.addEventListener("input", filterMenus);
        status.addEventListener("change", filterMenus);

        reset.addEventListener("click", () => {
            search.value = "";
            status.value = "";
            filterMenus();
            search.focus();
        });

        filterMenus();
    })();
</script>
