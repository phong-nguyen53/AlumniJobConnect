@model AlumniJobConnect.Models.Company

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Sửa doanh nghiệp";

    var submitUrl = Url.RouteUrl(
        "AdminEditCompanySubmit",
        new { id = Model.CompanyId });
}

<div class="container-fluid py-4">
    <a class="btn btn-outline-secondary btn-sm mb-3"
       href="@Url.RouteUrl("AdminCompanies")">
        ← Danh sách doanh nghiệp
    </a>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <h1 class="h4 fw-bold mb-2">Sửa doanh nghiệp</h1>
            <p class="text-muted mb-4">Mã doanh nghiệp #@Model.CompanyId</p>

            <form method="post" action="@submitUrl">
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(false, "", new { @class = "text-danger" })

                <div class="row g-3">
                    @await Html.PartialAsync("_CompanyFields", Model)
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        Lưu thay đổi
                    </button>
                    <a class="btn btn-light" href="@Url.RouteUrl("AdminCompanies")">
                        Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>