@using System.Linq
@model System.Collections.Generic.IReadOnlyList<AlumniJobConnect.Models.Company>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Quản lý doanh nghiệp";

    var industries = Model
        .Where(c => !string.IsNullOrWhiteSpace(c.Industry))
        .Select(c => c.Industry!.Trim())
        .Distinct()
        .OrderBy(name => name)
        .ToList();

    var verifiedCount = Model.Count(c =>
        c.VerificationStatus == "Verified");

    var rejectedCount = Model.Count(c =>
        c.VerificationStatus == "Rejected");

    var pendingCount = Model.Count - verifiedCount - rejectedCount;
}

<style>
    .cvs-page {
        color: #294637;
        font-family: "Segoe UI", Arial, sans-serif;
    }

        .cvs-page * {
            box-sizing: border-box;
        }

    .cvs-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 18px;
        margin-bottom: 25px;
    }

    .cvs-page h1 {
        margin: 0 0 9px;
        color: #244532;
        font: 700 29px/1.4 "Segoe UI", Arial, sans-serif;
    }

    .cvs-heading p {
        margin: 0;
        color: #7a8c80;
        font-size: 14px;
    }

    .cvs-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }

    .cvs-stat {
        padding: 21px;
        background: #fff;
        border: 1px solid #e0e9e3;
        border-radius: 15px;
    }

        .cvs-stat span {
            display: block;
            color: #7a8c80;
            font-size: 12px;
        }

        .cvs-stat strong {
            display: block;
            margin-top: 10px;
            color: #00996d;
            font-size: 29px;
        }

    .cvs-panel {
        background: #fff;
        border: 1px solid #e0e9e3;
        border-radius: 17px;
        overflow: hidden;
    }

    .cvs-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 11px;
        padding: 20px;
        border-bottom: 1px solid #e7eee8;
    }

        .cvs-toolbar input,
        .cvs-toolbar select {
            min-width: 140px;
            padding: 11px 12px;
            border: 1px solid #d6e3da;
            border-radius: 9px;
            background: #fbfdfb;
            color: #395b47;
            font: 13px "Segoe UI", Arial, sans-serif;
        }

        .cvs-toolbar input {
            flex: 1 1 240px;
        }

            .cvs-toolbar input:focus,
            .cvs-toolbar select:focus {
                outline: 2px solid #9ad8b9;
                outline-offset: 2px;
            }

    .cvs-table-wrap {
        overflow-x: auto;
    }

    .cvs-table {
        width: 100%;
        min-width: 1040px;
        border-collapse: collapse;
        font-size: 13px;
    }

        .cvs-table th {
            padding: 17px;
            background: #f5faf6;
            text-align: left;
            color: #7c8e81;
            font-weight: 600;
            white-space: nowrap;
        }

        .cvs-table td {
            padding: 19px 17px;
            border-top: 1px solid #edf2ee;
            vertical-align: middle;
        }

    .cvs-company {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 200px;
        max-width: 320px;
    }

    .cvs-avatar {
        display: grid;
        place-items: center;
        flex-shrink: 0;
        width: 43px;
        height: 43px;
        border-radius: 12px;
        background: #e4f5eb;
        color: #00966a;
        font-weight: 700;
        font-size: 18px;
    }

    .cvs-company strong {
        color: #2b4e39;
        overflow-wrap: anywhere;
    }

    .cvs-company small {
        display: block;
        margin-top: 5px;
        color: #8b998f;
        font-size: 11px;
    }

    .cvs-badge {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 25px;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
    }

    .cvs-verified {
        background: #e5f6eb;
        color: #16814d;
    }

    .cvs-pending {
        background: #fff5dd;
        color: #a47616;
    }

    .cvs-rejected {
        background: #fff0ed;
        color: #bd4a39;
    }

    .cvs-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 7px;
        min-width: 240px;
    }

        .cvs-actions form {
            display: inline-flex;
            flex-wrap: wrap;
            gap: 7px;
            margin: 0;
        }

    .cvs-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 12px;
        border: 1px solid #d5e4d9;
        border-radius: 8px;
        background: #fff;
        color: #486552;
        text-decoration: none !important;
        font: 600 12px/1.5 "Segoe UI", Arial, sans-serif;
        cursor: pointer;
        white-space: nowrap;
    }

        .cvs-button:hover {
            background: #f0f7f2;
            color: #264b34;
        }

    .cvs-primary {
        background: #009b72;
        border-color: #009b72;
        color: #fff !important;
    }

        .cvs-primary:hover {
            background: #007d5b;
        }

    .cvs-danger {
        color: #b64c3e;
        border-color: #efd5ce;
    }

    .cvs-disabled {
        color: #94a095;
        font-size: 11px;
    }

    .cvs-message,
    .cvs-error {
        padding: 15px 18px;
        border-radius: 11px;
        margin-bottom: 20px;
        font-size: 13px;
        line-height: 1.8;
    }

    .cvs-message {
        color: #226841;
        background: #eaf7ee;
        border: 1px solid #cfe8d7;
    }

    .cvs-error {
        color: #a54836;
        background: #fff2ee;
        border: 1px solid #efd1c7;
    }

    .cvs-footer {
        padding: 15px 20px;
        background: #fbfdfb;
        border-top: 1px solid #e8efe9;
        color: #859388;
        font-size: 12px;
    }

    .cvs-empty {
        text-align: center;
        padding: 45px !important;
        color: #8b988f;
    }

    .cvs-page [hidden] {
        display: none !important;
    }

    .cvs-page a:focus-visible,
    .cvs-page button:focus-visible {
        outline: 3px solid #8fd3ad;
        outline-offset: 3px;
    }

    @@media (max-width: 800px) {
        .cvs-stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .cvs-toolbar select {
            flex: 1 1 160px;
        }

        .cvs-page h1 {
            font-size: 25px;
        }
    }
</style>

<section class="cvs-page">
    <div class="cvs-heading">
        <div>
            <h1>Quản lý doanh nghiệp</h1>
            <p>Kiểm tra hồ sơ và cập nhật trạng thái xác minh.</p>
        </div>

        <a class="cvs-button cvs-primary"
           href="@Url.RouteUrl("AdminCreateCompany")">
            ＋ Thêm doanh nghiệp
        </a>
    </div>

    @if (TempData["CompanySuccess"] is string success)
    {
        <div class="cvs-message" role="status">@success</div>
    }

    @if (TempData["CompanyError"] is string error)
    {
        <div class="cvs-error" role="alert">@error</div>
    }

    <div class="cvs-stats">
        <div class="cvs-stat">
            <span>Tổng doanh nghiệp</span>
            <strong>@Model.Count</strong>
        </div>
        <div class="cvs-stat">
            <span>Đã xác minh</span>
            <strong>@verifiedCount</strong>
        </div>
        <div class="cvs-stat">
            <span>Chưa xác minh</span>
            <strong>@pendingCount</strong>
        </div>
        <div class="cvs-stat">
            <span>Đã từ chối</span>
            <strong>@rejectedCount</strong>
        </div>
    </div>

    <div class="cvs-panel">
        <div class="cvs-toolbar">
            <input id="cvsSearch"
                   type="search"
                   placeholder="Tìm tên doanh nghiệp hoặc ngành nghề..."
                   aria-label="Tìm doanh nghiệp" />

            <select id="cvsIndustry" aria-label="Lọc ngành nghề">
                <option value="">Mọi ngành nghề</option>
                @foreach (var industry in industries)
                {
                    <option value="@industry">@industry</option>
                }
            </select>

            <select id="cvsStatus" aria-label="Lọc xác minh">
                <option value="">Mọi trạng thái</option>
                <option value="Verified">Đã xác minh</option>
                <option value="Pending">Chưa xác minh</option>
                <option value="Rejected">Đã từ chối</option>
            </select>

            <select id="cvsPosts" aria-label="Lọc tin tuyển dụng">
                <option value="">Mọi doanh nghiệp</option>
                <option value="has">Đã có tin</option>
                <option value="none">Chưa có tin</option>
            </select>

            <select id="cvsSort" aria-label="Sắp xếp">
                <option value="default">Mặc định</option>
                <option value="name-asc">Tên A → Z</option>
                <option value="name-desc">Tên Z → A</option>
                <option value="posts-desc">Nhiều tin nhất</option>
                <option value="approved-desc">Nhiều tin đã duyệt nhất</option>
            </select>

            <button id="cvsReset" type="button" class="cvs-button">
                Đặt lại
            </button>
        </div>

        <div class="cvs-table-wrap">
            <table class="cvs-table">
                <thead>
                    <tr>
                        <th>Doanh nghiệp</th>
                        <th>Ngành nghề</th>
                        <th>Tổng tin</th>
                        <th>Tin đã duyệt</th>
                        <th>Xác minh</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody id="cvsBody">
                    @foreach (var company in Model)
                    {
                        var industry = company.Industry?.Trim() ?? "";
                        var totalPosts = company.JobPosts.Count;

                        var approvedPosts = company.JobPosts.Count(
                        job => job.ApprovalStatus == "Approved");

                        var state = company.VerificationStatus switch
                        {
                            "Verified" => "Verified",
                            "Rejected" => "Rejected",
                            _ => "Pending"
                        };

                        var initial = string.IsNullOrWhiteSpace(company.CompanyName)
                        ? "?"
                        : company.CompanyName.Trim()
                        .Substring(0, 1).ToUpperInvariant();

                        <tr data-company-row
                            data-name="@company.CompanyName"
                            data-search="@company.CompanyName @industry"
                            data-industry="@industry"
                            data-state="@state"
                            data-total="@totalPosts"
                            data-approved="@approvedPosts">

                            <td>
                                <div class="cvs-company">
                                    <span class="cvs-avatar">@initial</span>
                                    <div>
                                        <strong>@company.CompanyName</strong>
                                        <small>
                                            Mã số thuế:
                                            @(company.TaxCode ?? "Chưa cập nhật")
                                        </small>
                                    </div>
                                </div>
                            </td>

                            <td>
                                @(industry.Length > 0 ? industry : "Chưa cập nhật")
                            </td>

                            <td>@totalPosts</td>
                            <td>@approvedPosts</td>

                            <td>
                                @if (state == "Verified")
                                {
                                    <span class="cvs-badge cvs-verified">
                                        ✓ Đã xác minh
                                    </span>
                                }
                                else if (state == "Rejected")
                                {
                                    <span class="cvs-badge cvs-rejected">
                                        Đã từ chối
                                    </span>
                                }
                                else
                                {
                                    <span class="cvs-badge cvs-pending">
                                        Chưa xác minh
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="cvs-actions">
                                    <a class="cvs-button"
                                       href="@Url.Action("Details", "CompanyProfile",
                                                                                  new { area = "", id = company.CompanyId })">
                                    Xem hồ sơ
                                </a>

                                    <a class="cvs-button"
                                       href="@Url.RouteUrl("AdminEditCompany",
                                                                              new { id = company.CompanyId })">
                                    Sửa
                                </a>

                                    <form method="post"
                                          asp-antiforgery="false"
                                          action="@Url.RouteUrl("AdminCompanyVerification",
                                                                                    new { id = company.CompanyId })"
                                      onsubmit="return confirm('Bạn muốn cập nhật trạng thái xác minh doanh nghiệp này?');">

                                        @Html.AntiForgeryToken()

                                    @if (state != "Verified")
                                        {
                                            <button type="submit"
                                                    name="status"
                                                    value="Verified"
                                                    class="cvs-button cvs-primary">
                                                Xác minh
                                            </button>
                                        }

                                        @if (state != "Rejected")
                                        {
                                            <button type="submit"
                                                    name="status"
                                                    value="Rejected"
                                                    class="cvs-button cvs-danger">
                                                Từ chối
                                            </button>
                                        }

                                        @if (state != "Pending")
                                        {
                                            <button type="submit"
                                                    name="status"
                                                    value="Pending"
                                                    class="cvs-button">
                                                Chờ xác minh
                                            </button>
                                        }
                                    </form>

                                    @if (totalPosts == 0)
                                    {
                                        <form method="post"
                                              asp-antiforgery="false"
                                              action="@Url.RouteUrl("AdminDeleteCompany",
                                                                                                new { id = company.CompanyId })"
                                      onsubmit="return confirm('Bạn chắc chắn muốn xóa doanh nghiệp này?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="cvs-button cvs-danger">
                                                Xóa
                                            </button>
                                        </form>
                                                                }
                                    else
                                    {
                                        <span class="cvs-disabled">
                                            Đã có tin · Không thể xóa
                                        </span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }

                    <tr id="cvsEmpty" hidden="@(Model.Count > 0)">
                        <td colspan="6" class="cvs-empty">
                            Không có doanh nghiệp phù hợp.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="cvs-footer">
            Hiển thị <strong id="cvsCount">@Model.Count</strong>
            / @Model.Count doanh nghiệp
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const search = document.getElementById('cvsSearch');
            const industry = document.getElementById('cvsIndustry');
            const status = document.getElementById('cvsStatus');
            const posts = document.getElementById('cvsPosts');
            const sort = document.getElementById('cvsSort');
            const reset = document.getElementById('cvsReset');
            const body = document.getElementById('cvsBody');
            const empty = document.getElementById('cvsEmpty');
            const count = document.getElementById('cvsCount');

            const rows = Array.from(
                body.querySelectorAll('[data-company-row]')
            );

            const normalize = text => (text || '')
                .toLowerCase()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .replace(/đ/g, 'd')
                .trim();

            rows.forEach((row, index) => {
                row.dataset.order = index;
                row.dataset.normalized = normalize(row.dataset.search);
            });

            function update() {
                const keyword = normalize(search.value);
                let visible = 0;

                rows.forEach(row => {
                    const total = Number(row.dataset.total);

                    const matches =
                        (!keyword ||
                            row.dataset.normalized.includes(keyword)) &&
                        (!industry.value ||
                            row.dataset.industry === industry.value) &&
                        (!status.value ||
                            row.dataset.state === status.value) &&
                        (!posts.value ||
                            (posts.value === 'has' ? total > 0 : total === 0));

                    row.hidden = !matches;

                    if (matches) visible++;
                });

                const sorted = rows.slice().sort((a, b) => {
                    switch (sort.value) {
                        case 'name-asc':
                            return a.dataset.name.localeCompare(
                                b.dataset.name, 'vi');

                        case 'name-desc':
                            return b.dataset.name.localeCompare(
                                a.dataset.name, 'vi');

                        case 'posts-desc':
                            return Number(b.dataset.total) -
                                Number(a.dataset.total);

                        case 'approved-desc':
                            return Number(b.dataset.approved) -
                                Number(a.dataset.approved);

                        default:
                            return Number(a.dataset.order) -
                                Number(b.dataset.order);
                    }
                });

                sorted.forEach(row => body.insertBefore(row, empty));

                empty.hidden = visible > 0;
                count.textContent = visible;
            }

            search.addEventListener('input', update);

            [industry, status, posts, sort].forEach(element => {
                element.addEventListener('change', update);
            });

            reset.addEventListener('click', () => {
                search.value = '';
                industry.value = '';
                status.value = '';
                posts.value = '';
                sort.value = 'default';

                update();
                search.focus();
            });

            update();
        })();
    </script>
}