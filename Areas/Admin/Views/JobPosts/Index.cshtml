@model System.Collections.Generic.IReadOnlyList<AlumniJobConnect.Models.JobPost>

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Quản lý tin tuyển dụng";

    var totalCount = Model.Count;
    var pendingCount = Model.Count(j => j.ApprovalStatus == "Pending");
    var approvedCount = Model.Count(j => j.ApprovalStatus == "Approved");
    var rejectedCount = Model.Count(j => j.ApprovalStatus == "Rejected");
}

<style>
    .jp-stat {
        border: 0;
        border-radius: 1rem;
        transition: transform .15s ease, box-shadow .15s ease;
    }

        .jp-stat:hover {
            transform: translateY(-2px);
            box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .08) !important;
        }

        .jp-stat .jp-icon {
            width: 46px;
            height: 46px;
            border-radius: .85rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }

    .jp-toolbar .input-group-text,
    .jp-toolbar .form-control,
    .jp-toolbar .form-select {
        border-color: #e3e6ec;
    }

        .jp-toolbar .form-control:focus,
        .jp-toolbar .form-select:focus {
            box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .12);
        }

    .jp-table thead th {
        font-size: .75rem;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: #6c757d;
        font-weight: 600;
        border-bottom: 1px solid #e9ecef;
        white-space: nowrap;
    }

    .jp-table tbody tr {
        transition: background-color .12s ease;
    }

    .jp-table td {
        padding-top: .9rem;
        padding-bottom: .9rem;
    }

    .jp-avatar {
        width: 38px;
        height: 38px;
        border-radius: .7rem;
        background: #eef3ff;
        color: #0d6efd;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .jp-title {
        max-width: 320px;
    }

    .jp-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
        margin-right: .4rem;
    }
</style>

<div class="container-fluid py-4">

    @* ===== Tiêu đề ===== *@
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Quản lý tin tuyển dụng</h1>
            <p class="text-muted mb-0">Xem các tin do doanh nghiệp đăng và duyệt những tin đang chờ.</p>
        </div>
    </div>

    @* ===== Thông báo ===== *@
    @if (TempData["JobPostSuccess"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="status">
            <i class="bi bi-check-circle-fill me-2"></i>@successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @if (TempData["JobPostError"] is string errorMessage)
    {
        <div class="alert alert-warning alert-dismissible fade show border-0 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @* ===== Thống kê nhanh (bấm để lọc) ===== *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card jp-stat shadow-sm h-100" role="button" data-filter="">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="jp-icon bg-primary-subtle text-primary"><i class="bi bi-briefcase"></i></span>
                    <div>
                        <div class="text-muted small">Tổng số tin</div>
                        <div class="h4 fw-bold mb-0">@totalCount</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card jp-stat shadow-sm h-100" role="button" data-filter="Pending">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="jp-icon bg-warning-subtle text-warning-emphasis"><i class="bi bi-hourglass-split"></i></span>
                    <div>
                        <div class="text-muted small">Chờ duyệt</div>
                        <div class="h4 fw-bold mb-0">@pendingCount</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card jp-stat shadow-sm h-100" role="button" data-filter="Approved">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="jp-icon bg-success-subtle text-success"><i class="bi bi-check2-circle"></i></span>
                    <div>
                        <div class="text-muted small">Đã duyệt</div>
                        <div class="h4 fw-bold mb-0">@approvedCount</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card jp-stat shadow-sm h-100" role="button" data-filter="Rejected">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="jp-icon bg-danger-subtle text-danger"><i class="bi bi-x-circle"></i></span>
                    <div>
                        <div class="text-muted small">Đã từ chối</div>
                        <div class="h4 fw-bold mb-0">@rejectedCount</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius: 1rem;">
        <div class="card-body p-4">

            @* ===== Thanh tìm kiếm + bộ lọc ===== *@
            <div class="row g-2 jp-toolbar mb-4">
                <div class="col-12 col-lg">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                        <input type="search"
                               id="jobSearch"
                               class="form-control border-start-0"
                               placeholder="Tìm theo mã tin, vị trí tuyển dụng, doanh nghiệp..."
                               autocomplete="off" />
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <select id="statusFilter" class="form-select" aria-label="Lọc theo trạng thái duyệt">
                        <option value="">Tất cả trạng thái duyệt</option>
                        <option value="Pending">Chờ duyệt</option>
                        <option value="Approved">Đã duyệt</option>
                        <option value="Rejected">Đã từ chối</option>
                    </select>
                </div>
                <div class="col-6 col-lg-3">
                    <select id="publishFilter" class="form-select" aria-label="Lọc theo hiển thị">
                        <option value="">Tất cả hiển thị</option>
                        <option value="1">Đang bật hiển thị</option>
                        <option value="0">Đang tắt hiển thị</option>
                    </select>
                </div>
                <div class="col-12 col-lg-auto">
                    <button type="button" id="resetFilters" class="btn btn-outline-secondary w-100">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Đặt lại
                    </button>
                </div>
            </div>

            @if (Model.Count == 0)
            {
                <div class="text-center py-5">
                    <div class="display-6 text-muted mb-2"><i class="bi bi-inbox"></i></div>
                    <p class="text-muted mb-0">Chưa có tin tuyển dụng nào.</p>
                </div>
            }
            else
            {
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small">
                        Hiển thị <strong id="visibleCount">@Model.Count</strong> / @Model.Count tin
                    </span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 jp-table">
                        <thead>
                            <tr>
                                <th scope="col">Mã tin</th>
                                <th scope="col">Vị trí tuyển dụng</th>
                                <th scope="col">Doanh nghiệp</th>
                                <th scope="col">Ngày đăng</th>
                                <th scope="col">Trạng thái duyệt</th>
                                <th scope="col">Hiển thị</th>
                                <th scope="col" class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="jobTableBody">
                            @foreach (var job in Model)
                            {
                                var (statusText, badgeClass) = job.ApprovalStatus switch
                                {
                                    "Pending" => ("Chờ duyệt", "bg-warning-subtle text-warning-emphasis"),
                                    "Approved" => ("Đã duyệt", "bg-success-subtle text-success"),
                                    "Rejected" => ("Đã từ chối", "bg-danger-subtle text-danger"),
                                    _ => (job.ApprovalStatus ?? "Chưa xác định", "bg-secondary-subtle text-secondary")
                                };

                                var companyName = job.Company?.CompanyName ?? "Chưa có thông tin";
                                var initial = string.IsNullOrWhiteSpace(job.Company?.CompanyName)
                                ? "?"
                                : job.Company!.CompanyName.Trim().Substring(0, 1).ToUpperInvariant();

                                <tr data-status="@job.ApprovalStatus"
                                    data-published="@(job.IsPublished ? "1" : "0")"
                                    data-search="@job.JobPostId @job.Title @companyName">
                                    <td class="text-muted fw-semibold">#@job.JobPostId</td>
                                    <td class="jp-title">
                                        <div class="fw-semibold text-truncate" title="@job.Title">@job.Title</div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="jp-avatar">@initial</span>
                                            <span>@companyName</span>
                                        </div>
                                    </td>
                                    <td class="text-nowrap">
                                        <div>@job.CreatedAt.ToString("dd/MM/yyyy")</div>
                                        <div class="text-muted small">@job.CreatedAt.ToString("HH:mm")</div>
                                    </td>
                                    <td>
                                        <span class="badge rounded-pill px-3 py-2 @badgeClass">@statusText</span>
                                    </td>
                                    <td class="text-nowrap">
                                        @if (job.IsPublished)
                                        {
                                            <span class="text-success"><span class="jp-dot bg-success"></span>Đã bật</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted"><span class="jp-dot bg-secondary"></span>Đã tắt</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap justify-content-end align-items-center gap-2">
                                            <a class="btn btn-outline-primary btn-sm text-nowrap"
                                               href="@Url.RouteUrl("AdminJobPostDetails", new { id = job.JobPostId })">
                                                <i class="bi bi-eye me-1"></i>Chi tiết
                                            </a>

                                            @if (job.ApprovalStatus == "Pending")
                                            {
                                                <form method="post"
                                                      action="@Url.RouteUrl("AdminApproveJobPost", new { id = job.JobPostId })"
                                                      class="m-0"
                                                      onsubmit="return confirm('Bạn muốn duyệt tin tuyển dụng này?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-success btn-sm text-nowrap">
                                                        <i class="bi bi-check-lg me-1"></i>Duyệt tin
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }

                            <tr id="noResultRow" class="d-none">
                                <td colspan="7" class="text-center text-muted py-5">
                                    <div class="fs-2 mb-2"><i class="bi bi-search"></i></div>
                                    Không tìm thấy tin tuyển dụng phù hợp.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const searchInput   = document.getElementById('jobSearch');
            const statusFilter  = document.getElementById('statusFilter');
            const publishFilter = document.getElementById('publishFilter');
            const resetBtn      = document.getElementById('resetFilters');
            const tbody         = document.getElementById('jobTableBody');
            const visibleCount  = document.getElementById('visibleCount');
            const noResultRow   = document.getElementById('noResultRow');

            if (!tbody) return;

            // Bỏ dấu tiếng Việt để tìm kiếm không phân biệt dấu
            const normalize = (text) => (text || '')
                .toString()
                .toLowerCase()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .replace(/đ/g, 'd')
                .trim();

            const rows = Array.from(tbody.querySelectorAll('tr[data-search]'));
            rows.forEach(r => r.dataset.searchNorm = normalize(r.dataset.search));

            function applyFilters() {
                const keyword = normalize(searchInput.value);
                const status  = statusFilter.value;
                const publish = publishFilter.value;
                let shown = 0;

                rows.forEach(row => {
                    const match =
                        (!keyword || row.dataset.searchNorm.includes(keyword)) &&
                        (!status  || row.dataset.status === status) &&
                        (!publish || row.dataset.published === publish);

                    row.classList.toggle('d-none', !match);
                    if (match) shown++;
                });

                if (visibleCount) visibleCount.textContent = shown;
                if (noResultRow)  noResultRow.classList.toggle('d-none', shown !== 0);
            }

            searchInput.addEventListener('input', applyFilters);
            statusFilter.addEventListener('change', applyFilters);
            publishFilter.addEventListener('change', applyFilters);

            resetBtn.addEventListener('click', function () {
                searchInput.value = '';
                statusFilter.value = '';
                publishFilter.value = '';
                applyFilters();
                searchInput.focus();
            });

            // Bấm vào thẻ thống kê để lọc nhanh theo trạng thái
            document.querySelectorAll('.jp-stat[data-filter]').forEach(card => {
                card.addEventListener('click', function () {
                    statusFilter.value = card.dataset.filter;
                    applyFilters();
                });
            });
        })();
    </script>
}
